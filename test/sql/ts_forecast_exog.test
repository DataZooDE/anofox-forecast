# name: test/sql/ts_forecast_exog.test
# description: Tests for ts_forecast with exogenous variables
# group: [sql]

require anofox_forecast

#######################################
# _ts_forecast_exog Scalar Function Tests
#######################################

# Test basic exog forecast with single regressor
query I
SELECT length((_ts_forecast_exog(
    [10.0, 20.0, 15.0, 25.0, 20.0, 30.0, 25.0, 35.0],  -- y values
    [[1.0, 2.0, 1.0, 2.0, 1.0, 2.0, 1.0, 2.0]],        -- historical X (1 regressor)
    [[1.0, 2.0, 1.0]],                                   -- future X (horizon=3)
    3,                                                    -- horizon
    'AutoARIMA'                                           -- model
)).point);
----
3

# Test exog forecast returns model name (plan 10-04, D-10: the crate's own
# exog-aware AutoARIMA order search needs more than 6 points to fit with a
# regressor attached — use the same 8-point series as the first test above).
query I
SELECT (_ts_forecast_exog(
    [10.0, 20.0, 15.0, 25.0, 20.0, 30.0, 25.0, 35.0],
    [[1.0, 2.0, 1.0, 2.0, 1.0, 2.0, 1.0, 2.0]],
    [[1.0, 2.0, 1.0]],
    3,
    'AutoARIMA'
)).model IS NOT NULL;
----
true

# Test exog forecast with two regressors (8 points — the crate's own
# exog-aware AutoARIMA order search, D-10, needs more data than 6 points to
# fit with two regressors attached).
query I
SELECT length((_ts_forecast_exog(
    [100.0, 120.0, 110.0, 130.0, 125.0, 140.0, 135.0, 150.0],  -- y (sales)
    [[20.0, 22.0, 19.0, 23.0, 21.0, 24.0, 20.0, 23.0],         -- X1 (temperature)
     [0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0]],                -- X2 (promotion)
    [[22.0, 20.0, 21.0],                                        -- future temp
     [1.0, 0.0, 1.0]],                                          -- future promo
    3,
    'AutoARIMA'
)).point);
----
3

# Test that model name identifies the real model + the " with regressors"
# suffix (D-10 — the old "%X" stand-in suffix, e.g. "ARIMAX"/"ThetaX", is
# gone entirely; model_name now reports what the crate actually fit).
query I
SELECT (_ts_forecast_exog(
    [10.0, 20.0, 15.0, 25.0, 20.0, 30.0, 25.0, 35.0],
    [[1.0, 2.0, 1.0, 2.0, 1.0, 2.0, 1.0, 2.0]],
    [[1.0, 2.0, 1.0]],
    3,
    'AutoARIMA'
)).model LIKE '%with regressors' AND (_ts_forecast_exog(
    [10.0, 20.0, 15.0, 25.0, 20.0, 30.0, 25.0, 35.0],
    [[1.0, 2.0, 1.0, 2.0, 1.0, 2.0, 1.0, 2.0]],
    [[1.0, 2.0, 1.0]],
    3,
    'AutoARIMA'
)).model LIKE 'AutoARIMA%';
----
true

# Test confidence bounds have correct length
query I
SELECT length((_ts_forecast_exog(
    [10.0, 20.0, 15.0, 25.0, 20.0, 30.0, 25.0, 35.0],
    [[1.0, 2.0, 1.0, 2.0, 1.0, 2.0, 1.0, 2.0]],
    [[1.0, 2.0, 1.0, 2.0]],
    4,
    'AutoARIMA'
)).lower);
----
4

query I
SELECT length((_ts_forecast_exog(
    [10.0, 20.0, 15.0, 25.0, 20.0, 30.0, 25.0, 35.0],
    [[1.0, 2.0, 1.0, 2.0, 1.0, 2.0, 1.0, 2.0]],
    [[1.0, 2.0, 1.0, 2.0]],
    4,
    'AutoARIMA'
)).upper);
----
4

#######################################
# Exog Effect Validation Tests (D-10, plan 10-04): every exog-capable model
# is the crate's OWN exog-aware fit — model_name is the real model identity
# plus " with regressors", never the old "%X" stand-in suffix.
#######################################

# 'ARIMA' with regressors now requires an explicit arima_order, same as the
# non-exog surface (D-08/D-09) — without one it's a hard error naming
# arima_order, never the old fixed-AR(1) "ARIMAX" stand-in.
statement error
SELECT (_ts_forecast_exog(
    [10.0, 20.0, 15.0, 25.0, 20.0, 30.0],
    [[1.0, 2.0, 1.0, 2.0, 1.0, 2.0]],
    [[1.0, 2.0]],
    2,
    'ARIMA'
)).model;
----
arima_order

query I
SELECT (_ts_forecast_exog(
    [10.0, 20.0, 15.0, 25.0, 20.0, 30.0],
    [[1.0, 2.0, 1.0, 2.0, 1.0, 2.0]],
    [[1.0, 2.0]],
    2,
    'OptimizedTheta'
)).model;
----
OptimizedTheta with regressors

query I
SELECT (_ts_forecast_exog(
    [10.0, 20.0, 15.0, 25.0, 20.0, 30.0],
    [[1.0, 2.0, 1.0, 2.0, 1.0, 2.0]],
    [[1.0, 2.0]],
    2,
    'MFLES'
)).model;
----
MFLES with regressors

#######################################
# Error Handling Tests
#######################################

# Test with empty exogenous arrays (should still work, falls back to
# forecast() itself — FCST-05/D-10 — with no " with regressors" suffix).
# Note: with no regressors AND no params, auto_detect_seasonality now
# defaults to true (matches ts_forecast_by's own default, plan 10-04); a
# 30-point near-linear series keeps the detected period at 1 (non-seasonal)
# so AutoARIMA's order search has enough data either way.
query I
WITH gen AS (SELECT i, 10.0 + i::DOUBLE + (i % 3)::DOUBLE AS y FROM range(30) AS t(i))
SELECT length((_ts_forecast_exog(
    (SELECT list(y ORDER BY i) FROM gen),
    [],
    [],
    3,
    'AutoARIMA'
)).point);
----
3


#######################################
# ts_forecast_exog_by - Grouped Exogenous Forecasting
#######################################

# The ts_forecast_exog_by macro uses json_extract for dynamic column access
require json

# Create grouped historical data with exogenous variable
statement ok
CREATE TABLE exog_by_history AS
SELECT
    CASE WHEN i <= 20 THEN 'A' ELSE 'B' END AS group_id,
    '2023-01-01'::TIMESTAMP + INTERVAL ((i - 1) % 20) DAY AS date,
    (10.0 + (i % 20) * 2.0 + ((i % 20) % 7))::DOUBLE AS target,
    ((i % 20) + 5.0)::DOUBLE AS xreg1
FROM range(1, 41) t(i);

# Create future exogenous data
statement ok
CREATE TABLE exog_by_future AS
SELECT
    group_id,
    '2023-01-21'::TIMESTAMP + INTERVAL (i - 1) DAY AS date,
    (25.0 + i)::DOUBLE AS xreg1
FROM (VALUES ('A'), ('B')) AS groups(group_id),
     range(1, 8) t(i);

# Test ts_forecast_exog_by returns forecasts for both groups
# Note: output column is 'id' (not the original column name) to match ts_forecast_by convention
query I
SELECT COUNT(DISTINCT id) FROM ts_forecast_exog_by(
    'exog_by_history',
    group_id,
    date,
    target,
    ['xreg1'],
    'exog_by_future',
    date,
    ['xreg1'],
    '1d',
    'AutoARIMA',
    7,
    MAP{}
);
----
2

# Test ts_forecast_exog_by returns correct number of forecast rows
query I
SELECT COUNT(*) FROM ts_forecast_exog_by(
    'exog_by_history',
    group_id,
    date,
    target,
    ['xreg1'],
    'exog_by_future',
    date,
    ['xreg1'],
    '1d',
    'AutoARIMA',
    7,
    MAP{}
);
----
14

statement ok
DROP TABLE exog_by_future;

statement ok
DROP TABLE exog_by_history;
