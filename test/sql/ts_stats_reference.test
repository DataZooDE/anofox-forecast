) t(ds, v);

statement ok
CREATE TABLE neg30_grp AS SELECT 'neg30' AS id, ds, v FROM neg30_tbl;

# === ts_stats_by: x20 moments (scipy skew=0.30292879825084273, kurt=0.2765286546322532, bc=0.2861213328957609) ===
query I
SELECT abs(skewness - 0.30292879825084273) < 1e-10 AND abs(kurtosis - 0.2765286546322532) < 1e-10 AND abs(bimodality_coef - 0.2861213328957609) < 1e-10
FROM ts_stats_by('x20_grp', id, ds, v, '1d');
----
true

# === ts_stats macro: x20 moments ===
query I
SELECT abs(skewness - 0.30292879825084273) < 1e-10 AND abs(kurtosis - 0.2765286546322532) < 1e-10 AND abs(bimodality_coef - 0.2861213328957609) < 1e-10
FROM ts_stats('x20_grp', id, ds, v, '1d');
----
true

# === ts_stats_agg: x20 moments ===
query I
SELECT abs((s).skewness - 0.30292879825084273) < 1e-10 AND abs((s).kurtosis - 0.2765286546322532) < 1e-10 AND abs((s).bimodality_coef - 0.2861213328957609) < 1e-10
FROM (SELECT ts_stats_agg(ds, v) AS s FROM x20_tbl);
----
true

# === ts_stats_by: neg30 moments (scipy skew=0.009664978939615671, kurt=-1.1917581430411304, bc=0.4661259199823024 — ROADMAP SC1 "0.466, previously 0.600") ===
query I
SELECT abs(skewness - 0.009664978939615671) < 1e-10 AND abs(kurtosis - (-1.1917581430411304)) < 1e-10 AND abs(bimodality_coef - 0.4661259199823024) < 1e-10
FROM ts_stats_by('neg30_grp', id, ds, v, '1d');
----
true

# === ts_stats macro: neg30 moments ===
query I
SELECT abs(skewness - 0.009664978939615671) < 1e-10 AND abs(kurtosis - (-1.1917581430411304)) < 1e-10 AND abs(bimodality_coef - 0.4661259199823024) < 1e-10
FROM ts_stats('neg30_grp', id, ds, v, '1d');
----
true

# === ts_stats_agg: neg30 moments ===
query I
SELECT abs((s).skewness - 0.009664978939615671) < 1e-10 AND abs((s).kurtosis - (-1.1917581430411304)) < 1e-10 AND abs((s).bimodality_coef - 0.4661259199823024) < 1e-10
FROM (SELECT ts_stats_agg(ds, v) AS s FROM neg30_tbl);
----
true

# === Gap counting (D-04, STAT-03): n_gaps = missing periods, n_gap_runs = gap intervals ===
# gap_daily: 60 days from 2024-01-01, days 20..39 missing (one 20-day run).
statement ok
CREATE TABLE gap_daily AS
SELECT (DATE '2024-01-01' + CAST(i AS INTEGER))::TIMESTAMP AS ds, i::DOUBLE AS v
FROM range(0, 60) t(i)
WHERE i < 20 OR i >= 40;

statement ok
CREATE TABLE gap_daily_grp AS SELECT 'g' AS id, ds, v FROM gap_daily;

query I
SELECT n_gaps = 20 AND n_gap_runs = 1 AND expected_length = 60
FROM ts_stats_by('gap_daily_grp', id, ds, v, '1d');
----
true

query I
SELECT n_gaps = 20 AND n_gap_runs = 1 AND expected_length = 60
FROM ts_stats('gap_daily_grp', id, ds, v, '1d');
----
true

# ts_stats_agg auto-detects the frequency (frequency_micros=0, FIXED) from the data itself.
query I
SELECT (s).n_gaps = 20 AND (s).n_gap_runs = 1 AND (s).expected_length = 60
FROM (SELECT ts_stats_agg(ds, v) AS s FROM gap_daily);
----
true

# gap_me: explicit month-end dates 2024-01-31, 2024-04-30, 2024-05-31 (Feb/Mar missing,
# one run of 2 missing periods) under '1mo'.
statement ok
CREATE TABLE gap_me AS SELECT * FROM (VALUES
    (DATE '2024-01-31', 1.0),
    (DATE '2024-04-30', 2.0),
    (DATE '2024-05-31', 3.0)
) t(ds, v);

statement ok
CREATE TABLE gap_me_grp AS SELECT 'g' AS id, ds, v FROM gap_me;

query I
SELECT n_gaps = 2 AND n_gap_runs = 1 AND expected_length = 5
FROM ts_stats_by('gap_me_grp', id, ds, v, '1mo');
----
true

query I
SELECT n_gaps = 2 AND n_gap_runs = 1 AND expected_length = 5
FROM ts_stats('gap_me_grp', id, ds, v, '1mo');
----
true

# === ts_stats_agg keeps NULL-valued rows (Phase 12 deferred item (a), fixed here) ===
statement ok
CREATE TABLE null_row AS SELECT * FROM (VALUES
    (DATE '2024-01-01', 1.0),
    (DATE '2024-01-02', NULL),
    (DATE '2024-01-03', 3.0),
    (DATE '2024-01-04', 4.0),
    (DATE '2024-01-05', 5.0)
) t(ds, v);

statement ok
CREATE TABLE null_row_grp AS SELECT 'g' AS id, ds, v FROM null_row;

query I
SELECT (SELECT (s).n_nulls FROM (SELECT ts_stats_agg(ds, v) AS s FROM null_row)) = (SELECT n_nulls FROM ts_stats_by('null_row_grp', id, ds, v, '1d'))
   AND (SELECT (s).length FROM (SELECT ts_stats_agg(ds, v) AS s FROM null_row)) = (SELECT length FROM ts_stats_by('null_row_grp', id, ds, v, '1d'));
----
true

