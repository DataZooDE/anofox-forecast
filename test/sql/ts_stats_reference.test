# Entropy is NULL for a series with an interior NULL ...
statement ok
CREATE TABLE entropy_interior_null AS SELECT * FROM (VALUES
    (DATE '2024-01-01', 1.0),
    (DATE '2024-01-02', 2.0),
    (DATE '2024-01-03', NULL),
    (DATE '2024-01-04', 4.0),
    (DATE '2024-01-05', 5.0)
) t(ds, v);

statement ok
CREATE TABLE entropy_interior_null_grp AS SELECT 'g' AS id, ds, v FROM entropy_interior_null;

query I
SELECT entropy IS NULL FROM ts_stats_by('entropy_interior_null_grp', id, ds, v, '1d');
----
true

# ... and for a 2-value series.
statement ok
CREATE TABLE entropy_two_values AS SELECT * FROM (VALUES
    (DATE '2024-01-01', 1.0),
    (DATE '2024-01-02', 2.0)
) t(ds, v);

statement ok
CREATE TABLE entropy_two_values_grp AS SELECT 'g' AS id, ds, v FROM entropy_two_values;

query I
SELECT entropy IS NULL FROM ts_stats_by('entropy_two_values_grp', id, ds, v, '1d');
----
true

# === STL-based trend_strength / seasonality_strength (D-02, STAT-02, Phase 13 plan 13-02) ===
# rw150: 150 monthly rows from 2010-01-31 month-ends, values = r_stl_strength/cases.json
# case audit_rw150. tsfeatures::stl_features (ts(v, frequency=12)): trend 0.976625431133628,
# seasonal_strength 0.0865166431060249 (provenance: validation/reference/r/gen_stl_strength_reference.R).
statement ok
CREATE TABLE rw150 AS
SELECT (DATE '2010-01-01' + INTERVAL (i) MONTH + INTERVAL '1 month' - INTERVAL '1 day') AS ds, v
FROM (SELECT UNNEST(generate_series(0,149)) AS i, UNNEST([-1.454, -1.6625, -2.2946, -4.0556, -3.3207, -3.3441, -3.2727, -4.025, -3.5702, -4.1095, -4.2524, -5.3607, -6.5768, -5.2413, -5.7484, -5.4567, -5.4905, -5.9316, -6.4396, -5.8095, -6.1114, -6.2628, -6.2406, -5.0641, -4.3836, -4.001, -4.5645, -5.9465, -4.997, -4.0305, -4.1712, -3.6293, -2.8479, -2.0167, -1.0953, -1.551, -0.036, -1.2826, -0.4209, 0.0731, 0.9467, 2.8257, 4.3102, 3.165, 1.4763, 2.2932, 1.2782, 1.2658, 2.1055, 0.4617, -1.6483, -1.389, -1.3446, -1.5904, -1.5519, -2.4124, -3.9259, -4.0925, -5.0642, -6.7077, -6.202, -6.2634, -5.8569, -6.8462, -7.5043, -8.5033, -9.3899, -9.1945, -9.9775, -9.6214, -9.2817, -7.2565, -8.6493, -7.7614, -7.8509, -7.8649, -9.3148, -9.775, -9.0318, -9.1143, -9.0332, -9.3239, -8.1694, -8.1908, -10.3912, -11.0833, -13.0521, -16.3036, -16.8337, -15.5001, -15.453, -16.6255, -17.5662, -16.4356, -16.278, -16.23, -16.2835, -16.2451, -15.4397, -14.8871, -14.6714, -15.7143, -15.2031, -15.8874, -14.7935, -16.0646, -16.2022, -16.2096, -17.5342, -15.8122, -14.3518, -14.8154, -14.0437, -13.665, -16.2786, -16.0282, -16.0895, -16.0063, -17.0832, -17.3525, -17.5308, -16.3427, -16.0083, -16.0138, -14.4849, -15.0401, -15.4295, -17.2463, -15.6772, -14.7129, -13.796, -13.1271, -13.017, -12.8015, -13.0535, -13.2571, -13.2028, -11.6909, -11.1353, -11.1937, -11.7731, -12.4081, -10.8054, -10.2987, -10.2312, -10.5773, -11.6864, -11.7533, -10.8796, -11.2721]) AS v);

statement ok
CREATE TABLE rw150_grp AS SELECT 'g' AS id, ds, v FROM rw150;

query I
SELECT abs(trend_strength - 0.976625431133628) < 1e-8
FROM ts_stats_by('rw150_grp', id, ds, v, '1mo', seasonal_period := 12);
----
true

query I
SELECT abs(seasonality_strength - 0.0865166431060249) < 1e-8
FROM ts_stats_by('rw150_grp', id, ds, v, '1mo', seasonal_period := 12);
----
true

# ts_stats macro agrees with ts_stats_by on the same explicit period.
query I
SELECT
  (SELECT trend_strength FROM ts_stats('rw150_grp', id, ds, v, '1mo', seasonal_period := 12))
    IS NOT DISTINCT FROM
  (SELECT trend_strength FROM ts_stats_by('rw150_grp', id, ds, v, '1mo', seasonal_period := 12))
  AND
  (SELECT seasonality_strength FROM ts_stats('rw150_grp', id, ds, v, '1mo', seasonal_period := 12))
    IS NOT DISTINCT FROM
  (SELECT seasonality_strength FROM ts_stats_by('rw150_grp', id, ds, v, '1mo', seasonal_period := 12));
----
true

# det_seasonal84: t=1..84, v = 10 + 3*sin(2*pi*t/7) + 0.1*t + 0.5*cos(2.1*t), period 7
# (fixture case det_seasonal84: trend 0.97998340937427, seasonal_strength 0.973887333793987).
statement ok
CREATE TABLE det84 AS
SELECT DATE '2024-01-01' + INTERVAL (t - 1) DAY AS ds,
       10 + 3 * sin(2 * pi() * t / 7) + 0.1 * t + 0.5 * cos(2.1 * t) AS v
FROM (SELECT UNNEST(generate_series(1, 84)) AS t);

statement ok
CREATE TABLE det84_grp AS SELECT 'g' AS id, ds, v FROM det84;

query I
SELECT abs(trend_strength - 0.97998340937427) < 1e-8
  AND abs(seasonality_strength - 0.973887333793987) < 1e-8
FROM ts_stats_by('det84_grp', id, ds, v, '1d', seasonal_period := 7);
----
true

# det_trend60 (fixture trend 0.974173889872301): seasonal_period := 1 -> non-seasonal,
# seasonality_strength NULL, trend_strength matches the supsmu-based fixture value.
statement ok
CREATE TABLE det60 AS
SELECT DATE '2024-01-01' + INTERVAL (t - 1) DAY AS ds,
       0.5 * t + 2 * sin(1.3 * t) AS v
FROM (SELECT UNNEST(generate_series(1, 60)) AS t);

statement ok
CREATE TABLE det60_grp AS SELECT 'g' AS id, ds, v FROM det60;

query I
SELECT seasonality_strength IS NULL AND abs(trend_strength - 0.974173889872301) < 1e-8
FROM ts_stats_by('det60_grp', id, ds, v, '1d', seasonal_period := 1);
----
true

# The first 14 det_seasonal84 rows with seasonal_period := 7: n (14) <= 2*period (14), so no
# usable period (R's own tsfeatures/mstl fallback for an insufficiently-long series) ->
# seasonality_strength NULL.
statement ok
CREATE TABLE det84_short_grp AS SELECT 'g' AS id, ds, v FROM det84 ORDER BY ds LIMIT 14;

query I
SELECT seasonality_strength IS NULL
FROM ts_stats_by('det84_short_grp', id, ds, v, '1d', seasonal_period := 7);
----
true

# seasonal_period := 0 (auto-detect) on det84 agrees with ts_stats_agg (which always
# auto-detects, having no period argument) and is NOT NULL.
query I
SELECT
  (SELECT trend_strength FROM ts_stats_by('det84_grp', id, ds, v, '1d', seasonal_period := 0))
    IS NOT DISTINCT FROM
  (SELECT (ts_stats_agg(ds, v)).trend_strength FROM det84_grp)
  AND
  (SELECT seasonality_strength FROM ts_stats_by('det84_grp', id, ds, v, '1d', seasonal_period := 0))
    IS NOT DISTINCT FROM
  (SELECT (ts_stats_agg(ds, v)).seasonality_strength FROM det84_grp)
  AND
  (SELECT seasonality_strength FROM ts_stats_by('det84_grp', id, ds, v, '1d', seasonal_period := 0))
    IS NOT NULL;
----
true

# seasonal_period := -1 is a bind-time error naming ts_stats_by.
statement error
SELECT trend_strength FROM ts_stats_by('det84_grp', id, ds, v, '1d', seasonal_period := -1);
----
seasonal_period must be >= 0
