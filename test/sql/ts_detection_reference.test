# --- errors: non-integer period with 'classical'; a zero in a 'classical_multiplicative' series ---

statement error
SELECT ts_decompose_seasonal(list_transform(range(84), lambda i: i::DOUBLE), 12.5, 'classical');
----
classical decomposition requires an integer period >= 2

statement error
SELECT ts_decompose_seasonal(list_transform(range(48), lambda i: 0.0), 12.0, 'classical_multiplicative');
----
multiplicative decomposition requires strictly positive values

# --- _ts_mstl_decomposition insufficient-data modes: n 20, period [12] (needs n > 24) ---

query I
SELECT (_ts_mstl_decomposition(list_transform(range(20), lambda i: i::DOUBLE), 'fail', [12])) IS NULL;
----
true

query I
SELECT (_ts_mstl_decomposition(list_transform(range(20), lambda i: i::DOUBLE), 'trend', [12])).periods = []
   AND (_ts_mstl_decomposition(list_transform(range(20), lambda i: i::DOUBLE), 'trend', [12])).trend IS NOT NULL;
----
true

# CR-01 regression: insufficient_data='none' with a requested period that is
# never usable (needs n > 2*1000+1) must return a non-NULL struct with EMPTY
# trend/remainder lists, never a trend/remainder list of length n backed by
# uninitialized ListVector buffer memory (the row is a legitimate "no
# decomposition applied" result, not a NULL row and not garbage data).

query I
SELECT (_ts_mstl_decomposition(list_transform(range(20), lambda i: i::DOUBLE), 'none', [1000])) IS NOT NULL;
----
true

query I
SELECT len((_ts_mstl_decomposition(list_transform(range(20), lambda i: i::DOUBLE), 'none', [1000])).trend) = 0
   AND len((_ts_mstl_decomposition(list_transform(range(20), lambda i: i::DOUBLE), 'none', [1000])).remainder) = 0
   AND (_ts_mstl_decomposition(list_transform(range(20), lambda i: i::DOUBLE), 'none', [1000])).periods = [];
----
true

statement error
SELECT _ts_mstl_decomposition(list_transform(range(48), lambda i: i::DOUBLE), 'fail', [0]);
----
period must be >= 1

# ts_mstl_decomposition_by's params.seasonal_periods/periods wiring (D-09) is
# verified in the interactive shell with `LOAD json;` (the macro expands
# through json_extract_string/to_json, which this NON-json-gated file
# otherwise stays free of per its own header comment) -- not asserted here.
# See 15-04-SUMMARY.md for the exact shell transcript: MAP{'seasonal_periods':
# '[7]'} and MAP{'periods': '[7]'} both return periods [7]; MAP{} returns [].

#######################################
# 15-05 FFT period (DET-05, D-11, G18): detrended_periodogram selects the
# strongest bin 3 <= k <= floor(n/2) -- period is never n and always < n/2.
# Before this plan, the undetrended fdars-core 0.47 FFT estimator reported
# period = n = 121 for the n121 series below.
#######################################

# trend + seasonal, n 120 -> period 12.0 exactly (even n)

query I
SELECT (ts_estimate_period_fft(
    list_transform(range(120), lambda t: 0.5 * t + 2 * sin(2 * pi() * t / 12))
)).period;
----
12.0

# trend + seasonal, n 121 (odd) -> period 12.1, confidence > 5 (FFT min-confidence default)

query I
SELECT abs((ts_estimate_period_fft(
    list_transform(range(121), lambda t: 0.5 * t + 2 * sin(2 * pi() * t / 12))
)).period - 12.1) <= 1e-9;
----
true

query I
SELECT (ts_estimate_period_fft(
    list_transform(range(121), lambda t: 0.5 * t + 2 * sin(2 * pi() * t / 12))
)).confidence > 5;
----
true

# _ts_detect_periods(..., 'fft') agrees with the scalar function

query I
SELECT (_ts_detect_periods(
    list_transform(range(120), lambda t: 0.5 * t + 2 * sin(2 * pi() * t / 12)),
    'fft'
)).primary_period;
----
12.0

# a constant series -> NaN period (no candidate bin survives the
# scale-relative is_constant check on the detrended series)

query I
SELECT isnan((ts_estimate_period_fft(list_transform(range(30), lambda i: 4.25))).period);
----
true

#######################################
# 15-05 ACF / regression / Lomb-Scargle / strength (DET-05, DET-06, D-11,
# D-12, G17/G19/G20/G21).
#######################################

# ACF: alternating series -> period 2.0 (previously unreachable -- fdars
# 0.47's own ACF estimator starts its peak search at lag 3)

query I
SELECT (ts_estimate_period_acf(
    list_transform(range(40), lambda i: CASE WHEN i % 2 = 0 THEN 1.0 ELSE -1.0 END)
)).period;
----
2.0

# ACF: a constant series -> NaN period (c_0 == 0, every acf entry is NaN)

query I
SELECT isnan((ts_estimate_period_acf(list_transform(range(30), lambda i: 4.25))).period);
----
true

# Regression: a noise-free period-12 sine, default integer grid -> 12.0
# exactly (previously the 50-point linear grid could skip 12 entirely)

query I
SELECT (_ts_detect_periods(
    list_transform(range(120), lambda t: sin(2 * pi() * t / 12)),
    'regression'
)).primary_period;
----
12.0

# Lomb-Scargle: sine12_n60 fixture series -- period within 1e-9 of the
# scipy.signal.lombscargle(..., normalize=True) * n/2 reference

query I
SELECT abs((ts_lomb_scargle([
    0.1037, 0.7465, 0.9652, 0.6091, 1.1376, 0.6339, -0.1611, -0.3257, -0.7567,
    -0.9118, -0.8575, -0.336, -0.2209, 0.4511, 0.7214, 1.1797, 0.8779, 0.4123,
    -0.2346, -0.5772, -0.8636, -1.0827, -0.4778, -0.198, -0.8133, -0.0667,
    0.8136, 0.8733, 0.9301, 0.5652, 0.6354, -0.8336, -0.9793, -0.3872, -0.672,
    -0.3011, -0.1542, 0.0056, 0.9163, 1.0327, 0.4978, 0.295, -0.0216, -0.7834,
    -0.8955, -0.9714, -0.8553, -0.6519, 0.1781, 0.7674, 0.9623, 0.7545,
    1.0855, 0.3496, 0.2637, -0.8215, -0.5917, -1.006, -1.2407, -0.5942
]::DOUBLE[])).period - 11.996946875636068) <= 1e-9;
----
true

# Lomb-Scargle: n_frequencies < 2 and min_period >= max_period both error
# (previously division by zero / an inverted frequency grid, G21)

statement error
SELECT ts_lomb_scargle(list_transform(range(60), lambda t: sin(2 * pi() * t / 12)), 0.0, 0.0, 1);
----
n_frequencies

statement error
SELECT ts_lomb_scargle(list_transform(range(60), lambda t: sin(2 * pi() * t / 12)), 24.0, 6.0, 0);
----
min_period

# CR-02 regression: a negative n_frequencies must raise a catchable SQL
# error, not wrap to a huge size_t (via the int64_t -> size_t cast) and
# attempt a multi-exabyte Vec<f64> allocation that aborts the whole DuckDB
# process. Also check an absurdly large positive value is rejected the
# same way (Rust-side upper bound).

statement error
SELECT ts_lomb_scargle(list_transform(range(60), lambda t: sin(2 * pi() * t / 12)), 0.0, 0.0, -1);
----
n_frequencies

statement error
SELECT ts_lomb_scargle(list_transform(range(60), lambda t: sin(2 * pi() * t / 12)), 0.0, 0.0, 2000000000);
----
n_frequencies

# Seasonal strength: linearly detrend FIRST (G19) -- a trend + seasonal
# series previously measured ~0.003 (variance) / ~0.014 (spectral) on the
# raw series; detrended, it is >= 0.95 / >= 0.9.

query I
SELECT ts_seasonal_strength(
    list_transform(range(120), lambda t: 0.5 * t + 2 * sin(2 * pi() * t / 12)), 12.0
) >= 0.95;
----
true

query I
SELECT ts_seasonal_strength(
    list_transform(range(120), lambda t: 0.5 * t + 2 * sin(2 * pi() * t / 12)), 12.0, 'spectral'
) >= 0.9;
----
true

# Seasonal strength: 'wavelet' is removed (always 1.0 even for white noise
# in fdars-core 0.47); any other unknown method name also errors.

statement error
SELECT ts_seasonal_strength(
    list_transform(range(120), lambda t: 0.5 * t + 2 * sin(2 * pi() * t / 12)), 12.0, 'wavelet'
);
----
removed

statement error
SELECT ts_seasonal_strength(
    list_transform(range(120), lambda t: 0.5 * t + 2 * sin(2 * pi() * t / 12)), 12.0, 'foo'
);
----
expected one of

# CR-03 regression: a NaN period must be a caught InvalidParameter SQL
# error, never a silently-wrong non-error result. Before the fix,
# `period <= 0.0` is false for NaN (all IEEE-754 ordered comparisons with
# NaN are false), so this previously returned 0.0 ("not seasonal at all")
# instead of erroring.

statement error
SELECT ts_seasonal_strength(
    list_transform(range(120), lambda t: 0.5 * t + 2 * sin(2 * pi() * t / 12)), 'nan'::DOUBLE
);
----
Period must be a positive finite number

statement error
SELECT ts_decompose_seasonal(
    list_transform(range(48), lambda i: (10 + 0.1 * i + 3 * sin(2 * pi() * i / 12))::DOUBLE), 'nan'::DOUBLE
);
----
Period must be a positive finite number

statement error
SELECT ts_classify_seasonality(
    list_transform(range(120), lambda i: (10 + 5 * sin(2 * pi() * i / 12))::DOUBLE), 'nan'::DOUBLE
);
----
Period must be a positive finite number

statement error
SELECT ts_seasonal_strength_windowed(
    list_transform(range(120), lambda t: 0.5 * t + 2 * sin(2 * pi() * t / 12)), 12.0, 24.0, 'wavelet'
);
----
removed

#######################################
# 15-05 is_constant and edge-NULL policy (DET-07, D-13, D-14, G25, G26).
# is_constant is scale-relative everywhere: fixed here for _ts_is_constant /
# ts_drop_constant_by; edge-NULL interpolation behaviour is DOCUMENTED, not
# changed -- LOCF/NOCB fill one direction only, and internal exog
# interpolation extends the nearest observed value at the edges (no
# extrapolation).
#######################################

# _ts_is_constant: scale-relative tolerance (previously absolute f64::EPSILON)

query I
SELECT _ts_is_constant([1e12, 1e12 + 0.001]::DOUBLE[]);
----
true

query I
SELECT _ts_is_constant([1.0, 1.0 + 1e-9]::DOUBLE[]);
----
false

query I
SELECT _ts_is_constant([5.0, NULL, 5.0, 'NaN'::DOUBLE]::DOUBLE[]);
----
true

# ts_drop_constant_by: a two-group table where one group is "constant at
# the 1e12 scale" (a tiny wiggle well under the scale-relative tolerance)
# and one is a real (non-constant) series -- only the real series survives.

statement ok
CREATE TABLE const_scale_t AS
SELECT 'const_at_scale' AS id, DATE '2024-01-01' + INTERVAL (i) DAY AS ds,
       (1e12 + (i % 2) * 0.0001)::DOUBLE AS v
FROM range(10) r(i)
UNION ALL
SELECT 'real_series' AS id, DATE '2024-01-01' + INTERVAL (i) DAY AS ds, i::DOUBLE AS v
FROM range(10) r(i);

query I
SELECT list(DISTINCT id ORDER BY id) FROM ts_drop_constant_by('const_scale_t', id, v);
----
[real_series]

# ts_fill_nulls_forward_by (LOCF) / ts_fill_nulls_backward_by (NOCB):
# leading/trailing NULLs are NOT filled by the opposite direction -- a
# leading NULL stays NULL under forward fill, a trailing NULL stays NULL
# under backward fill (D-14, revised: current behaviour documented, not
# changed).

statement ok
CREATE TABLE edge_null_t AS
SELECT 'a' AS id, DATE '2024-01-01' + INTERVAL (i) DAY AS ds, v
FROM (SELECT unnest(range(5)) AS i, unnest([NULL, 1.0, NULL, 3.0, NULL]) AS v);

query I
SELECT list(filled_value ORDER BY ds) FROM ts_fill_nulls_forward_by('edge_null_t', id, ds, v);
----
[NULL, 1.0, 1.0, 3.0, 3.0]

query I
SELECT list(filled_value ORDER BY ds) FROM ts_fill_nulls_backward_by('edge_null_t', id, ds, v);
----
[1.0, 1.0, 3.0, 3.0, NULL]

# _ts_forecast_exog: a NULL edge on the historical regressor (positions 1,
# 2, and 120 of a 1-based 120-row series) gives point forecasts within
# 1e-9 of the run where those positions are replaced by the NEAREST
# observed value (constant edge extension, not extrapolation) -- pinning
# forecast.rs::prepare_exog_regressors's existing behaviour (G26).

query I
SELECT max(abs(a - b)) < 1e-9
FROM (
    WITH gen AS (
        SELECT i,
               50.0 + 3.0 * sin(i * 0.37) + (i % 5)::DOUBLE AS y,
               CASE WHEN i IN (1, 2, 120) THEN NULL ELSE sin(i * 0.37) END AS x1_null_edges,
               CASE WHEN i IN (1, 2) THEN sin(3 * 0.37)
                    WHEN i = 120 THEN sin(119 * 0.37)
                    ELSE sin(i * 0.37) END AS x1_nearest_filled
        FROM range(1, 121) AS t(i)
    ), fut AS (
        SELECT sin((120 + i) * 0.37) AS x1 FROM range(6) AS t(i)
    )
    SELECT
        unnest((SELECT _ts_forecast_exog(
            (SELECT list(y ORDER BY i) FROM gen),
            [(SELECT list(x1_null_edges ORDER BY i) FROM gen)],
            [(SELECT list(x1) FROM fut)],
            6, 'OptimizedTheta'
        )).point) AS a,
        unnest((SELECT _ts_forecast_exog(
            (SELECT list(y ORDER BY i) FROM gen),
            [(SELECT list(x1_nearest_filled ORDER BY i) FROM gen)],
            [(SELECT list(x1) FROM fut)],
            6, 'OptimizedTheta'
        )).point) AS b
);
----
true

#######################################
# Iteration 2 (re-review of the --auto fix loop): CR-04, CR-05, WR-03.
#######################################

# CR-04 regression: ts_mstl_decomposition_by must never silently drop a
# group. 'long' (n=30) has a usable period 12 (30 > 2*12); 'short' (n=10)
# does not (10 is not > 2*12=24) -- before the fix, ts_mstl_decomposition_
# native.cpp's finalize loop `continue`-d past 'short' under BOTH
# insufficient_data='fail' (the documented default) and 'none', silently
# dropping its row with no error and no diagnostic. A second, independent
# bug compounded this: the native function's ParseInsufficientDataMode
# recognized "fail"/"skip"/"pad" rather than the macro's actual documented
# values "fail"/"trend"/"none", so passing 'trend' or 'none' was silently
# treated as 'fail' regardless.
#
# Exercised via the internal _ts_mstl_decomposition_native table function
# directly rather than the public ts_mstl_decomposition_by macro: the
# macro's expansion unconditionally calls to_json(params) (even for an
# empty MAP{}), which requires the json extension -- unavailable in this
# native, non-json-gated build (confirmed: json is skipped, not
# auto-loaded, for every other "require json" file in this suite). This is
# a pre-existing, independent gap (ts_mstl_decomposition_by has literally
# never been exercised by a non-json-gated test -- its only other caller,
# test/sql/ts_varchar_edge_cases.test, has its own `require json`) --
# tracked here, not fixed, since CR-04's fix is in
# _ts_mstl_decomposition_native's finalize loop, which this reaches
# directly and identically to how the macro would.

statement ok
CREATE TABLE mstl_mixed_t AS
SELECT 'long' AS id, DATE '2024-01-01' + INTERVAL (i) DAY AS ds, (10 + i % 12)::DOUBLE AS v
FROM range(30) r(i)
UNION ALL
SELECT 'short' AS id, DATE '2024-01-01' + INTERVAL (i) DAY AS ds, (5 + i)::DOUBLE AS v
FROM range(10) r(i);

# insufficient_data = 'fail' (default): a SQL error naming the condition,
# not a silently-dropped row.
statement error
SELECT * FROM _ts_mstl_decomposition_native((SELECT id, ds, v FROM mstl_mixed_t), 'fail', [12]);
----
Insufficient data

# insufficient_data = 'trend': row count preserved (one row per input
# group) -- 'short' gets the non-seasonal (supsmu) trend-only fallback,
# with empty seasonal/periods, exactly as ts_mstl_decomposition_by's own
# docs promise.
query I
SELECT count(*) FROM _ts_mstl_decomposition_native((SELECT id, ds, v FROM mstl_mixed_t), 'trend', [12]);
----
2

query I
SELECT list(id ORDER BY id) FROM _ts_mstl_decomposition_native((SELECT id, ds, v FROM mstl_mixed_t), 'trend', [12]);
----
[long, short]

query III
SELECT len(trend) > 0, periods, len(seasonal)
FROM _ts_mstl_decomposition_native((SELECT id, ds, v FROM mstl_mixed_t), 'trend', [12])
WHERE id = 'short';
----
true	[]	0

# insufficient_data = 'none': row count still preserved -- 'short' gets
# empty trend/seasonal/remainder/periods, the same shape the scalar
# _ts_mstl_decomposition produces for the identical condition after CR-01
# (table and scalar surfaces now agree), instead of vanishing from the
# result set.
query I
SELECT count(*) FROM _ts_mstl_decomposition_native((SELECT id, ds, v FROM mstl_mixed_t), 'none', [12]);
----
2

query IIII
SELECT trend, seasonal, remainder, periods
FROM _ts_mstl_decomposition_native((SELECT id, ds, v FROM mstl_mixed_t), 'none', [12])
WHERE id = 'short';
----
[]	[]	[]	[]

# The already-working 'long' group must stay unaffected by the CR-04 fix in
# every mode -- it still decomposes normally with its one usable period.
query I
SELECT len(periods) FROM _ts_mstl_decomposition_native((SELECT id, ds, v FROM mstl_mixed_t), 'none', [12]) WHERE id = 'long';
----
1

# CR-05 / WR-03 regression: ts_detect_seasonality_changes, ts_detect_
# amplitude_modulation, and ts_analyze_peak_timing were missing the
# `error.code == INVALID_INPUT -> throw` branch their 6 siblings already
# had, so a NaN/non-finite/non-positive period silently returned NULL
# instead of raising the documented SQL error. WR-03 additionally removed a
# stale, now-redundant `period <= 0.0` FFI-level pre-check on these (and 4
# other) functions that produced an inconsistent message for -Infinity --
# all five non-finite/non-positive values below must now raise the SAME
# "Period must be a positive finite number" message for all three
# functions.

foreach period nan inf -inf -5.0 0.0

statement error
SELECT ts_detect_seasonality_changes(
    list_transform(range(120), lambda i: (10 + 5 * sin(2 * pi() * i / 12))::DOUBLE), '${period}'::DOUBLE
);
----
Period must be a positive finite number

statement error
SELECT ts_detect_amplitude_modulation(
    list_transform(range(120), lambda i: (10 + 5 * sin(2 * pi() * i / 12))::DOUBLE), '${period}'::DOUBLE
);
----
Period must be a positive finite number

statement error
SELECT ts_analyze_peak_timing(
    list_transform(range(120), lambda i: (10 + 5 * sin(2 * pi() * i / 12))::DOUBLE), '${period}'::DOUBLE
);
----
Period must be a positive finite number

endloop
