    [2.5493, 1.3028, 2.4308, 2.7782, 5.177, 4.434, 6.4706, 4.175, 4.9883, 2.5192, 3.6899, 2.0347, -0.4522, -2.6214, -1.8198, -3.2958, -3.1333, -4.1239, -3.0472, -3.8958, -4.8218, -3.477, -2.5487, -1.2888, -1.4144, 1.1338, 2.2173, 3.0776, 3.2799, 4.7184, 4.4539, 4.8138, 3.5784, 1.9711, 3.2391, 1.0433, 0.1429, -1.171, -3.384, -2.9902, -3.0282, -4.6075, -5.0063, -4.8807, -3.3728, -4.0728, -4.0563, -2.86, 1.4552, 2.9945, 3.7906, 3.6793, 3.492, 6.1768, 5.303, 5.2719, 5.3594, 4.6188, 2.8634, 1.4794, 1.3073, -0.5247, -1.8071, -2.5793, -5.4727, -5.8569, -4.7404, -4.45, -4.1955, -3.7171, -2.186, 2.332, -1.6375, 3.6105, 4.4068, 5.255, 4.3021, 3.6349, 3.8344, 3.0199, 4.2293, 4.1631, 1.6368, 2.514, 1.7897, -1.0933, -2.5882, -2.8823, -4.6867, -4.9239, -4.9361, -3.7799, -4.7525, -0.9795, -2.8379, -1.1922, 0.5579, 0.6935, 1.9406, 2.801, 4.5823, 3.4091, 3.4919, 5.3178, 2.3162, 3.5858, 2.7631, 0.6495, -1.0108, -1.9737, -0.7532, -2.6294, -4.3066, -5.1779, -4.326, -5.9822, -5.0645, -4.1018, -3.2526, -1.305, 1.2325, 1.6167, 0.737, 3.1873, 4.1286, 4.8163, 4.7368, 5.3104, 4.2915, 4.7096, 2.6424, 2.7493, 0.9502, -2.7221, -1.0491, -3.5312, -1.6823, -5.2125, -5.0575, -5.1348, -4.6846, -3.3314, -2.6609, 0.458, 0.7649, 2.3556, 0.6317, 5.4364, 5.0984, 5.9352, 5.0899, 5.1495, 5.0436, 2.1653, 4.8397, 1.2359, 0.3679, -2.4028, -0.7132, -4.8841, -4.6025, -5.4316, -4.7408, -4.7646, -5.6186, -2.0132, -2.2516, -3.3538, -0.7118, 2.3535, 2.9545, 3.4425, 3.6696, 5.6953, 3.3534, 6.5171, 4.8534, 3.4389, 2.8037, 2.1621, 0.044, 0.014, -2.8511, -4.2366, -5.6497, -6.4797, -5.4341, -5.3191, -2.9137, -3.2788, -0.6151, -2.3038, -0.593, 1.5809, 0.8006, 2.6705, 4.6214, 4.8331, 5.6035, 5.1523, 3.4785, 4.8447, 2.6023, 1.8206, 0.5145, -2.0244, -4.6179, -4.4969, -4.2024, -4.2884, -4.9053, -4.4357, -4.204, -3.5524, -0.8272, -2.5112, -0.213, 1.0641, 2.7803, 2.5762, 3.6185, 5.717, 4.337, 4.3476, 4.6352, 3.8311, 1.3017, 1.2331, -0.8043, -0.0035, -5.2239, -2.2511, -4.8854, -5.4983, -4.17, -6.0261, -4.2451, -3.7479, -1.4536, 1.3362]
) AS v);

# --- min_distance = 8.0 matches scipy's distance=8 filter ---

query I
SELECT list_transform((SELECT ts_detect_peaks(LIST(v ORDER BY ds), 8.0) FROM sine240_peaks).peaks, lambda p: p.index)
     = [6, 14, 23, 31, 39, 53, 75, 83, 93, 103, 114, 127, 136, 149, 158, 175, 190, 198, 208, 221, 229]::BIGINT[];
----
true

# --- min_prominence = 2.0 matches scipy's prominence=2.0 filter ---

query I
SELECT list_transform((SELECT ts_detect_peaks(LIST(v ORDER BY ds), 0.0, 2.0) FROM sine240_peaks).peaks, lambda p: p.index)
     = [6, 31, 53, 71, 75, 103, 127, 149, 154, 173, 175, 198, 221, 231]::BIGINT[];
----
true

# --- NULL min_distance behaves like 0.0 (no distance filter) ---
# A literal SQL NULL constant short-circuits to a NULL struct (DuckDB's
# default null-propagation for scalar functions without SPECIAL_HANDLING,
# unrelated to this plan) -- a column-sourced NULL reaches the C++ reader's
# own per-row IsNull() check, which is what "NULL defaults to 0.0" means.

statement ok
CREATE TABLE peaks_null_check(v DOUBLE[], md DOUBLE);

statement ok
INSERT INTO peaks_null_check VALUES
    ((SELECT LIST(v ORDER BY ds) FROM sine240_peaks), NULL),
    ((SELECT LIST(v ORDER BY ds) FROM sine240_peaks), 0.0);

query I
SELECT (SELECT (ts_detect_peaks(v, md)).n_peaks FROM peaks_null_check WHERE md IS NULL)
     = (SELECT (ts_detect_peaks(v, md)).n_peaks FROM peaks_null_check WHERE md = 0.0);
----
true

# --- smooth_first = true: n_peaks > 0, strictly increasing indices ---

query I
SELECT n_peaks > 0
FROM (SELECT (SELECT ts_detect_peaks(LIST(v ORDER BY ds), 0.0, 0.0, true) FROM sine240_peaks).n_peaks AS n_peaks);
----
true

query I
SELECT list_aggregate(list_transform(idx_pairs, lambda p: CASE WHEN p[2] > p[1] THEN 1 ELSE 0 END), 'min') = 1
FROM (
    SELECT list_zip(idx_list[1:len(idx_list)-1], idx_list[2:]) AS idx_pairs
    FROM (
        SELECT list_transform((SELECT ts_detect_peaks(LIST(v ORDER BY ds), 0.0, 0.0, true) FROM sine240_peaks).peaks, lambda p: p.index) AS idx_list
    )
);
----
true

