# name: test/sql/ts_triggers.test
# description: #302 - in-database forecast monitoring with DuckDB 2.0 triggers (the
#   recipes in docs/guides/04-monitoring-with-triggers.md): an interval-breach alert
#   per inserted actual (row trigger) and a refresh of the stale series' forecasts per
#   insert statement (statement trigger + MERGE INTO). CREATE TRIGGER does not parse
#   on v1.5, so it runs as `statement maybe` and the checks go through v2_or.
# group: [sql]

require anofox_forecast

statement ok
CREATE MACRO v2_or(sql, fallback) AS TABLE
    SELECT * FROM query(CASE WHEN version() >= 'v2' THEN sql ELSE fallback END);

# --- recipe 1: interval-breach alerts -------------------------------------------
statement ok
CREATE TABLE forecasts (id VARCHAR, ds TIMESTAMP, yhat DOUBLE, yhat_lower DOUBLE, yhat_upper DOUBLE);

statement ok
INSERT INTO forecasts VALUES ('a', TIMESTAMP '2024-02-01', 10, 8, 12), ('a', TIMESTAMP '2024-02-02', 10, 8, 12);

statement ok
CREATE TABLE actuals (id VARCHAR, ds TIMESTAMP, y DOUBLE);

statement ok
CREATE TABLE alerts (id VARCHAR, ds TIMESTAMP, y DOUBLE, yhat_lower DOUBLE, yhat_upper DOUBLE);

statement maybe
CREATE TRIGGER interval_breach AFTER INSERT ON actuals FOR EACH ROW
INSERT INTO alerts
SELECT NEW.id, NEW.ds, NEW.y, f.yhat_lower, f.yhat_upper
FROM forecasts f
WHERE f.id = NEW.id AND f.ds = NEW.ds AND (NEW.y < f.yhat_lower OR NEW.y > f.yhat_upper);
----
syntax error

statement ok
INSERT INTO actuals VALUES ('a', TIMESTAMP '2024-02-01', 11), ('a', TIMESTAMP '2024-02-02', 15);

query III
FROM v2_or($$SELECT id, ds::DATE, y FROM alerts$$, $$SELECT 'a', DATE '2024-02-02', 15.0$$);
----
a	2024-02-02	15.0

# --- recipe 2: refresh the stale series on each insert statement ------------------
statement ok
CREATE TABLE sales AS
SELECT s AS id, TIMESTAMP '2024-01-01' + INTERVAL (i) DAY AS ds, (10 + i % 7 + (s = 'b')::INT * 10)::DOUBLE AS y
FROM range(30) t(i), (VALUES ('a'), ('b')) v(s);

statement ok
CREATE TABLE sales_fc (id VARCHAR, ds TIMESTAMP, yhat DOUBLE, yhat_lower DOUBLE, yhat_upper DOUBLE);

statement maybe
CREATE TRIGGER refresh_forecasts AFTER INSERT ON sales FOR EACH STATEMENT
MERGE INTO sales_fc t
USING (
    SELECT id, unnest((f).forecast_timestamp) AS ds, unnest((f).point_forecast) AS yhat,
           unnest((f).lower_90) AS yhat_lower, unnest((f).upper_90) AS yhat_upper
    FROM (SELECT id, ts_forecast_agg(ds, y, 'SES', 3, MAP{}) AS f
          FROM sales
          WHERE id IN (SELECT a.id
                       FROM (SELECT id, max(ds) AS last_actual FROM sales GROUP BY id) a
                       LEFT JOIN (SELECT id, min(ds) AS first_fc FROM sales_fc GROUP BY id) f USING (id)
                       WHERE f.first_fc IS NULL OR a.last_actual >= f.first_fc)
          GROUP BY id)
) s
ON t.id = s.id AND t.ds = s.ds
WHEN MATCHED THEN UPDATE SET yhat = s.yhat, yhat_lower = s.yhat_lower, yhat_upper = s.yhat_upper
WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.ds, s.yhat, s.yhat_lower, s.yhat_upper)
WHEN NOT MATCHED BY SOURCE AND t.ds <= (SELECT max(ds) FROM sales x WHERE x.id = t.id) THEN DELETE;
----
syntax error

# the first insert fits every series (none has forecasts yet)
statement ok
INSERT INTO sales VALUES ('a', TIMESTAMP '2024-01-31', 12);

query IIII
FROM v2_or($$SELECT id, count(*), min(ds)::DATE, max(ds)::DATE FROM sales_fc GROUP BY id ORDER BY id$$,
           $$SELECT * FROM (VALUES ('a', 3, DATE '2024-02-01', DATE '2024-02-03'), ('b', 3, DATE '2024-01-31', DATE '2024-02-02'))$$);
----
a	3	2024-02-01	2024-02-03
b	3	2024-01-31	2024-02-02

# a new actual for 'a' refits only 'a' and drops its forecast for the now-observed day
statement ok
INSERT INTO sales VALUES ('a', TIMESTAMP '2024-02-01', 14);

query IIII
FROM v2_or($$SELECT id, count(*), min(ds)::DATE, max(ds)::DATE FROM sales_fc GROUP BY id ORDER BY id$$,
           $$SELECT * FROM (VALUES ('a', 3, DATE '2024-02-02', DATE '2024-02-04'), ('b', 3, DATE '2024-01-31', DATE '2024-02-02'))$$);
----
a	3	2024-02-02	2024-02-04
b	3	2024-01-31	2024-02-02

# the refreshed forecast equals a direct fit on the current data
query I
FROM v2_or($$
    SELECT count(*) FROM (
        SELECT ds, yhat FROM sales_fc WHERE id = 'a'
        EXCEPT
        SELECT unnest((f).forecast_timestamp), unnest((f).point_forecast)
        FROM (SELECT ts_forecast_agg(ds, y, 'SES', 3, MAP{}) AS f FROM sales WHERE id = 'a'))
$$, $$SELECT 0$$);
----
0
