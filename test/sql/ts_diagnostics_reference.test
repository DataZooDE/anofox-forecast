# name: test/sql/ts_diagnostics_reference.test
# description: Phase 17 diagnostics value assertions against checked-in fixtures (plans 17-01..17-02)
# group: [sql]
#
# Non-json-gated so it runs on every native build (Phase 13 lesson, D-12) --
# every macro used here (ts_adf_by / ts_kpss_by / ts_stationarity_by) is
# json-free. This file stays free of any json-extension require directive.
#
# Literals below are copied from fixture JSON via a one-line python3 snippet,
# e.g. for validation/reference/fixtures/statsmodels_stationarity/adf_kpss_cases.json:
#   python3 -c "import json; d=json.load(open('validation/reference/fixtures/statsmodels_stationarity/adf_kpss_cases.json')); cases={c['name']: c for c in d['cases']}; print(cases['air']['regressions']['ct']['adf'])"

require anofox_forecast

#######################################
# Setup: air17 (AirPassengers, 144 rows) and ts17 (trend_stationary, 100 rows)
#######################################

statement ok
CREATE TABLE air17 AS
SELECT 'air' AS id, DATE '1949-01-01' + INTERVAL (i) MONTH AS ds, v
FROM (SELECT unnest(range(144)) AS i, unnest([
    112,118,132,129,121,135,148,148,136,119,104,118,115,126,141,135,125,149,
    170,170,158,133,114,140,145,150,178,163,172,178,199,199,184,162,146,166,
    171,180,193,181,183,218,230,242,209,191,172,194,196,196,236,235,229,243,
    264,272,237,211,180,201,204,188,235,227,234,264,302,293,259,229,203,229,
    242,233,267,269,270,315,364,347,312,274,237,278,284,277,317,313,318,374,
    413,405,355,306,271,306,315,301,356,348,355,422,465,467,404,347,305,336,
    340,318,362,348,363,435,491,505,404,359,310,337,360,342,406,396,420,472,
    548,559,463,407,362,405,417,391,419,461,472,535,622,606,508,461,390,432
]::DOUBLE[]) AS v);

statement ok
CREATE TABLE ts17 AS
SELECT 'ts' AS id, DATE '2024-01-01' + INTERVAL (i) DAY AS ds, v
FROM (SELECT unnest(range(100)) AS i, unnest([
    11.6868,11.6724,11.7833,11.1672,11.9244,11.9678,11.7347,11.9132,13.0209,
    13.9755,12.6389,11.3045,11.1077,12.8573,12.3706,12.1477,13.7922,14.5765,
    13.4204,10.7194,11.9456,13.974,14.2568,12.7642,12.7654,14.6512,15.689,
    12.7434,11.9204,13.6517,15.4728,16.7095,15.8291,15.5605,16.3353,17.4651,
    17.2086,18.1492,19.4742,19.7893,19.7197,20.1087,18.5176,19.301,17.9914,
    19.8214,19.0297,17.6203,17.5362,19.0964,19.0789,20.4123,21.7995,20.9125,
    21.1322,22.2103,21.8015,24.1885,23.4572,22.7352,22.3906,22.7709,23.1019,
    24.8245,23.6303,23.6606,24.6127,23.1483,23.5438,24.2914,22.9941,23.6819,
    25.4222,27.0908,27.1649,26.4485,25.8,27.1473,27.7016,27.4023,26.4704,
    26.2581,26.9843,26.2706,28.1165,28.9246,28.1264,27.9331,27.9118,30.5434,
    29.5322,28.9346,27.1721,27.8209,27.5195,28.6054,28.6876,29.5953,31.4823,
    29.888
]::DOUBLE[]) AS v);

#######################################
# 17-01 ADF (statsmodels adfuller)
#######################################

# air17 'c': statistic/p_value within 1e-8 of the fixture, cv_5pct within 1e-10, lags equal
query I
SELECT abs((ts_adf(LIST(v ORDER BY ds), -1, 'c')).statistic - (-0.986479461317597)) < 1e-8
FROM air17;
----
true

query I
SELECT abs((ts_adf(LIST(v ORDER BY ds), -1, 'c')).p_value - 0.7581636095609505) < 1e-8
FROM air17;
----
true

query I
SELECT abs((ts_adf(LIST(v ORDER BY ds), -1, 'c')).cv_5pct - (-2.882567574015525)) < 1e-10
FROM air17;
----
true

query I
SELECT (ts_adf(LIST(v ORDER BY ds), -1, 'c')).lags
FROM air17;
----
4

# air17 'ct': statistic/p_value within 1e-8, cv_5pct within 1e-10, lags equal
query I
SELECT abs((ts_adf(LIST(v ORDER BY ds), -1, 'ct')).statistic - (-7.318571346919129)) < 1e-8
FROM air17;
----
true

query I
SELECT abs((ts_adf(LIST(v ORDER BY ds), -1, 'ct')).cv_5pct - (-3.4427962380330523)) < 1e-10
FROM air17;
----
true

query I
SELECT (ts_adf(LIST(v ORDER BY ds), -1, 'ct')).lags
FROM air17;
----
5

# ts_adf_by(regression := 'ct') equals the scalar on the same series
query I
SELECT abs((adf).statistic - (SELECT (ts_adf(LIST(v ORDER BY ds), -1, 'ct')).statistic FROM air17)) < 1e-12
FROM ts_adf_by('air17', id, ds, v, regression := 'ct');
----
true

# the macro without regression equals 'c' (the default)
query I
SELECT abs((adf).statistic - (SELECT (ts_adf(LIST(v ORDER BY ds), -1, 'c')).statistic FROM air17)) < 1e-12
FROM ts_adf_by('air17', id, ds, v);
----
true

# a NULL regression means 'c'
query I
SELECT abs((ts_adf(LIST(v ORDER BY ds), -1, NULL)).statistic - (-0.986479461317597)) < 1e-8
FROM air17;
----
true

# 'CT' (case-insensitive) equals 'ct'
query I
SELECT (ts_adf(LIST(v ORDER BY ds), -1, 'CT')).statistic = (ts_adf(LIST(v ORDER BY ds), -1, 'ct')).statistic
FROM air17;
----
true

# unknown regression strings raise an informative error
statement error
SELECT (ts_adf(LIST(v ORDER BY ds), -1, 'n')).statistic FROM air17;
----
expected one of: c, ct

statement error
SELECT (ts_adf(LIST(v ORDER BY ds), -1, 'trend')).statistic FROM air17;
----
expected one of: c, ct

# ts17 with max_lags 1000 and 'ct': lags clamped to <= 47, statistic finite
query I
SELECT (ts_adf(LIST(v ORDER BY ds), 1000, 'ct')).lags <= 47
FROM ts17;
----
true

query I
SELECT isfinite((ts_adf(LIST(v ORDER BY ds), 1000, 'ct')).statistic)
FROM ts17;
----
true

# n=3: NaN statistic and NaN cv_5pct, not a crash
query I
SELECT isnan((ts_adf([1.0, 2.0, 3.0]::DOUBLE[])).statistic)
----
true

query I
SELECT isnan((ts_adf([1.0, 2.0, 3.0]::DOUBLE[])).cv_5pct)
----
true
