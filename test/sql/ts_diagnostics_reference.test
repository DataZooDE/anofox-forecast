    -0.835824915145522,0.502330310352944,0.940407330204003,0.162016133805973,-0.947080103930614,0.189399561382151,
    -1.41975069281159,-0.270996417814145,-0.437087802010838,-1.81647195713291,1.05474741579535,-0.870678711514882,
    0.509701028382605,0.43447401602889,-0.276801385755237,0.503343537564977,0.00388156865526174,-0.918974140037249,
    -0.182528787552765,2.12368527966838,1.24638395324344,0.697403237881655,-0.2894353604561,-1.41539101926921,
    0.264525011450585,0.0106024113034849,-1.47879153733757,1.46011670985537,1.91972901403436,-0.0967424746482399,
    -0.689201745657934,1.05421887667808,-0.407352392941386,0.93958811596761,0.404648339874869,-0.806014867316359,
    -1.49600820119219,-0.835999463517051,0.0662113187260109,0.467482081506365,-0.12677428250455,0.671838146768535,
    -1.20299185678584,-1.22552491171624,0.888157008452704,-0.941968239380464,-0.364582445126387,0.0200179559701344,
    -0.950699722680909,-0.976949371115777,-1.69357412688932,1.51259530102636,-1.77173305711962,1.53138883460201,
    1.08886403067656,0.761757184525572,-1.04495550583131,-1.35807200614954,-0.735249911869923,0.205613278968548,
    1.6956858268712,-0.464826592113979,0.797698925637374,-1.07944478911051,-1.08951612690628,0.585593449225705,
    0.761005192531296,0.867925997036568,1.17466971600245,-0.083431138000067,-1.10180306159788,0.763404938148435,
    -0.475918435505009,1.04323813085357,0.751323529246389,-0.0174455373071992,-0.371163746107245,1.6929606086793,
    -1.66930140209172,1.24511808918733,0.245048567232462,1.67851425946291,-0.989946797432704,0.586243077619852,
    -0.517105152437977,-0.382375542401837,-1.37768385164801,-1.74418388241314,-1.58972940551,-1.62408740259292,
    0.422972049810822,-0.735478965525293,-1.34651459278904,0.119230549917018,0.28426217241873,0.716911598802572
]::DOUBLE[]) AS v);

# lag 10, fitted_params 2: df 8, statistic/p match R Box.test(fitdf=2) to 1e-9
query I
SELECT (ts_ljung_box(LIST(v ORDER BY ds), 10, 2)).df
FROM arma17;
----
8

query I
SELECT abs((ts_ljung_box(LIST(v ORDER BY ds), 10, 2)).statistic - 6.40542007298888) < 1e-9
FROM arma17;
----
true

query I
SELECT abs((ts_ljung_box(LIST(v ORDER BY ds), 10, 2)).p_value - 0.601916478272279) < 1e-9
FROM arma17;
----
true

# ts_ljung_box_by(fitted_params := 2) equals the scalar
query I
SELECT abs((ljung_box).statistic - (SELECT (ts_ljung_box(LIST(v ORDER BY ds), 10, 2)).statistic FROM arma17)) < 1e-12
FROM ts_ljung_box_by('arma17', id, ds, v, lags := 10, fitted_params := 2);
----
true

# lag 20, fitted_params 2: df 18, p matches R Box.test(fitdf=2) to 1e-9
query I
SELECT (ts_ljung_box(LIST(v ORDER BY ds), 20, 2)).df
FROM arma17;
----
18

query I
SELECT abs((ts_ljung_box(LIST(v ORDER BY ds), 20, 2)).p_value - 0.671834559581856) < 1e-9
FROM arma17;
----
true

# 2-arg form (fitted_params omitted) -> df = lags = 10
query I
SELECT (ts_ljung_box(LIST(v ORDER BY ds), 10)).df
FROM arma17;
----
10

#######################################
# 17-02 Ljung-Box edge cases
#######################################

# df <= 0 at the effective lags is a SQL error naming fitted_params
statement error
SELECT (ts_ljung_box(LIST(v ORDER BY ds), 5, 5)).df FROM arma17;
----
fitted_params

statement error
SELECT (ts_ljung_box(LIST(v ORDER BY ds), 5, 7)).df FROM arma17;
----
fitted_params

statement error
SELECT (ts_ljung_box(LIST(v ORDER BY ds), 0)).df FROM arma17;
----
fitted_params

# negative fitted_params is a SQL error naming the value
statement error
SELECT (ts_ljung_box(LIST(v ORDER BY ds), 5, -1)).df FROM arma17;
----
fitted_params must be >= 0

# ts_ljung_box_by(lags := 3, fitted_params := 3) raises the same error
statement error
SELECT (ljung_box).df FROM ts_ljung_box_by('arma17', id, ds, v, lags := 3, fitted_params := 3);
----
fitted_params

# lags 1000 on a 40-point list clamps to 39, no panic
query I
SELECT (ts_ljung_box(list_transform(range(40), i -> sin(i * 0.7)), 1000)).lags
----
39

# a 2-point series: isnan(statistic), not a crash
query I
SELECT isnan((ts_ljung_box([1.0, 2.0]::DOUBLE[])).statistic)
----
true

# diff(rw)[1:30], lag 6, fitted_params 2: df 4, p matches R Box.test(fitdf=2) to 1e-9
statement ok
CREATE TABLE diffrw30 AS
SELECT 'r' AS id, DATE '2024-01-01' + INTERVAL (i) DAY AS ds, v
FROM (SELECT unnest(range(30)) AS i, unnest([
    0.204612204822171,-1.10794428722294,-0.0840144431342531,0.270266410898387,-0.597176483502718,1.03993296264139,
    0.741001171800427,0.823222794685663,1.4474871795357,-0.900594281963712,-0.646241044974623,-0.398616137395182,
    0.490971217436068,0.788357638657052,-0.0371411737745471,-0.746055981153077,-1.477722124961,-1.05972609391119,
    -0.501791627990959,1.34088739417977,-0.265776376353777,-0.23134580251145,-0.459374134327623,-0.0749376556109413,
    -0.5324142004701,-0.647679339000215,-1.54517894645899,-0.793756124415868,1.42239957140555,0.252280651926888
]::DOUBLE[]) AS v);

query I
SELECT (ts_ljung_box(LIST(v ORDER BY ds), 6, 2)).df
FROM diffrw30;
----
4

query I
SELECT abs((ts_ljung_box(LIST(v ORDER BY ds), 6, 2)).p_value - 0.0800218644335882) < 1e-9
FROM diffrw30;
----
true

# ts_residual_diagnostics's Ljung-Box gate (fitted_params 0) equals the scalar
query I
SELECT abs((ts_residual_diagnostics(LIST(v ORDER BY ds))).lb_p_value - (ts_ljung_box(LIST(v ORDER BY ds))).p_value) < 1e-12
FROM arma17;
----
true

#######################################
# WR-01 (review fix): ts_ljung_box / ts_residual_diagnostics NULL-optional-arg
# SPECIAL_HANDLING -- a NULL lags/fitted_params/alpha means the documented
# "auto"/default, not SQL NULL (mirrors ts_adf's "a NULL regression means 'c'"
# fix at line 113-118 above).
#######################################

# a NULL lags means the default (min(10, n/5) = 10 for arma17's 120 rows),
# matching the pinned 10-lag/fitdf=2 reference values above
query I
SELECT (ts_ljung_box(LIST(v ORDER BY ds), NULL, 2)).df
FROM arma17;
----
8

query I
SELECT abs((ts_ljung_box(LIST(v ORDER BY ds), NULL, 2)).statistic - 6.40542007298888) < 1e-9
FROM arma17;
----
true

query I
SELECT abs((ts_ljung_box(LIST(v ORDER BY ds), NULL, 2)).p_value - 0.601916478272279) < 1e-9
FROM arma17;
----
true

# ts_ljung_box(x, NULL, 2) equals ts_ljung_box(x, <default lags>, 2) exactly
query I
SELECT (ts_ljung_box(LIST(v ORDER BY ds), NULL, 2)).statistic = (ts_ljung_box(LIST(v ORDER BY ds), 10, 2)).statistic
   AND (ts_ljung_box(LIST(v ORDER BY ds), NULL, 2)).df = (ts_ljung_box(LIST(v ORDER BY ds), 10, 2)).df
FROM arma17;
----
true

# a NULL fitted_params (3-arg overload) means fitted_params = 0, equal to the
# 2-arg (lags-only) overload and to the 1-arg overload's implicit default lags
query I
SELECT (ts_ljung_box(LIST(v ORDER BY ds), 10, NULL)).statistic = (ts_ljung_box(LIST(v ORDER BY ds), 10)).statistic
   AND (ts_ljung_box(LIST(v ORDER BY ds), 10, NULL)).df = (ts_ljung_box(LIST(v ORDER BY ds), 10)).df
FROM arma17;
----
true

# a NULL series still yields SQL NULL for every overload, even with
# SPECIAL_HANDLING set on the 2-arg/3-arg forms
query II
SELECT ts_ljung_box(NULL::DOUBLE[], 2) IS NULL, ts_ljung_box(NULL::DOUBLE[], 10, 2) IS NULL
----
true	true

# anofox_fcst_ts_ljung_box alias set gets the same NULL-lags fix
query I
SELECT abs((anofox_fcst_ts_ljung_box(LIST(v ORDER BY ds), NULL, 2)).statistic - 6.40542007298888) < 1e-9
FROM arma17;
----
true

# a NULL alpha means the default 0.05, equal to the 1-arg overload
query I
SELECT (ts_residual_diagnostics(LIST(v ORDER BY ds), NULL)).lb_p_value = (ts_residual_diagnostics(LIST(v ORDER BY ds))).lb_p_value
   AND (ts_residual_diagnostics(LIST(v ORDER BY ds), NULL)).adequate = (ts_residual_diagnostics(LIST(v ORDER BY ds))).adequate
FROM arma17;
----
true

# a NULL series still yields SQL NULL for ts_residual_diagnostics's 2-arg form
query I
SELECT ts_residual_diagnostics(NULL::DOUBLE[], 0.05) IS NULL
----
true

# anofox_fcst_ts_residual_diagnostics alias set gets the same NULL-alpha fix
query I
SELECT (anofox_fcst_ts_residual_diagnostics(LIST(v ORDER BY ds), NULL)).lb_p_value = (ts_residual_diagnostics(LIST(v ORDER BY ds))).lb_p_value
FROM arma17;
----
true
