# name: test/sql/_ts_fill_forward_native.test
# description: Test _ts_fill_forward_native table-in-out function with type preservation
# group: [anofox_forecast]

require anofox_forecast

require json

# Test DATE type preservation
statement ok
CREATE TABLE test_date AS
SELECT 'A' as group_col, d::DATE as date_col, v as value
FROM (VALUES
    ('2024-01-01', 10.0),
    ('2024-01-02', 20.0)
) AS t(d, v);

query III
SELECT * FROM _ts_fill_forward_native(
    (SELECT group_col, date_col, value FROM test_date ORDER BY group_col, date_col),
    '2024-01-05'::DATE,
    '1d'
);
----
A	2024-01-01	10.0
A	2024-01-02	20.0
A	2024-01-03	NULL
A	2024-01-04	NULL
A	2024-01-05	NULL

# Verify DATE type is preserved
query I
SELECT typeof(date_col) FROM _ts_fill_forward_native(
    (SELECT group_col, date_col, value FROM test_date ORDER BY group_col, date_col),
    '2024-01-05'::DATE,
    '1d'
) LIMIT 1;
----
DATE

# Test TIMESTAMP type preservation with hourly frequency
statement ok
DROP TABLE IF EXISTS test_timestamp;

statement ok
CREATE TABLE test_timestamp AS
SELECT 'B' as group_col, ts as date_col, val as value
FROM (VALUES
    ('2024-01-01 00:00:00'::TIMESTAMP, 10.0),
    ('2024-01-01 01:00:00'::TIMESTAMP, 20.0)
) AS t(ts, val);

query III
SELECT * FROM _ts_fill_forward_native(
    (SELECT group_col, date_col, value FROM test_timestamp ORDER BY group_col, date_col),
    '2024-01-01 05:00:00'::TIMESTAMP,
    '1h'
);
----
B	2024-01-01 00:00:00	10.0
B	2024-01-01 01:00:00	20.0
B	2024-01-01 02:00:00	NULL
B	2024-01-01 03:00:00	NULL
B	2024-01-01 04:00:00	NULL
B	2024-01-01 05:00:00	NULL

# Verify TIMESTAMP type is preserved
query I
SELECT typeof(date_col) FROM _ts_fill_forward_native(
    (SELECT group_col, date_col, value FROM test_timestamp ORDER BY group_col, date_col),
    '2024-01-01 05:00:00'::TIMESTAMP,
    '1h'
) LIMIT 1;
----
TIMESTAMP

# Test BIGINT with raw integer frequency
statement ok
DROP TABLE IF EXISTS test_bigint;

statement ok
CREATE TABLE test_bigint AS
SELECT 'C'::VARCHAR as group_col, ts as date_col, val as value
FROM (VALUES
    (1::BIGINT, 10.0),
    (2::BIGINT, 20.0)
) AS t(ts, val);

query III
SELECT * FROM _ts_fill_forward_native(
    (SELECT group_col, date_col, value FROM test_bigint ORDER BY group_col, date_col),
    5::BIGINT,
    '1'
);
----
C	1	10.0
C	2	20.0
C	3	NULL
C	4	NULL
C	5	NULL

# Verify BIGINT type is preserved
query I
SELECT typeof(date_col) FROM _ts_fill_forward_native(
    (SELECT group_col, date_col, value FROM test_bigint ORDER BY group_col, date_col),
    5::BIGINT,
    '1'
) LIMIT 1;
----
BIGINT

# Test multiple groups
statement ok
DROP TABLE IF EXISTS test_multi;

statement ok
CREATE TABLE test_multi AS
SELECT group_col, date_col::DATE as date_col, value FROM (VALUES
    ('G1', '2024-01-01', 10.0),
    ('G1', '2024-01-02', 20.0),
    ('G2', '2024-01-01', 100.0)
) AS t(group_col, date_col, value);

query III
SELECT * FROM _ts_fill_forward_native(
    (SELECT group_col, date_col, value FROM test_multi ORDER BY group_col, date_col),
    '2024-01-04'::DATE,
    '1d'
) ORDER BY group_col, date_col;
----
G1	2024-01-01	10.0
G1	2024-01-02	20.0
G1	2024-01-03	NULL
G1	2024-01-04	NULL
G2	2024-01-01	100.0
G2	2024-01-02	NULL
G2	2024-01-03	NULL
G2	2024-01-04	NULL

# Tombstone (Phase 18, 18-01, class A): _ts_fill_forward_native was renamed from
# ts_fill_forward_native (a public macro, auto-aliased as anofox_fcst_ts_fill_forward_native)
# to its current leading-underscore internal name in commit 4477e7b "refactor: Remove
# ts_fill_gaps_operator_by and internalize native functions". Internal (_-prefixed) table
# functions are registered directly, not through the ts_table_macros[] array, so they never
# receive the anofox_fcst_ prefixed alias that RegisterTsTableMacros() generates for public
# macros (src/macros/ts_macros.cpp:2685-2690) -- no replacement exists, by design.
statement error
SELECT * FROM anofox_fcst__ts_fill_forward_native(
    (SELECT group_col, date_col, value FROM test_date ORDER BY group_col, date_col),
    '2024-01-04'::DATE,
    '1d'
);
----
does not exist

# ==============================================================================
# Test monthly frequency with calendar-aware fill forward
# ==============================================================================

statement ok
DROP TABLE IF EXISTS test_monthly;

statement ok
CREATE TABLE test_monthly AS
SELECT 'M' as group_col, d::DATE as date_col, v as value
FROM (VALUES
    ('2023-01-15', 100.0),
    ('2023-02-15', 200.0)
) AS t(d, v);

# Monthly frequency should correctly extend using calendar dates. D-09/G24 (Phase 13
# plan 13-03): steps from the LAST OBSERVED DATE (2023-02-15), keeping its
# day-of-month (15th, not the old start-of-month snapping to the 1st) since it is
# not month-end; 2023-05-15 would exceed the 2023-05-01 target, so only Mar/Apr fill.
query III
SELECT * FROM _ts_fill_forward_native(
    (SELECT group_col, date_col, value FROM test_monthly ORDER BY group_col, date_col),
    '2023-05-01'::DATE,
    '1mo'
);
----
M	2023-01-15	100.0
M	2023-02-15	200.0
M	2023-03-15	NULL
M	2023-04-15	NULL

# Test monthly with DuckDB interval-style "1 month"
statement ok
DROP TABLE IF EXISTS test_monthly_interval;

statement ok
CREATE TABLE test_monthly_interval AS
SELECT 'N' as group_col, d::DATE as date_col, v as value
FROM (VALUES
    ('2024-10-01', 100.0)
) AS t(d, v);

query III
SELECT * FROM _ts_fill_forward_native(
    (SELECT group_col, date_col, value FROM test_monthly_interval ORDER BY group_col, date_col),
    '2025-01-01'::DATE,
    '1 month'
);
----
N	2024-10-01	100.0
N	2024-11-01	NULL
N	2024-12-01	NULL
N	2025-01-01	NULL

# ==============================================================================
# Test quarterly frequency fill forward
# ==============================================================================

statement ok
DROP TABLE IF EXISTS test_quarterly;

statement ok
CREATE TABLE test_quarterly AS
SELECT 'Q' as group_col, d::DATE as date_col, v as value
FROM (VALUES
    ('2023-01-01', 100.0)
) AS t(d, v);

# Should extend through Q4
query III
SELECT * FROM _ts_fill_forward_native(
    (SELECT group_col, date_col, value FROM test_quarterly ORDER BY group_col, date_col),
    '2023-10-01'::DATE,
    '1q'
);
----
Q	2023-01-01	100.0
Q	2023-04-01	NULL
Q	2023-07-01	NULL
Q	2023-10-01	NULL

# ==============================================================================
# Test yearly frequency fill forward
# ==============================================================================

statement ok
DROP TABLE IF EXISTS test_yearly;

statement ok
CREATE TABLE test_yearly AS
SELECT 'Y' as group_col, d::DATE as date_col, v as value
FROM (VALUES
    ('2020-06-15', 100.0)
) AS t(d, v);

# Should extend through 2023. D-09/G24: keeps the observed day-of-month (June 15th,
# not the old start-of-year snapping to Jan 1st) since 2020-06-15 is not month-end.
query III
SELECT * FROM _ts_fill_forward_native(
    (SELECT group_col, date_col, value FROM test_yearly ORDER BY group_col, date_col),
    '2023-06-15'::DATE,
    '1y'
);
----
Y	2020-06-15	100.0
Y	2021-06-15	NULL
Y	2022-06-15	NULL
Y	2023-06-15	NULL

# ==============================================================================
# Test duplicate (group, date) pair detection
# ==============================================================================

statement ok
DROP TABLE IF EXISTS dup_ff_test;

statement ok
CREATE TABLE dup_ff_test AS
SELECT 'A' as group_col, d::DATE as date_col, v as value
FROM (VALUES
    ('2024-01-01', 100.0),
    ('2024-01-01', 200.0),
    ('2024-01-03', 300.0)
) AS t(d, v);

# Should throw error on duplicate (group, date)
statement error
SELECT * FROM _ts_fill_forward_native(
    (SELECT group_col, date_col, value FROM dup_ff_test ORDER BY group_col, date_col),
    '2024-01-05'::DATE,
    '1d'
);
----
Duplicate (group, date) pair detected

statement ok
DROP TABLE dup_ff_test;

# ==============================================================================
# WR-01 (Phase 18 review): target_date digit-string that overflows int64_t must
# raise a clean DuckDB InvalidInputException naming target_date, not a leaked
# raw std::out_of_range ("Invalid Error: stoll").
# ==============================================================================

statement error
SELECT * FROM _ts_fill_forward_native(
    (SELECT group_col, date_col, value FROM test_date ORDER BY group_col, date_col),
    '99999999999999999999',
    '1d'
);
----
target_date value '99999999999999999999' is out of range for a raw integer day-offset
