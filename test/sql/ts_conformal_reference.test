# --- exactly one row per (group, forecast row): 2 groups x 3 future rows = 6 ---
query I
SELECT COUNT(*) FROM ts_conformal_by('cbt', g, ds, actual, forecast, point);
----
6

# --- A 2024-02-01: point 30.0, lower 28.095, upper 31.905 (within 1e-9) ---
query I
SELECT ABS(point - 30.0) < 1e-9 AND ABS(lower - 28.094999999999995) < 1e-9 AND ABS(upper - 31.905000000000005) < 1e-9
FROM ts_conformal_by('cbt', g, ds, actual, forecast, point) WHERE group_col = 'A' AND date_col = DATE '2024-02-01';
----
true

# --- A 2024-02-02: point 10.0, lower 8.095, upper 11.905 ---
query I
SELECT ABS(point - 10.0) < 1e-9 AND ABS(lower - 8.094999999999995) < 1e-9 AND ABS(upper - 11.905000000000005) < 1e-9
FROM ts_conformal_by('cbt', g, ds, actual, forecast, point) WHERE group_col = 'A' AND date_col = DATE '2024-02-02';
----
true

# --- A 2024-02-03: point 20.0, lower 18.095, upper 21.905 ---
query I
SELECT ABS(point - 20.0) < 1e-9 AND ABS(lower - 18.094999999999995) < 1e-9 AND ABS(upper - 21.905000000000005) < 1e-9
FROM ts_conformal_by('cbt', g, ds, actual, forecast, point) WHERE group_col = 'A' AND date_col = DATE '2024-02-03';
----
true

# --- B 2024-02-01: point 5.0, lower -14.05, upper 24.05 (non-monotonic point
# list 5, 50, 25 proves the output is NOT value-sorted, D-01/D4) ---
query I
SELECT ABS(point - 5.0) < 1e-9 AND ABS(lower - (-14.05)) < 1e-9 AND ABS(upper - 24.05) < 1e-9
FROM ts_conformal_by('cbt', g, ds, actual, forecast, point) WHERE group_col = 'B' AND date_col = DATE '2024-02-01';
----
true

# --- B 2024-02-02: point 50.0, lower 30.95, upper 69.05 ---
query I
SELECT ABS(point - 50.0) < 1e-9 AND ABS(lower - 30.95) < 1e-9 AND ABS(upper - 69.05) < 1e-9
FROM ts_conformal_by('cbt', g, ds, actual, forecast, point) WHERE group_col = 'B' AND date_col = DATE '2024-02-02';
----
true

# --- B 2024-02-03: point 25.0, lower 5.95, upper 44.05 ---
query I
SELECT ABS(point - 25.0) < 1e-9 AND ABS(lower - 5.949999999999999) < 1e-9 AND ABS(upper - 44.05) < 1e-9
FROM ts_conformal_by('cbt', g, ds, actual, forecast, point) WHERE group_col = 'B' AND date_col = DATE '2024-02-03';
----
true

# --- A conformity_score = 1.905, n_calibration = 20, method = symmetric ---
query I
SELECT ABS(conformity_score - 1.9050000000000056) < 1e-9 AND n_calibration = 20 AND method = 'symmetric'
FROM ts_conformal_by('cbt', g, ds, actual, forecast, point) WHERE group_col = 'A' LIMIT 1;
----
true

# --- B conformity_score = 19.05 ---
query I
SELECT ABS(conformity_score - 19.05) < 1e-9
FROM ts_conformal_by('cbt', g, ds, actual, forecast, point) WHERE group_col = 'B' LIMIT 1;
----
true

# --- empirical coverage 0.95 and nominal_level 0.9 for EVERY output row ---
query I
SELECT COUNT(*) = 6 AND bool_and(ABS(coverage - 0.95) < 1e-12) AND bool_and(ABS(nominal_level - 0.9) < 1e-12)
FROM ts_conformal_by('cbt', g, ds, actual, forecast, point);
----
true

# --- alpha := 0.2 via named STRUCT params gives A conformity_score 1.715 ---
query I
SELECT ABS(conformity_score - 1.7150000000000019) < 1e-9
FROM ts_conformal_by('cbt', g, ds, actual, forecast, point, params := {'alpha': 0.2}) WHERE group_col = 'A' LIMIT 1;
----
true

# --- alpha via positional MAP{'alpha': '0.2'} agrees with the STRUCT form ---
query I
SELECT ABS(conformity_score - 1.7150000000000019) < 1e-9
FROM ts_conformal_by('cbt', g, ds, actual, forecast, point, MAP{'alpha': '0.2'}) WHERE group_col = 'A' LIMIT 1;
----
true

# --- malformed alpha errors instead of silently defaulting to 0.1 ---
statement error
SELECT * FROM ts_conformal_by('cbt', g, ds, actual, forecast, point, params := {'alpha': 'abc'});
----
Could not convert

# --- unknown method raises an SQL error listing the valid names ---
statement error
SELECT * FROM ts_conformal_by('cbt', g, ds, actual, forecast, point, params := {'method': 'bogus'});
----
symmetric (alias split

# --- mismatched calibration list lengths passed directly to
# _ts_conformal_from_pairs raise an InvalidInput SQL error naming both lengths ---
statement error
SELECT _ts_conformal_from_pairs([1.0, 2.0]::DOUBLE[], [1.0]::DOUBLE[], []::DOUBLE[], 0.1, 'symmetric');
----
same length: 2 vs 1

# =============================================================================
# 16-01 ts_conformal_calibrate
# =============================================================================
#
# Reuses table `cbt` from the ts_conformal_by section above. Calibration-only
# rows (point IS NULL, actual/forecast set) and future rows (actual/forecast
# NULL) coexist in `cbt`; the NULL actual/forecast on future rows is dropped by
# Rust's complete_cases, so n_calibration stays 20 per group either way.

# --- per group (default): 2 rows, A 1.905, B 19.05 ---
query I
SELECT COUNT(*) = 2 AND bool_and(
    (group_col = 'A' AND ABS(conformity_score - 1.9050000000000056) < 1e-9) OR
    (group_col = 'B' AND ABS(conformity_score - 19.05) < 1e-9)
)
FROM ts_conformal_calibrate('cbt', g, actual, forecast);
----
true

# --- pooled STRUCT and MAP forms agree: 1 row, group_col NULL, 17.075 ---
query I
SELECT
    (SELECT conformity_score FROM ts_conformal_calibrate('cbt', g, actual, forecast, params := {'pooled': true})) =
    (SELECT conformity_score FROM ts_conformal_calibrate('cbt', g, actual, forecast, params := MAP{'pooled': 'true'}))
    AND ABS((SELECT conformity_score FROM ts_conformal_calibrate('cbt', g, actual, forecast, params := {'pooled': true})) - 17.075000000000003) < 1e-9
    AND (SELECT group_col IS NULL FROM ts_conformal_calibrate('cbt', g, actual, forecast, params := {'pooled': true}))
    AND (SELECT COUNT(*) FROM ts_conformal_calibrate('cbt', g, actual, forecast, params := {'pooled': true})) = 1;
----
true

# --- DESCRIBE: output column list in order ---
query I
SELECT STRING_AGG(column_name, ',') FROM (DESCRIBE SELECT * FROM ts_conformal_calibrate('cbt', g, actual, forecast) LIMIT 0);
----
group_col,method,conformity_score,coverage,nominal_level,n_calibration,calibration_insufficient

# --- asymmetric is rejected: two margins cannot collapse into one score ---
statement error
SELECT * FROM ts_conformal_calibrate('cbt', g, actual, forecast, params := {'method': 'asymmetric'});
----
supports methods

# =============================================================================
# 16-01 ts_conformal_apply_by
# =============================================================================

statement ok
CREATE TABLE cfut AS SELECT g, ds, point AS fc FROM cbt WHERE point IS NOT NULL;

statement ok
CREATE TABLE cal_by_group AS SELECT * FROM ts_conformal_calibrate('cbt', g, actual, forecast);

statement ok
CREATE TABLE cal_pooled AS SELECT * FROM ts_conformal_calibrate('cbt', g, actual, forecast, params := {'pooled': true});

# --- row count equals the number of non-NULL forecast rows (no row
# multiplication): 6 forecast rows in cfut, 6 rows out ---
query I
SELECT COUNT(*) FROM ts_conformal_apply_by('cfut', g, ds, fc, 'cal_by_group');
----
6

# --- per-group table: A 2024-02-01 -> [28.095, 31.905] ---
query I
SELECT ABS(lower - 28.094999999999995) < 1e-9 AND ABS(upper - 31.905000000000005) < 1e-9
FROM ts_conformal_apply_by('cfut', g, ds, fc, 'cal_by_group')
WHERE group_col = 'A' AND date_col = DATE '2024-02-01';
----
true

# --- pooled table: A 2024-02-01 -> [12.925, 47.075] (two-group pooled score) ---
query I
SELECT ABS(lower - 12.925) < 1e-9 AND ABS(upper - 47.075) < 1e-9
FROM ts_conformal_apply_by('cfut', g, ds, fc, 'cal_pooled')
WHERE group_col = 'A' AND date_col = DATE '2024-02-01';
----
true

# --- a forecast group absent from a per-group calibration table keeps its
# rows, with NULL bounds (no row dropped) ---
statement ok
CREATE TABLE cfut_extra AS SELECT * FROM cfut UNION ALL SELECT 'C', DATE '2024-02-01', 7.0;

query I
SELECT point IS NOT NULL AND lower IS NULL AND upper IS NULL
FROM ts_conformal_apply_by('cfut_extra', g, ds, fc, 'cal_by_group')
WHERE group_col = 'C';
----
true

# --- DESCRIBE: output column list in order ---
query I
SELECT STRING_AGG(column_name, ',') FROM (DESCRIBE SELECT * FROM ts_conformal_apply_by('cfut', g, ds, fc, 'cal_by_group') LIMIT 0);
----
group_col,date_col,point,lower,upper,method,conformity_score

# =============================================================================
# 16-01 ts_interval_width_by
# =============================================================================

statement ok
CREATE TABLE iw(grp VARCHAR, ds DATE, lo DOUBLE, up DOUBLE);

statement ok
INSERT INTO iw VALUES
  ('g1', DATE '2024-03-01', 1.0, NULL),
  ('g1', DATE '2024-03-02', NULL, 5.0),
