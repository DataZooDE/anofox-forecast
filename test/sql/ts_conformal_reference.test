# --- 'split', 'crossval' and 'cv' all compute the SAME scores (CrossVal
# assumes residuals already come from CV folds -- same quantile machinery) ---
query I
SELECT
    (ts_conformal_learn([1.0, -2.0, 3.0, -1.5, 2.5]::DOUBLE[], [0.2]::DOUBLE[], 'symmetric', 'split')).scores_lower
    = (ts_conformal_learn([1.0, -2.0, 3.0, -1.5, 2.5]::DOUBLE[], [0.2]::DOUBLE[], 'symmetric', 'crossval')).scores_lower
    AND (ts_conformal_learn([1.0, -2.0, 3.0, -1.5, 2.5]::DOUBLE[], [0.2]::DOUBLE[], 'symmetric', 'split')).scores_lower
    = (ts_conformal_learn([1.0, -2.0, 3.0, -1.5, 2.5]::DOUBLE[], [0.2]::DOUBLE[], 'symmetric', 'cv')).scores_lower;
----
true

