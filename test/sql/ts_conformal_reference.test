# name: test/sql/ts_conformal_reference.test
# description: Phase 16 conformal/bootstrap value assertions against
#   validation/reference/fixtures/conformal and bootstrap, plans 16-01..16-03.
# group: [sql]
#
# This file must stay free of any json-extension directive (Phase 13 lesson:
# the four conformal macros asserted here read `params` json-free via
# `params::MAP(VARCHAR, VARCHAR)` -- re-introducing a json dependency here
# would silently mask a regression back to the old json_extract_string path).
#
# Literals below are copied from validation/reference/fixtures/conformal/split_cases.json via:
#   python3 -c "import json; d=json.load(open('validation/reference/fixtures/conformal/split_cases.json')); print(d['two_group']['groups']['A']['alphas']['0.1'])"
#   python3 -c "import json; d=json.load(open('validation/reference/fixtures/conformal/split_cases.json')); print(d['two_group']['groups']['B']['alphas']['0.1'])"

require anofox_forecast

# =============================================================================
# 16-01 ts_conformal_by
# =============================================================================

statement ok
CREATE TABLE cbt(g VARCHAR, ds DATE, actual DOUBLE, forecast DOUBLE, point DOUBLE);

