statement error
SELECT ts_bootstrap_intervals(
    [1.0, -1.0, 2.0, -2.0, 0.5, -0.5, 1.5, -1.5, 0.3, -0.3]::DOUBLE[],
    [100.0, 100.0, 100.0, 100.0, 100.0, 100.0, 100.0, 100.0, 100.0, 100.0]::DOUBLE[],
    2000000, 0.9, 42
