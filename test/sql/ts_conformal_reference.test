# --- ts_bootstrap_quantiles at [0.05, 0.95] agrees with ts_bootstrap_intervals
# on the same lognormal_right residuals/seed (within the same tolerance).
# `values` is FLAT (q0_t0..q0_t4, q1_t0..q1_t4): index i for q=0.05, 5+i for
# q=0.95, with n_forecasts=5. ---
query I
SELECT bool_and(
    ABS(qt.q.values[i] - br.r.lower[i]) < 0.12 * (br.r.upper[i] - br.r.lower[i])
    AND ABS(qt.q.values[5 + i] - br.r.upper[i]) < 0.12 * (br.r.upper[i] - br.r.lower[i])
)
FROM bs_right AS br, (
    SELECT ts_bootstrap_quantiles(
        [-0.9123, -0.911, -0.7584, -0.5502, 1.2222, -0.1979, 0.3441, -0.7384, 1.8372, 1.2669,
         2.1256, 0.4689, -1.0082, -0.2756, -0.7437, -0.1443, -0.676, -0.6905, -0.6681, 0.2287,
         1.3459, 0.414, 0.9443, -1.0083, 0.0687, 0.1458, 0.6169, -1.076, -0.2902, 0.3261,
         -0.3248, -0.7844, 0.1712, -0.4579, -0.7097, -0.6372, -0.3706, -0.6975, -0.2795, 0.3279,
         0.7386, -0.5869, -0.8973, -0.4626, 0.2331, 0.05, -0.1903, -0.3913, -0.414, -0.556,
         0.1123, -0.9122, 0.1252, 5.4901, -0.3937, -0.2203, -0.2217, -0.4062, 1.6123, 0.3446
        ]::DOUBLE[],
        [100.0, 100.0, 100.0, 100.0, 100.0]::DOUBLE[],
        20000, [0.05, 0.95]::DOUBLE[], 42
    ) AS q
) AS qt, generate_series(1, 5) AS t(i);
----
true

