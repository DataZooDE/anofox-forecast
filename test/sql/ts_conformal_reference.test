true

query I
SELECT ABS((r).lower[5] - 97.1518) < 0.12 * (104.7321 - 97.1518)
    AND ABS((r).upper[5] - 104.7321) < 0.12 * (104.7321 - 97.1518)
    AND (r).upper[5] - 100.0 > 100.0 - (r).lower[5] FROM bs_right;
----
true

# --- lognormal_left step 1..5: the negated residuals, so the long tail is
# on the LOWER side at EVERY step (upper - point < point - lower) ---
query I
SELECT ABS((r).lower[1] - 98.3877) < 0.12 * (100.9123 - 98.3877)
    AND ABS((r).upper[1] - 100.9123) < 0.12 * (100.9123 - 98.3877)
    AND (r).upper[1] - 100.0 < 100.0 - (r).lower[1] FROM bs_left;
