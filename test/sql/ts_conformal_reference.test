# --- all_nan through ts_conformal_calibrate: n_calibration 0, insufficient,
# conformity_score NULL ---
statement ok
CREATE TABLE call_nan(g VARCHAR, a DOUBLE, f DOUBLE);

statement ok
INSERT INTO call_nan VALUES ('g', NULL, 100.0), ('g', NULL, 100.0), ('g', NULL, 100.0), ('g', NULL, 100.0);

