true

# --- a residual list containing 'Infinity' gives the same ts_conformal_quantile
# as the list without it (non-finite filtered, never panics) ---
query I
SELECT
    ts_conformal_quantile([1.0, 2.0, 3.0]::DOUBLE[], 0.5) =
    ts_conformal_quantile([1.0, 2.0, 3.0, 'Infinity'::DOUBLE]::DOUBLE[], 0.5);
----
true

# =============================================================================
# 16-02 asymmetric / per-step / errors (Task 2)
# =============================================================================
#
# asym_n20 residuals: [-1.0,-0.8,-0.6,-0.4,-0.2] ++ [0.25*k for k=1..15]
# (validation/reference/fixtures/conformal/asymmetric_cases.json#asym_n20).
# At alpha 0.2: lower margin 0.81, upper margin 3.5125, coverage 0.9,
# conformity_score 2.16125 -- hand-checked by the planner.

# --- ts_conformal_predict_asymmetric: forecast 100.0 -> lower 99.19, upper 103.5125, coverage 0.9 ---
query I
SELECT
    ABS((r).lower[1] - 99.19) < 1e-9 AND ABS((r).upper[1] - 103.5125) < 1e-9 AND ABS((r).coverage - 0.9) < 1e-9
FROM (
    SELECT ts_conformal_predict_asymmetric(
        [-1.0, -0.8, -0.6, -0.4, -0.2, 0.25, 0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0, 2.25, 2.5, 2.75, 3.0, 3.25, 3.5, 3.75]::DOUBLE[],
        [100.0]::DOUBLE[],
        0.2
    ) AS r
);
----
true

# --- the same through ts_conformal_by method 'asymmetric' ---
statement ok
CREATE TABLE casym(g VARCHAR, d INTEGER, a DOUBLE, f DOUBLE, p DOUBLE);

statement ok
INSERT INTO casym VALUES
  ('g', 0, 99.0, 100.0, NULL),
  ('g', 1, 99.2, 100.0, NULL),
  ('g', 2, 99.4, 100.0, NULL),
  ('g', 3, 99.6, 100.0, NULL),
  ('g', 4, 99.8, 100.0, NULL),
  ('g', 5, 100.25, 100.0, NULL),
  ('g', 6, 100.5, 100.0, NULL),
  ('g', 7, 100.75, 100.0, NULL),
  ('g', 8, 101.0, 100.0, NULL),
  ('g', 9, 101.25, 100.0, NULL),
  ('g', 10, 101.5, 100.0, NULL),
  ('g', 11, 101.75, 100.0, NULL),
  ('g', 12, 102.0, 100.0, NULL),
  ('g', 13, 102.25, 100.0, NULL),
  ('g', 14, 102.5, 100.0, NULL),
  ('g', 15, 102.75, 100.0, NULL),
  ('g', 16, 103.0, 100.0, NULL),
  ('g', 17, 103.25, 100.0, NULL),
  ('g', 18, 103.5, 100.0, NULL),
  ('g', 19, 103.75, 100.0, NULL),
  ('g', 99, NULL, NULL, 100.0);

query I
SELECT ABS(lower - 99.19) < 1e-9 AND ABS(upper - 103.5125) < 1e-9 AND ABS(coverage - 0.9) < 1e-9
    AND ABS(conformity_score - 2.16125) < 1e-9 AND NOT calibration_insufficient AND method = 'asymmetric'
FROM ts_conformal_by('casym', g, d, a, f, p, params := {'alpha': 0.2, 'method': 'asymmetric'});
----
true

# --- asym_n10 at alpha 0.1: insufficient -- NULL bounds + flag true ---
query I
SELECT (r).lower[1] IS NULL AND (r).upper[1] IS NULL AND (r).coverage IS NULL AND (r).calibration_insufficient
FROM (
    SELECT ts_conformal_predict_asymmetric(
        [2.0, 3.0, 2.5, 3.5, 4.0, -0.5, -0.3, -0.2, -0.1, 2.8]::DOUBLE[],
        [100.0]::DOUBLE[],
        0.1
    ) AS r
);
----
true

# --- per-step: 2 folds x horizon 3. alpha 0.1 -> ceil(3*0.9)=3 > 2,
# insufficient at every step (all three half_widths NULL). alpha 0.4 ->
# ceil(3*0.6)=2 <= 2, sufficient (none NULL). ---
query I
SELECT (r).half_widths[1] IS NULL AND (r).half_widths[2] IS NULL AND (r).half_widths[3] IS NULL
FROM (
    SELECT ts_conformal_predict_per_step(
        [100.0, 105.0, 110.0, 100.0, 105.0, 110.0]::DOUBLE[],
        [101.0, 108.0, 109.0, 103.0, 106.0, 107.0]::DOUBLE[],
        [100.0, 105.0, 110.0]::DOUBLE[],
        0.1, 3
    ) AS r
);
----
true

