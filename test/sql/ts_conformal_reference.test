# --- T-16-17 validation: coverage outside (0, 1), n_paths < 10, and
# n_paths * horizon > 10,000,000 each raise an SQL error naming the value ---
statement error
SELECT ts_bootstrap_intervals([1.0, -1.0, 2.0, -2.0, 0.5, -0.5, 1.5, -1.5, 0.3, -0.3]::DOUBLE[], [100.0]::DOUBLE[], 2000, 1.5, 42);
