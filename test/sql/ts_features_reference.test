# name: test/sql/ts_features_reference.test
# description: ts_features value assertions against tsfresh fixtures (Phase 14 plan 14-01, FEAT-01/FEAT-05)
# group: [sql]
#
# Non-json-gated so it runs on every native build (Phase 13 lesson, D-12).
# Literals below are copied from
# validation/reference/fixtures/tsfresh_features/short_n20.json via:
#   python3 -c "import json; d=json.load(open('validation/reference/fixtures/tsfresh_features/short_n20.json')); print(d['expected'])"
# (short_n20's values are the audit x20 vector, also used by test/sql/ts_stats_reference.test).

require anofox_forecast

# --- tsfresh_features/short_n20.json: series.values (= moments/scipy_moments.json vectors.x20) ---
statement ok
CREATE TABLE x20 AS
SELECT 'x20' AS id, DATE '2024-01-01' + INTERVAL (i) DAY AS ds, v
FROM (SELECT unnest(range(20)) AS i, unnest([
    3.337, 2.674, 2.292, 3.491, 2.217, 4.765, 3.613, 3.258, 0.928, 0.481,
    1.015, 3.755, 3.21, 0.738, 3.727, 1.651, 1.653, 6.178, 3.053, 3.501
]) AS v);

#######################################
# partial_autocorrelation_lag1..5 (D-06/FEAT-01, Durbin-Levinson)
# tsfresh (short_n20): lag1 0.026752824669788355, lag2 -0.07488582800969257,
#   lag3 -0.025999690982590442, lag4 -0.39110953857042163, lag5 0.1107535522386214
#######################################

# --- ts_features_by('x20', id, ds, v) ---

query I
SELECT abs(partial_autocorrelation_lag1 - 0.026752824669788355) <= 1e-9 + 1e-9 * abs(0.026752824669788355)
FROM ts_features_by('x20', id, ds, v);
----
true

query I
SELECT abs(partial_autocorrelation_lag2 - (-0.07488582800969257)) <= 1e-9 + 1e-9 * abs(-0.07488582800969257)
FROM ts_features_by('x20', id, ds, v);
----
true

query I
SELECT abs(partial_autocorrelation_lag3 - (-0.025999690982590442)) <= 1e-9 + 1e-9 * abs(-0.025999690982590442)
FROM ts_features_by('x20', id, ds, v);
----
true

query I
SELECT abs(partial_autocorrelation_lag4 - (-0.39110953857042163)) <= 1e-9 + 1e-9 * abs(-0.39110953857042163)
FROM ts_features_by('x20', id, ds, v);
----
true

query I
SELECT abs(partial_autocorrelation_lag5 - 0.1107535522386214) <= 1e-9 + 1e-9 * abs(0.1107535522386214)
FROM ts_features_by('x20', id, ds, v);
----
true

# --- (ts_features(ds, v)).<feature> ---

query I
SELECT abs((ts_features(ds, v)).partial_autocorrelation_lag1 - 0.026752824669788355) <= 1e-9 + 1e-9 * abs(0.026752824669788355)
FROM x20;
----
true

query I
SELECT abs((ts_features(ds, v)).partial_autocorrelation_lag2 - (-0.07488582800969257)) <= 1e-9 + 1e-9 * abs(-0.07488582800969257)
FROM x20;
----
true

query I
SELECT abs((ts_features(ds, v)).partial_autocorrelation_lag3 - (-0.025999690982590442)) <= 1e-9 + 1e-9 * abs(-0.025999690982590442)
FROM x20;
----
true

query I
SELECT abs((ts_features(ds, v)).partial_autocorrelation_lag4 - (-0.39110953857042163)) <= 1e-9 + 1e-9 * abs(-0.39110953857042163)
FROM x20;
----
true

query I
SELECT abs((ts_features(ds, v)).partial_autocorrelation_lag5 - 0.1107535522386214) <= 1e-9 + 1e-9 * abs(0.1107535522386214)
FROM x20;
----
true

# --- (ts_features_agg(ds, v)).<feature> ---

query I
SELECT abs((ts_features_agg(ds, v)).partial_autocorrelation_lag1 - 0.026752824669788355) <= 1e-9 + 1e-9 * abs(0.026752824669788355)
FROM x20;
----
true

query I
SELECT abs((ts_features_agg(ds, v)).partial_autocorrelation_lag2 - (-0.07488582800969257)) <= 1e-9 + 1e-9 * abs(-0.07488582800969257)
FROM x20;
----
true

query I
SELECT abs((ts_features_agg(ds, v)).partial_autocorrelation_lag3 - (-0.025999690982590442)) <= 1e-9 + 1e-9 * abs(-0.025999690982590442)
FROM x20;
----
true

query I
SELECT abs((ts_features_agg(ds, v)).partial_autocorrelation_lag4 - (-0.39110953857042163)) <= 1e-9 + 1e-9 * abs(-0.39110953857042163)
FROM x20;
----
true

query I
SELECT abs((ts_features_agg(ds, v)).partial_autocorrelation_lag5 - 0.1107535522386214) <= 1e-9 + 1e-9 * abs(0.1107535522386214)
FROM x20;
----
true

#######################################
# autocorrelation_lag1/lag2/lag10 + anchors mean/abs_energy (Task 3, FEAT-05
# -- tsfresh (n-lag)*var(x) denominator; autocorrelation_lag10 was previously
# absent from every SQL surface because the C++ schema came from a 10-point
# dummy series). tsfresh (short_n20): lag1 0.02675282466978834,
# lag2 -0.0741165175742436, lag10 -0.35932858466315537. Anchors:
# mean 2.7768499999999996, abs_energy 193.18060899999998 (already-matching,
# unaffected features -- proves the new column doesn't disturb the rest).
#######################################

# --- ts_features_by('x20', id, ds, v) ---

query I
SELECT abs(autocorrelation_lag1 - 0.02675282466978834) <= 1e-9 + 1e-9 * abs(0.02675282466978834)
FROM ts_features_by('x20', id, ds, v);
----
true

query I
SELECT abs(autocorrelation_lag2 - (-0.0741165175742436)) <= 1e-9 + 1e-9 * abs(-0.0741165175742436)
FROM ts_features_by('x20', id, ds, v);
----
true

query I
SELECT abs(autocorrelation_lag10 - (-0.35932858466315537)) <= 1e-9 + 1e-9 * abs(-0.35932858466315537)
FROM ts_features_by('x20', id, ds, v);
----
true

query I
SELECT abs(mean - 2.7768499999999996) <= 1e-9 + 1e-9 * abs(2.7768499999999996)
FROM ts_features_by('x20', id, ds, v);
----
true

query I
SELECT abs(abs_energy - 193.18060899999998) <= 1e-9 + 1e-9 * abs(193.18060899999998)
FROM ts_features_by('x20', id, ds, v);
----
true

# --- (ts_features(ds, v)).<feature> ---

query I
SELECT abs((ts_features(ds, v)).autocorrelation_lag1 - 0.02675282466978834) <= 1e-9 + 1e-9 * abs(0.02675282466978834)
FROM x20;
----
true

query I
SELECT abs((ts_features(ds, v)).autocorrelation_lag2 - (-0.0741165175742436)) <= 1e-9 + 1e-9 * abs(-0.0741165175742436)
FROM x20;
----
true

query I
SELECT abs((ts_features(ds, v)).autocorrelation_lag10 - (-0.35932858466315537)) <= 1e-9 + 1e-9 * abs(-0.35932858466315537)
FROM x20;
----
true

query I
SELECT abs((ts_features(ds, v)).mean - 2.7768499999999996) <= 1e-9 + 1e-9 * abs(2.7768499999999996)
FROM x20;
----
true

query I
SELECT abs((ts_features(ds, v)).abs_energy - 193.18060899999998) <= 1e-9 + 1e-9 * abs(193.18060899999998)
FROM x20;
----
true

# --- (ts_features_agg(ds, v)).<feature> ---

query I
SELECT abs((ts_features_agg(ds, v)).autocorrelation_lag1 - 0.02675282466978834) <= 1e-9 + 1e-9 * abs(0.02675282466978834)
FROM x20;
----
true

query I
SELECT abs((ts_features_agg(ds, v)).autocorrelation_lag2 - (-0.0741165175742436)) <= 1e-9 + 1e-9 * abs(-0.0741165175742436)
FROM x20;
----
true

query I
SELECT abs((ts_features_agg(ds, v)).autocorrelation_lag10 - (-0.35932858466315537)) <= 1e-9 + 1e-9 * abs(-0.35932858466315537)
FROM x20;
----
true

query I
SELECT abs((ts_features_agg(ds, v)).mean - 2.7768499999999996) <= 1e-9 + 1e-9 * abs(2.7768499999999996)
FROM x20;
----
true

query I
SELECT abs((ts_features_agg(ds, v)).abs_energy - 193.18060899999998) <= 1e-9 + 1e-9 * abs(193.18060899999998)
FROM x20;
----
true

#######################################
# last_location_of_maximum / last_location_of_minimum (Task 1, 14-02, FEAT-02):
# tsfresh (short_n20): last_location_of_maximum 0.9 (max 6.178 at 0-based index
# 17, (17+1)/20), last_location_of_minimum 0.5 (min 0.481 at 0-based index 9,
# (9+1)/20) -- previously 0.85/0.45 under the raw-index/n definition.
#######################################

# --- ts_features_by('x20', id, ds, v) ---

query I
SELECT abs(last_location_of_maximum - 0.9) <= 1e-9 + 1e-9 * abs(0.9)
FROM ts_features_by('x20', id, ds, v);
----
true

query I
SELECT abs(last_location_of_minimum - 0.5) <= 1e-9 + 1e-9 * abs(0.5)
FROM ts_features_by('x20', id, ds, v);
----
true

# --- (ts_features(ds, v)).<feature> ---

query I
SELECT abs((ts_features(ds, v)).last_location_of_maximum - 0.9) <= 1e-9 + 1e-9 * abs(0.9)
FROM x20;
----
true

query I
SELECT abs((ts_features(ds, v)).last_location_of_minimum - 0.5) <= 1e-9 + 1e-9 * abs(0.5)
FROM x20;
----
true

# --- (ts_features_agg(ds, v)).<feature> ---

query I
SELECT abs((ts_features_agg(ds, v)).last_location_of_maximum - 0.9) <= 1e-9 + 1e-9 * abs(0.9)
FROM x20;
----
true

query I
SELECT abs((ts_features_agg(ds, v)).last_location_of_minimum - 0.5) <= 1e-9 + 1e-9 * abs(0.5)
FROM x20;
----
true

