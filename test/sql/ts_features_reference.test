#######################################
# 117-feature schema assertions (D-13, FEAT-05): autocorrelation_lag10 now
# reaches every SQL surface. ts_features_by returns id + 117 feature columns
# (118 total); ts_features_agg / ts_features return 117 struct keys;
# ts_features_table returns 117 columns.
#######################################

query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM ts_features_by('x20', id, ds, v));
----
118

query I
SELECT len(struct_keys(ts_features_agg(ds, v))) FROM x20;
----
117

query I
SELECT len(struct_keys(ts_features(ds, v))) FROM x20;
----
117

query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM ts_features_table('x20', ds, v));
----
117
