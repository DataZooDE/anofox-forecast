true

query I
SELECT abs((ts_features_agg(ds, v)).variation_coefficient - (-0.7073077067644646)) <= 1e-9 + 1e-9 * abs(-0.7073077067644646)
FROM rw200;
----
true

#######################################
# fft_coefficient_0_real/1_imag/3_abs, spectral_centroid/variance (Task 1,
# 14-03, FEAT-03): rustfft one-sided rfft spectrum, numpy-rfft-exact and
# unnormalised (previously an O(n^2) naive DFT normalised by n). tsfresh
# (short_n20): fft_coefficient_0_real 55.537 (previously the mean
# 2.7768499999999996), fft_coefficient_1_imag -0.35096037761454757,
# fft_coefficient_3_abs 9.654943456108715 (previously 0.4827471728054351),
# spectral_centroid 2.740689544749791 (previously 2.016904841106497 over the
# two-sided power spectrum), spectral_variance 11.264706553070855
# (previously 22.834066212475133).
#######################################

# --- ts_features_by('x20', id, ds, v) ---

query I
SELECT abs(fft_coefficient_0_real - 55.537) <= 1e-9 + 1e-9 * abs(55.537)
FROM ts_features_by('x20', id, ds, v);
----
true

query I
