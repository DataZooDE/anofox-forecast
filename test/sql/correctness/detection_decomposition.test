# name: test/sql/correctness/detection_decomposition.test
# description: Correctness-suite value pins for seasonality/peak/changepoint detection
#   and decomposition functions fixed this milestone (WRAP-01, DET-01..07) -- Phase 18,
#   18-02, TEST-03. Not json-gated (D-02): runs on every native build. Reused, with
#   citation, from test/sql/ts_detection_reference.test (Phase 15 15-01..15-05),
#   ts_changepoints.test, ts_detrend.test, and ts_peaks.test -- almost every block below
#   is a formula-generated series (no large literal dump needed), matching those files'
#   own style.
# group: [sql]
#
# Where a fixture file IS used (scipy_peaks/cases.json plateau case), literals are
# reproduced verbatim via:
#   python3 -c "import json; d=json.load(open('validation/reference/fixtures/scipy_peaks/cases.json'))"

require anofox_forecast

# json is statically linked (Phase 18, 18-01, D-01) but not auto-loaded by the
# native unittest harness without an explicit LOAD (ts_detect_peaks_by and
# ts_mstl_decomposition_by expand to to_json(params)/json_extract_string calls
# even for an empty params MAP -- a pre-existing, documented gap, see
# ts_detection_reference.test around CR-04). It uses `require json`, which in the unittest harness
# activates the statically linked json (a plain `LOAD json;` only worked where
# json was also installed in ~/.duckdb and failed on clean CI runners). json is
# always linked into native builds since 18-01, so this never skips natively.
require json

# =============================================================================
# ts_detect_peaks (DET-01): direct port of scipy.signal.find_peaks. Plateau
# midpoint rule: a flat run of equal values reports the MIDPOINT index as the
# peak, matching scipy exactly (cited from ts_detection_reference.test 15-02).
# =============================================================================

query I
SELECT list_transform((ts_detect_peaks([0, 1, 1, 1, 0, 2, 2, 0, 3, 3, 3, 3, 1, 0]::DOUBLE[])).peaks, lambda p: p.index);
----
[2, 5, 9]

# =============================================================================
# ts_detect_peaks_by (grouped macro): parity with the scalar ts_detect_peaks
# on the same plateau series.
# =============================================================================

statement ok
CREATE TABLE peaks_plateau AS
SELECT 'g' AS id, DATE '2024-01-01' + INTERVAL (i) DAY AS ds, v
FROM (SELECT unnest(range(14)) AS i, unnest([0, 1, 1, 1, 0, 2, 2, 0, 3, 3, 3, 3, 1, 0]::DOUBLE[]) AS v);

query I
SELECT list_transform(peaks, lambda p: p.index) FROM ts_detect_peaks_by('peaks_plateau', id, ds, v, MAP{});
----
[2, 5, 9]

statement ok
DROP TABLE peaks_plateau;

# =============================================================================
# ts_analyze_peak_timing / ts_detect_seasonality_changes / ts_detect_amplitude_
# modulation (DET-07 error unification, WR-03/CR-05/CR-06): a non-finite or
# non-positive period raises the SAME message across all three functions
# (cited from ts_detection_reference.test 15-05).
# =============================================================================

statement error
SELECT ts_detect_seasonality_changes(
    list_transform(range(120), lambda i: (10 + 5 * sin(2 * pi() * i / 12))::DOUBLE), 'nan'::DOUBLE
);
----
Period must be a positive finite number

statement error
SELECT ts_detect_amplitude_modulation(
    list_transform(range(120), lambda i: (10 + 5 * sin(2 * pi() * i / 12))::DOUBLE), 0.0
);
----
Period must be a positive finite number

statement error
SELECT ts_analyze_peak_timing(
    list_transform(range(120), lambda i: (10 + 5 * sin(2 * pi() * i / 12))::DOUBLE), '-inf'::DOUBLE
);
----
Period must be a positive finite number

# Functional (non-error) values on a noise-free period-12 sine -- locked-in
# regression values (deterministic for this exact synthetic input).
query I
SELECT (ts_detect_seasonality_changes(list_transform(range(120), lambda i: (10 + 5 * sin(2 * pi() * i / 12))::DOUBLE), 12.0)).n_changes = 1;
----
true

query I
SELECT (ts_analyze_peak_timing(list_transform(range(120), lambda i: (10 + 5 * sin(2 * pi() * i / 12))::DOUBLE), 12.0)).n_peaks = 10;
----
true

# amplitude modulation: growing amplitude -> emerging, constant -> stable.
query I
SELECT (ts_detect_amplitude_modulation(list_transform(range(240), lambda i: (1 + i / 30.0) * sin(2 * pi() * i / 12)), 12.0)).modulation_type;
----
emerging

query I
SELECT (ts_detect_amplitude_modulation(list_transform(range(240), lambda i: sin(2 * pi() * i / 12)), 12.0)).modulation_type;
----
stable

# =============================================================================
# ts_detect_changepoints (scalar PELT-family table function) / ts_detect_
# changepoints_agg (DET-02): a clean 2-level step at index 5 is flagged
# exactly there and nowhere else.
# =============================================================================

statement ok
CREATE TABLE changepoint_test AS
SELECT ('2023-01-01'::DATE + (i || ' day')::INTERVAL)::TIMESTAMP AS date,
       CASE WHEN i < 5 THEN 1.0 ELSE 10.0 END AS val
FROM generate_series(0, 9) AS t(i);

query I
SELECT list(is_changepoint ORDER BY date_col)
FROM ts_detect_changepoints('changepoint_test', date, val, MAP(['hazard_lambda'], ['250.0']));
----
[false, false, false, false, false, true, false, false, false, false]

query I
SELECT list_transform((SELECT ts_detect_changepoints_agg(ts, v, MAP([], [])) FROM (
    SELECT date AS ts, val AS v FROM changepoint_test
)), lambda s: s.is_changepoint);
----
[false, false, false, false, false, true, false, false, false, false]

statement ok
DROP TABLE changepoint_test;

# _ts_detect_changepoints_bocpd (DET-02, D-06): Adams & MacKay (2007) BOCPD.
# issue-71 step ([100]*12 + [10]*12, hazard 250): flags index 12 (cited from
# ts_detection_reference.test 15-03).

query I
SELECT (_ts_detect_changepoints_bocpd([100.0, 100.0, 100.0, 100.0, 100.0, 100.0, 100.0, 100.0, 100.0, 100.0, 100.0, 100.0, 10.0, 10.0, 10.0, 10.0, 10.0, 10.0, 10.0, 10.0, 10.0, 10.0, 10.0, 10.0]::DOUBLE[], 250.0, true)).changepoint_indices
     = [12]::UBIGINT[];
----
true

# =============================================================================
# #287 raw-path byte-identity pins (Phase 20, 20-03, T-20-08).
# Captured on the pre-Phase-20-changepoint build (commit 21dfe7e, DuckDB v2.0.0).
# Until #287 these were the DEFAULT outputs. The default is now
# deseasonalize 'auto' (seasonal series are deseasonalized first; see the
# block below), so the pins run with deseasonalize 'false', which must still
# reproduce the pre-Phase-20 outputs byte for byte. The md5 covers id, date,
# is_changepoint and the probability of every row rounded to 9 decimals: the
# full-precision text differed in its last digits on the CI runners (sin/cos in the
# fixture and libm/FMA differences across CPUs), so the full-precision pin only held
# on the capturing machine. The rounded md5s were computed on a build whose
# full-precision md5s still matched the captured pre-Phase-20 values
# (40b71f3f.../30e6fc73...), so they pin the same outputs.
# #287 panel: 3 series x 84 days, weekly seasonality, B +15 from day 50 (2024-02-20).
# =============================================================================

statement ok
CREATE TABLE cp287 AS SELECT id, (TIMESTAMP '2024-01-01' + INTERVAL (i) DAY) AS ds, base + 0.3 * i + 5 * sin(2 * pi() * i / 7) + CASE WHEN id = 'B' AND i >= 50 THEN 15 ELSE 0 END + 1.6 * cos(i * 0.9) + 0.7 * sin(i * 1.7 + base) AS y FROM (VALUES ('A', 20.0), ('B', 40.0), ('C', 60.0)) t(id, base), range(84) r(i);

query I
SELECT md5(string_agg(id || '|' || ds || '|' || is_changepoint || '|' || round(changepoint_probability, 9)::VARCHAR, ',' ORDER BY id, ds)) FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{'deseasonalize': 'false'});
----
083042b082bc53142e3232b612736daf

query I
SELECT md5(string_agg(id || '|' || ds || '|' || is_changepoint || '|' || round(changepoint_probability, 9)::VARCHAR, ',' ORDER BY id, ds)) FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{'hazard_lambda': '50', 'deseasonalize': 'false'});
----
d8674561e9f706fa44a924abacd94e87

query I
SELECT md5(string_agg(id || '|' || r.timestamp || '|' || r.is_changepoint || '|' || round(r.changepoint_probability, 9)::VARCHAR, ',' ORDER BY id, r.timestamp)) FROM (SELECT id, unnest(ts_detect_changepoints_agg(ds, y, MAP{'deseasonalize': 'false'})) AS r FROM cp287 GROUP BY id);
----
083042b082bc53142e3232b612736daf

# Readable form of the same raw-path outputs: flagged dates per series.

query II
SELECT id, string_agg(ds::DATE::VARCHAR, ',' ORDER BY ds) FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{'deseasonalize': 'false'}) WHERE is_changepoint GROUP BY id ORDER BY id;
----
A	2024-01-22,2024-01-29,2024-02-05,2024-02-12,2024-02-19,2024-02-26
B	2024-01-29,2024-02-20
C	2024-01-22,2024-01-29,2024-02-05,2024-02-12,2024-02-19,2024-02-26

query II
SELECT id, string_agg(r.timestamp::DATE::VARCHAR, ',' ORDER BY r.timestamp) FROM (SELECT id, unnest(ts_detect_changepoints_agg(ds, y, MAP{'deseasonalize': 'false'})) AS r FROM cp287 GROUP BY id) WHERE r.is_changepoint GROUP BY id ORDER BY id;
----
A	2024-01-22,2024-01-29,2024-02-05,2024-02-12,2024-02-19,2024-02-26
B	2024-01-29,2024-02-20
C	2024-01-22,2024-01-29,2024-02-05,2024-02-12,2024-02-19,2024-02-26

query I
SELECT round(max(changepoint_probability), 3) FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{'deseasonalize': 'false'});
----
0.996

# #287 default: deseasonalize 'auto'. All three series are clearly weekly
# (STL strength >= 0.5 at period 7), so they are deseasonalized first and only
# B's real level shift on 2024-02-20 is flagged, on both surfaces. 'auto' given
# explicitly is the same as the default.

query II
SELECT id, string_agg(ds::DATE::VARCHAR, ',' ORDER BY ds) FILTER (is_changepoint) FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{}) GROUP BY id ORDER BY id;
----
A	NULL
B	2024-02-20
C	NULL

query II
SELECT id, string_agg(r.timestamp::DATE::VARCHAR, ',' ORDER BY r.timestamp) FILTER (r.is_changepoint) FROM (SELECT id, unnest(ts_detect_changepoints_agg(ds, y, MAP{})) AS r FROM cp287 GROUP BY id) GROUP BY id ORDER BY id;
----
A	NULL
B	2024-02-20
C	NULL

query I
SELECT count(*) FROM (
    SELECT id, ds, is_changepoint, changepoint_probability FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{})
    EXCEPT ALL
    SELECT id, ds, is_changepoint, changepoint_probability FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{'deseasonalize': 'auto'})
);
----
0

statement error
SELECT count(*) FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{'deseasonalize': 'maybe'});
----
must be true/false/1/0/auto

# #287 agg/table parity (BUG-06): ts_detect_changepoints_agg previously
# ignored its params MAP entirely (hazard_lambda stayed 250 regardless of
# what was passed -- 20-RESEARCH.md probe: agg with MAP{'hazard_lambda':
# '50'} and MAP{} both gave A 6 / B 2 / C 6 flagged). It now shares
# ParseChangepointParamSet with ts_detect_changepoints_by (Phase 20 20-06),
# so identical params give byte-identical rows on both surfaces for both
# the default (MAP{}) and a non-default hazard_lambda.

query I
SELECT count(*) FROM (
    SELECT id, ds, is_changepoint, changepoint_probability FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{})
    EXCEPT ALL
    SELECT id, r.timestamp, r.is_changepoint, r.changepoint_probability FROM (SELECT id, unnest(ts_detect_changepoints_agg(ds, y, MAP{})) AS r FROM cp287 GROUP BY id)
);
----
0

query I
SELECT count(*) FROM (
    SELECT id, r.timestamp, r.is_changepoint, r.changepoint_probability FROM (SELECT id, unnest(ts_detect_changepoints_agg(ds, y, MAP{})) AS r FROM cp287 GROUP BY id)
    EXCEPT ALL
    SELECT id, ds, is_changepoint, changepoint_probability FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{})
);
----
0

query I
SELECT count(*) FROM (
    SELECT id, ds, is_changepoint, changepoint_probability FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{'hazard_lambda': '50'})
    EXCEPT ALL
    SELECT id, r.timestamp, r.is_changepoint, r.changepoint_probability FROM (SELECT id, unnest(ts_detect_changepoints_agg(ds, y, MAP{'hazard_lambda': '50'})) AS r FROM cp287 GROUP BY id)
);
----
0

query I
SELECT count(*) FROM (
    SELECT id, r.timestamp, r.is_changepoint, r.changepoint_probability FROM (SELECT id, unnest(ts_detect_changepoints_agg(ds, y, MAP{'hazard_lambda': '50'})) AS r FROM cp287 GROUP BY id)
    EXCEPT ALL
    SELECT id, ds, is_changepoint, changepoint_probability FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{'hazard_lambda': '50'})
);
----
0

# Aggregate honours hazard_lambda: flagged count per id with hazard_lambda 50
# on the raw series is 8/6/6 (previously ignored -> 6/2/6, per the
# 20-RESEARCH.md probe above). deseasonalize 'false' keeps the raw path that
# was pinned here before the #287 'auto' default.
query I
SELECT string_agg(id || ':' || cnt, ',' ORDER BY id) FROM (
    SELECT id, count(*) FILTER (WHERE r.is_changepoint) AS cnt
    FROM (SELECT id, unnest(ts_detect_changepoints_agg(ds, y, MAP{'hazard_lambda': '50', 'deseasonalize': 'false'})) AS r FROM cp287 GROUP BY id)
    GROUP BY id
);
----
A:8,B:6,C:6

# The aggregate's hazard_lambda=50 output differs from its MAP{} default,
# proving the param is no longer ignored (previously identical).
query I
SELECT (
    SELECT string_agg(id || '|' || r.timestamp || '|' || r.is_changepoint || '|' || r.changepoint_probability::VARCHAR, ',' ORDER BY id, r.timestamp)
    FROM (SELECT id, unnest(ts_detect_changepoints_agg(ds, y, MAP{'hazard_lambda': '50', 'deseasonalize': 'false'})) AS r FROM cp287 GROUP BY id)
) <> (
    SELECT string_agg(id || '|' || r.timestamp || '|' || r.is_changepoint || '|' || r.changepoint_probability::VARCHAR, ',' ORDER BY id, r.timestamp)
    FROM (SELECT id, unnest(ts_detect_changepoints_agg(ds, y, MAP{'deseasonalize': 'false'})) AS r FROM cp287 GROUP BY id)
);
----
true

# =============================================================================
# #287 threshold (BUG-06, D2-ii) and BUG-07 period regression pins (Phase 20
# plan 20-06 Task 3). D2-ii: with a threshold set, is_changepoint =
# (changepoint_probability >= threshold) for every row AFTER THE FIRST of
# each series; the first row is never flagged. These numbers are also pinned
# against an independent numpy BOCPD reference in
# crates/anofox-fcst-core/tests/changepoint_reference.rs
# (bocpd_with_options_threshold_matches_numpy_expected_threshold_0_5, cases
# issue287_A/B/C in validation/reference/fixtures/changepoints/bocpd_cases.json).
# =============================================================================

# Consistency: every row after the first obeys is_changepoint ==
# (changepoint_probability >= threshold), and no first row is ever flagged --
# on both surfaces.

query I
SELECT count(*) FROM (
    SELECT id, ds, is_changepoint, changepoint_probability,
           row_number() OVER (PARTITION BY id ORDER BY ds) AS rn
    FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{'threshold': '0.5'})
) WHERE rn > 1 AND is_changepoint <> (changepoint_probability >= 0.5);
----
0

query I
SELECT count(*) FROM (
    SELECT id, ds, is_changepoint,
           row_number() OVER (PARTITION BY id ORDER BY ds) AS rn
    FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{'threshold': '0.5'})
) WHERE rn = 1 AND is_changepoint;
----
0

query I
SELECT count(*) FROM (
    SELECT id, r.timestamp, r.is_changepoint, r.changepoint_probability,
           row_number() OVER (PARTITION BY id ORDER BY r.timestamp) AS rn
    FROM (SELECT id, unnest(ts_detect_changepoints_agg(ds, y, MAP{'threshold': '0.5'})) AS r FROM cp287 GROUP BY id)
) WHERE rn > 1 AND is_changepoint <> (changepoint_probability >= 0.5);
----
0

query I
SELECT count(*) FROM (
    SELECT id, r.timestamp, r.is_changepoint,
           row_number() OVER (PARTITION BY id ORDER BY r.timestamp) AS rn
    FROM (SELECT id, unnest(ts_detect_changepoints_agg(ds, y, MAP{'threshold': '0.5'})) AS r FROM cp287 GROUP BY id)
) WHERE rn = 1 AND is_changepoint;
----
0

# Readable form: threshold 0.5 flags exactly B's 2024-02-20 and nothing else
# (A and C have no flagged rows at all, so they produce no group here).

query II
SELECT id, string_agg(ds::DATE::VARCHAR, ',' ORDER BY ds) FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{'threshold': '0.5'}) WHERE is_changepoint GROUP BY id ORDER BY id;
----
B	2024-02-20

# Parity (threshold combined with a non-default hazard_lambda): table
# function and aggregate still agree exactly.

query I
SELECT count(*) FROM (
    SELECT id, ds, is_changepoint, changepoint_probability FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{'threshold': '0.5', 'hazard_lambda': '50'})
    EXCEPT ALL
    SELECT id, r.timestamp, r.is_changepoint, r.changepoint_probability FROM (SELECT id, unnest(ts_detect_changepoints_agg(ds, y, MAP{'threshold': '0.5', 'hazard_lambda': '50'})) AS r FROM cp287 GROUP BY id)
);
----
0

query I
SELECT count(*) FROM (
    SELECT id, r.timestamp, r.is_changepoint, r.changepoint_probability FROM (SELECT id, unnest(ts_detect_changepoints_agg(ds, y, MAP{'threshold': '0.5', 'hazard_lambda': '50'})) AS r FROM cp287 GROUP BY id)
    EXCEPT ALL
    SELECT id, ds, is_changepoint, changepoint_probability FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{'threshold': '0.5', 'hazard_lambda': '50'})
);
----
0

# A threshold outside [0, 1] errors naming the key, on both surfaces.

statement error
SELECT count(*) FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{'threshold': '1.5'});
----
threshold

statement error
SELECT count(*) FROM (SELECT unnest(ts_detect_changepoints_agg(ds, y, MAP{'threshold': '1.5'})) FROM cp287 GROUP BY id);
----
threshold

# BUG-07 (#287 release-only symptom, already fixed on main): ts_detect_
# periods_by returns primary_period 7.0 (the weekly seasonality every #287
# series shares) for A, B and C -- regression pin.

query III
SELECT id, primary_period, periods[1].period FROM ts_detect_periods_by('cp287', id, ds, y, MAP{}) ORDER BY id;
----
A	7.0	7.0
B	7.0	7.0
C	7.0	7.0

# =============================================================================
# #287 deseasonalize (BUG-05, D1-b, Phase 20 plan 20-07 Task 2). deseasonalize
# removes the STL seasonal component AND a straight-line trend before BOCPD
# (mstl_fit + detrend_linear in deseasonalize_for_changepoints), so a level
# shift still survives as a step while regular weekly cycles stop producing
# changepoints. Opt-in only -- CONTEXT Deferred Ideas: making this the
# default is out of scope and must not happen. The transform itself is
# pinned against R forecast::mstl's own seasonal component in
# crates/anofox-fcst-core/tests/changepoint_reference.rs
# (deseasonalize_for_changepoints_matches_r_mstl_seasonal_for_issue287, cases
# issue287_A/B/C in validation/reference/fixtures/r_decomposition/cases.json).
# =============================================================================

# The #287 acceptance: deseasonalize combined with threshold 0.5 flags
# nothing on A/C and exactly B's 2024-02-20 shift, on both surfaces.

query II
SELECT id, coalesce(string_agg(ds::DATE::VARCHAR, ',' ORDER BY ds) FILTER (WHERE is_changepoint), 'none')
FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{'deseasonalize': 'true', 'threshold': '0.5'})
GROUP BY id ORDER BY id;
----
A	none
B	2024-02-20
C	none

query II
SELECT id, coalesce(string_agg(r.timestamp::DATE::VARCHAR, ',' ORDER BY r.timestamp) FILTER (WHERE r.is_changepoint), 'none')
FROM (SELECT id, unnest(ts_detect_changepoints_agg(ds, y, MAP{'deseasonalize': 'true', 'threshold': '0.5'})) AS r FROM cp287 GROUP BY id)
GROUP BY id ORDER BY id;
----
A	none
B	2024-02-20
C	none

# Parity: table function and aggregate agree exactly row for row with
# deseasonalize+threshold combined, both directions.

query I
SELECT count(*) FROM (
    SELECT id, ds, is_changepoint, changepoint_probability FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{'deseasonalize': 'true', 'threshold': '0.5'})
    EXCEPT ALL
    SELECT id, r.timestamp, r.is_changepoint, r.changepoint_probability FROM (SELECT id, unnest(ts_detect_changepoints_agg(ds, y, MAP{'deseasonalize': 'true', 'threshold': '0.5'})) AS r FROM cp287 GROUP BY id)
);
----
0

query I
SELECT count(*) FROM (
    SELECT id, r.timestamp, r.is_changepoint, r.changepoint_probability FROM (SELECT id, unnest(ts_detect_changepoints_agg(ds, y, MAP{'deseasonalize': 'true', 'threshold': '0.5'})) AS r FROM cp287 GROUP BY id)
    EXCEPT ALL
    SELECT id, ds, is_changepoint, changepoint_probability FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{'deseasonalize': 'true', 'threshold': '0.5'})
);
----
0

# deseasonalize alone (threshold unset) now defaults the EFFECTIVE
# threshold to 0.5 (code review CR-02, user decision 2026-10-24) instead of
# falling back to the MAP run-length-reset heuristic -- the heuristic
# flagged B's weekly troughs in addition to the real 2024-02-20 shift once
# the dominant seasonal variance was removed (robust_noise_scale collapse).
# deseasonalize alone must therefore match deseasonalize+threshold=0.5
# exactly: nothing on A/C, only B's 2024-02-20 shift.

query II
SELECT id, coalesce(string_agg(ds::DATE::VARCHAR, ',' ORDER BY ds) FILTER (WHERE is_changepoint), 'none')
FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{'deseasonalize': 'true'})
GROUP BY id ORDER BY id;
----
A	none
B	2024-02-20
C	none

query I
SELECT count(*) FROM (
    SELECT id, ds, is_changepoint, changepoint_probability FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{'deseasonalize': 'true'})
    EXCEPT ALL
    SELECT id, ds, is_changepoint, changepoint_probability FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{'deseasonalize': 'true', 'threshold': '0.5'})
);
----
0

# seasonal_period '7' given explicitly gives the same result as the
# auto-detected period (7, pinned by the BUG-07 block below) on the #287
# panel.

query I
SELECT count(*) FROM (
    SELECT id, ds, is_changepoint, changepoint_probability FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{'deseasonalize': 'true', 'threshold': '0.5', 'seasonal_period': '7'})
    EXCEPT ALL
    SELECT id, ds, is_changepoint, changepoint_probability FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{'deseasonalize': 'true', 'threshold': '0.5'})
);
----
0

# Default (no deseasonalize key) is 'auto' since #287: on this clearly
# seasonal panel it equals deseasonalize 'true' row for row. The raw path
# ('false') keeps its pre-BUG-05 outputs (md5 pins near the top of this file).

query I
SELECT count(*) FROM (
    SELECT id, ds, is_changepoint, changepoint_probability FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{})
    EXCEPT ALL
    SELECT id, ds, is_changepoint, changepoint_probability FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{'deseasonalize': 'true'})
);
----
0

# deseasonalize/seasonal_period are strict and error naming the key, on
# both surfaces.

statement error
SELECT count(*) FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{'deseasonalize': 'yes'});
----
deseasonalize

statement error
SELECT count(*) FROM (SELECT unnest(ts_detect_changepoints_agg(ds, y, MAP{'deseasonalize': 'yes'})) FROM cp287 GROUP BY id);
----
deseasonalize

statement error
SELECT count(*) FROM ts_detect_changepoints_by('cp287', id, ds, y, MAP{'seasonal_period': '-1', 'deseasonalize': 'true'});
----
seasonal_period

statement error
SELECT count(*) FROM (SELECT unnest(ts_detect_changepoints_agg(ds, y, MAP{'seasonal_period': '-1', 'deseasonalize': 'true'})) FROM cp287 GROUP BY id);
----
seasonal_period

statement ok
DROP TABLE cp287;

# =============================================================================
# ts_decompose_seasonal / _ts_mstl_decomposition / ts_mstl_decomposition_by
# (DET-04): additive identity trend+seasonal+remainder == input; constant
# series decomposes to trend==input, seasonal==0 (cited from 15-01/15-04).
# =============================================================================

query I
SELECT max(abs(tr + se + re - v)) <= 1e-10
FROM (
    SELECT unnest(tr_list) AS tr, unnest(se_list) AS se, unnest(re_list) AS re, unnest(v_list) AS v
    FROM (
        SELECT
            (ts_decompose_seasonal(list_transform(range(120), lambda i: (10 + 0.1 * i + 3 * sin(2 * pi() * i / 12))::DOUBLE), 12.0)).trend AS tr_list,
            (ts_decompose_seasonal(list_transform(range(120), lambda i: (10 + 0.1 * i + 3 * sin(2 * pi() * i / 12))::DOUBLE), 12.0)).seasonal AS se_list,
            (ts_decompose_seasonal(list_transform(range(120), lambda i: (10 + 0.1 * i + 3 * sin(2 * pi() * i / 12))::DOUBLE), 12.0)).remainder AS re_list,
            list_transform(range(120), lambda i: (10 + 0.1 * i + 3 * sin(2 * pi() * i / 12))::DOUBLE) AS v_list
    )
);
----
true

query I
SELECT max(abs(t - 1.0)) <= 1e-12
FROM (SELECT unnest((_ts_mstl_decomposition(list_transform(range(48), lambda i: 1.0), 'fail', [12])).trend) AS t);
----
true

statement ok
CREATE TABLE mstlc AS SELECT 'g' AS id, DATE '2024-01-01' + INTERVAL (i) DAY AS ds, 1.0 AS v FROM range(48) t(i);

query I
SELECT max(abs(t - 1.0)) < 1e-6
FROM (SELECT unnest(trend) AS t FROM ts_mstl_decomposition_by('mstlc', id, ds, v, MAP{'seasonal_periods':'[12]'}));
----
true

query I
SELECT max(abs(s)) < 1e-6
FROM (SELECT unnest(flatten(seasonal)) AS s FROM ts_mstl_decomposition_by('mstlc', id, ds, v, MAP{'seasonal_periods':'[12]'}));
----
true

statement ok
DROP TABLE mstlc;

# =============================================================================
# ts_classify_seasonality / ts_classify_seasonality_by (WRAP-01): a strong
# noise-free sine classifies stable_seasonal / is_seasonal / strength >= 0.99;
# deterministic non-periodic noise does not (cited from 15-01).
# =============================================================================

statement ok
CREATE TABLE sine120 AS
SELECT 'g1' AS id, DATE '2024-01-01' + INTERVAL (i) DAY AS ds, (10 + 5 * sin(2 * pi() * i / 12))::DOUBLE AS v
FROM range(120) t(i);

query III
SELECT is_seasonal, timing_classification, seasonal_strength >= 0.99
FROM ts_classify_seasonality_by('sine120', id, ds, v, 12.0);
----
true	stable_seasonal	true

query I
SELECT (ts_classify_seasonality(list_transform(range(120), lambda i: ((i * 7919) % 101) / 101.0 - 0.5), 12.0)).is_seasonal;
----
false

statement ok
DROP TABLE sine120;

# =============================================================================
# #286 (BUG-04): classify_seasonality's seasonal_strength must come from the
# SAME STL strength ts_stats_by uses, not fdars's own raw-series strength --
# the two used to disagree (0.156 vs 0.966) on this exact series/period.
# Values below are the literals the built extension prints; a strong weekly
# series must classify stable_seasonal/is_seasonal with cycle_strengths
# consistent with the overall strength (no 0.16-vs-1.0 contradiction), and
# the scalar/aggregate/table-macro surfaces must all agree exactly.
# =============================================================================

statement ok
CREATE TABLE w AS
SELECT 'A' AS id, (TIMESTAMP '2024-01-01' + INTERVAL (i) DAY) AS ds,
       20 + 0.3 * i + 5 * sin(2 * pi() * i / 7) + 1.6 * cos(i * 0.9) + 0.7 * sin(i * 1.7 + 20) AS y
FROM range(84) r(i);

query IIIII
SELECT timing_classification, modulation_type <> 'non_seasonal', is_seasonal,
       round(seasonal_strength, 10), list_min(cycle_strengths) >= 0.3
FROM ts_classify_seasonality_by('w', id, ds, y, 7.0);
----
stable_seasonal	true	true	0.986881091	true

query I
SELECT abs(
    (SELECT seasonal_strength FROM ts_classify_seasonality_by('w', id, ds, y, 7.0)) -
    (SELECT seasonality_strength FROM ts_stats_by('w', id, ds, y, '1d', seasonal_period := 7))
) < 1e-12;
----
true

query I
SELECT round((ts_classify_seasonality(list(y ORDER BY ds), 7.0)).seasonal_strength, 10) FROM w;
----
0.986881091

query I
SELECT round((ts_classify_seasonality_agg(ds, y, 7.0)).seasonal_strength, 10) FROM w;
----
0.986881091

statement ok
DROP TABLE w;

statement ok
CREATE TABLE issue286_constant AS
SELECT 'A' AS id, (TIMESTAMP '2024-01-01' + INTERVAL (i) DAY) AS ds, 5.0 AS y
FROM range(84) r(i);

query II
SELECT is_seasonal, seasonal_strength IS NULL
FROM ts_classify_seasonality_by('issue286_constant', id, ds, y, 7.0);
----
false	true

statement ok
DROP TABLE issue286_constant;

# =============================================================================
# ts_detect_seasonality / ts_analyze_seasonality: a clean period-4 square wave
# is detected as period 4.
# =============================================================================

query I
SELECT list_contains(ts_detect_seasonality(list_transform(range(32), lambda i: (i % 4)::DOUBLE)), 4);
----
true

query I
SELECT (ts_analyze_seasonality(list_transform(range(32), lambda i: (i % 4)::DOUBLE))) IS NOT NULL;
----
true

# =============================================================================
# ts_seasonal_strength / ts_seasonal_strength_windowed (D-11/G19): linearly
# detrending first makes a trend+seasonal series measure strongly seasonal
# (cited from 15-05); 'wavelet' is a removed method (always errors).
# =============================================================================

query I
SELECT ts_seasonal_strength(
    list_transform(range(120), lambda t: 0.5 * t + 2 * sin(2 * pi() * t / 12)), 12.0
) >= 0.95;
----
true

statement error
SELECT ts_seasonal_strength_windowed(
    list_transform(range(120), lambda t: 0.5 * t + 2 * sin(2 * pi() * t / 12)), 12.0, 24.0, 'wavelet'
);
----
removed

# =============================================================================
# Period estimators (DET-05/DET-06): FFT/ACF/regression/autoperiod on a
# noise-free period-12 series, each pinned to its own exact/near value (cited
# from 15-05).
# =============================================================================

query I
SELECT (ts_estimate_period_fft(
    list_transform(range(120), lambda t: 0.5 * t + 2 * sin(2 * pi() * t / 12))
)).period;
----
12.0

query I
SELECT (ts_estimate_period_acf(
    list_transform(range(40), lambda i: CASE WHEN i % 2 = 0 THEN 1.0 ELSE -1.0 END)
)).period;
----
2.0

query I
SELECT (_ts_detect_periods(
    list_transform(range(120), lambda t: sin(2 * pi() * t / 12)),
    'regression'
)).primary_period;
----
12.0

query I
SELECT (_ts_detect_periods(
    list_transform(range(120), lambda t: 0.5 * t + 2 * sin(2 * pi() * t / 12)),
    'fft'
)).primary_period;
----
12.0

# =============================================================================
# ts_detect_periods / ts_detect_periods_by table macros (DET-01 gap closure,
# 18-06): the default call (params := MAP{}, no expected_periods) used to
# return an all-NULL row -- known since Phase 10 (10-06/10-08 SUMMARY),
# worked around in docs via ts_detect_periods_agg, never fixed. Root cause:
# the macros always call the 6-arg _ts_detect_periods overload, and their
# default-case expected_periods extraction (json_extract(...) CAST to
# DOUBLE[], which is NULL when the key is absent) hit DuckDB's default null
# handling, short-circuiting the whole row to NULL before the function body
# (which already treats a NULL expected_periods as "not provided") ever ran.
# Fixed via FunctionNullHandling::SPECIAL_HANDLING on the 5-arg/6-arg
# _ts_detect_periods overloads (same bug class as the Phase 17 WR-01
# ts_ljung_box fix, commit 6ceea19). A second, independent macro bug was
# found and fixed alongside it: expected_periods was extracted with
# json_extract (returns a quoted JSON scalar, "[12.0]", which cannot CAST to
# DOUBLE[]) instead of json_extract_string (returns the unquoted string
# DuckDB parses as a list literal) -- meaning the expected_periods path was
# never reachable via the MAP params form at all, not even before DET-01.
# primary_period = 12.0 is the closed-form period of this noise-free
# period-12 sinusoid, matching the identical _ts_detect_periods 'fft' pin
# directly above (same functional root, now reachable through the macro).
# =============================================================================

statement ok
CREATE TABLE det01_periods AS
SELECT 'a' AS g, DATE '2020-01-01' + INTERVAL (i) DAY AS ds, sin(2 * pi() * i / 12) + 0.01 * i AS y
FROM range(96) t(i);

# Default case (grouped macro): previously an all-NULL row.
query I
SELECT primary_period FROM ts_detect_periods_by('det01_periods', g, ds, y, MAP{});
----
12.0

# Default case (single-series macro): previously an all-NULL row.
query I
SELECT primary_period FROM ts_detect_periods('det01_periods', ds, y, MAP{});
----
12.0

# expected_periods path: matches_expected / matched_expected_period populated
# (closed-form: 12.0 is the series' true period, so it matches exactly).
query II
SELECT (periods[1]).matches_expected, (periods[1]).matched_expected_period
FROM ts_detect_periods_by('det01_periods', g, ds, y, MAP{'expected_periods': '[12.0]'});
----
true	12.0

# ts_detect_periods_agg: the GROUP BY aggregate form, documented as the
# alternative to the table macros above (18-06). Same closed-form 12.0 on the
# same fixture, proving the two surfaces agree.
query I
SELECT ts_detect_periods_agg(ds, y, 'fft').primary_period FROM det01_periods GROUP BY g;
----
12.0

statement ok
DROP TABLE det01_periods;

# A NULL series (single-row group, value trims to empty) still yields a NULL
# row through the table macro -- the SPECIAL_HANDLING fix must not fabricate
# a result for genuinely missing data.
statement ok
CREATE TABLE det01_null AS SELECT 'a' AS g, DATE '2020-01-01' AS ds, NULL::DOUBLE AS y;

query I
SELECT primary_period FROM ts_detect_periods_by('det01_null', g, ds, y, MAP{});
----
NULL

statement ok
DROP TABLE det01_null;

query I
SELECT ts_autoperiod(list_transform(range(32), lambda i: (10 + 20 * (i % 4))::DOUBLE)).period = 4.0;
----
true

query I
SELECT ts_detect_multiple_periods(list_transform(range(32), lambda i: (10 + 20 * (i % 4))::DOUBLE)).primary_period = 4.0;
----
true

query I
SELECT ts_lomb_scargle(list_transform(range(32), lambda i: (10 + 20 * (i % 4))::DOUBLE)).period BETWEEN 3.5 AND 4.5;
----
true

# cfd_autoperiod and instantaneous_period/sazed/ssa/stl/matrix_profile/aic
# all return a non-NULL struct for a clean period-4 square wave (parity
# existence check -- several of these intentionally disagree slightly on the
# exact period for this specific input, as documented per-method in their own
# reference material; this file locks in "detects something", the specific
# per-method value pins live in test/sql/ts_periods_specialized.test and
# ts_periods_advanced.test).
query I
SELECT ts_cfd_autoperiod(list_transform(range(32), lambda i: (10 + 20 * (i % 4))::DOUBLE)) IS NOT NULL
   AND ts_instantaneous_period(list_transform(range(32), lambda i: (10 + 20 * (i % 4))::DOUBLE)) IS NOT NULL
   AND ts_sazed_period(list_transform(range(32), lambda i: (10 + 20 * (i % 4))::DOUBLE)) IS NOT NULL
   AND ts_ssa_period(list_transform(range(32), lambda i: (10 + 20 * (i % 4))::DOUBLE)) IS NOT NULL
   AND ts_stl_period(list_transform(range(32), lambda i: (10 + 20 * (i % 4))::DOUBLE)) IS NOT NULL
   AND ts_aic_period(list_transform(range(32), lambda i: (10 + 20 * (i % 4))::DOUBLE)) IS NOT NULL
   AND ts_matrix_profile_period(list_transform(range(32), lambda i: (10 + 20 * (i % 4))::DOUBLE)) IS NOT NULL;
----
true

# Closed-form, exact pins for the "detects period exactly 4" methods on the
# same square wave (aic/stl/sazed all report 4.0 exactly on this fresh build).
query I
SELECT (ts_aic_period(list_transform(range(32), lambda i: (10 + 20 * (i % 4))::DOUBLE))).period = 4.0
   AND (ts_stl_period(list_transform(range(32), lambda i: (10 + 20 * (i % 4))::DOUBLE))).period = 4.0
   AND (ts_sazed_period(list_transform(range(32), lambda i: (10 + 20 * (i % 4))::DOUBLE))).period = 4.0;
----
true

# =============================================================================
# ts_detrend / ts_detrend_by (WRAP-01): a perfectly linear series detrends to
# itself with method 'linear' (closed form, no fixture needed).
# =============================================================================

query I
SELECT max(abs(t - e)) < 1e-8
FROM (SELECT unnest((ts_detrend(list_transform(range(20), lambda i: 2.0 * i + 3.0), 'linear')).trend) AS t,
             unnest(list_transform(range(20), lambda i: 2.0 * i + 3.0)) AS e);
----
true

query I
SELECT (ts_detrend(list_transform(range(20), lambda i: 2.0 * i + 3.0), 'linear')).method;
----
linear

statement ok
CREATE TABLE lin20 AS SELECT 'g' AS id, DATE '2024-01-01' + INTERVAL (i) DAY AS ds, (2.0 * i + 3.0) AS v FROM range(20) t(i);

query I
SELECT max(abs(t - e)) < 1e-8
FROM (
    SELECT unnest(by_trend) AS t, unnest(scalar_trend) AS e
    FROM (
        SELECT
            (SELECT trend FROM ts_detrend_by('lin20', id, ds, v, 'linear')) AS by_trend,
            (ts_detrend(list_transform(range(20), lambda i: 2.0 * i + 3.0), 'linear')).trend AS scalar_trend
    )
);
----
true

statement ok
DROP TABLE lin20;
