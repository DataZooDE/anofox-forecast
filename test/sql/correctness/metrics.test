# name: test/sql/correctness/metrics.test
# description: Correctness-suite value pins for the 11 ts_*_by metric macros plus their
#   scalar counterparts -- Phase 18, 18-02, D-08, TEST-03. Not json-gated (D-02): runs on
#   every native build.
# group: [sql]
#
# D-08 live-matrix finding (Phase 18 Task 1 SUMMARY has the full 11x2 table): on a fresh
# post-18-01 build, EVERY one of the 11 metric _by macros works in the documented
# subquery-source form and EVERY one fails identically in the bare-table-name form (the
# same Binder Error naming the TABLE-typed native-function parameter). The Phase 16
# deferred-items.md report that only ts_coverage_by/ts_quantile_loss_by were broken was a
# stale-build artifact (RESEARCH.md Pitfall 3) -- no macro body changed.
#
# MASE literal below is copied from validation/reference/fixtures/r_mase/accuracy_mase.json
# ("det_m4" case) via:
#   python3 -c "import json; d=json.load(open('validation/reference/fixtures/r_mase/accuracy_mase.json')); print(d['cases']['det_m4']['mase_accuracy'], d['tolerance'])"

require anofox_forecast

# =============================================================================
# D-08: subquery-form value pins for ts_coverage_by / ts_quantile_loss_by, on a
# hand-checkable 10-row table: id='A', y=i, forecast=i+1, lower=i-1, upper=i+2
# for i in 1..10.
# =============================================================================

statement ok
CREATE TABLE probe10 AS
SELECT 'A' AS id, i AS ds, i::DOUBLE AS y, (i + 1)::DOUBLE AS f, (i - 1)::DOUBLE AS lo, (i + 2)::DOUBLE AS hi
FROM range(1, 11) t(i);

# coverage = share of actuals inside [lower, upper]. Here lower = y-1 <= y <= y+2 =
# upper for every row, so coverage = 10/10 = 1.0 (closed form).
query II
SELECT id, coverage FROM ts_coverage_by((SELECT id, ds, y, lo, hi FROM probe10), 'ds', 'y', 'lo', 'hi');
----
A	1.0

# pinball (quantile) loss at q=0.5 is half the MAE: |y - f| = 1 for every row, so
# quantile_loss = 0.5 * 1 = 0.5 (closed form).
query II
SELECT id, quantile_loss FROM ts_quantile_loss_by((SELECT id, ds, y, f FROM probe10), 'ds', 'y', 'f', 0.5);
----
A	0.5

# The bare table-name form fails identically for the whole family (not just
# coverage/quantile_loss) -- pinned as a statement error documenting the contract,
# per the macro descriptions updated in src/macros/ts_macros.cpp this plan.
statement error
SELECT * FROM ts_coverage_by('probe10', 'ds', 'y', 'lo', 'hi');
----
Binder Error

statement error
SELECT * FROM ts_quantile_loss_by('probe10', 'ds', 'y', 'f', 0.5);
----
Binder Error

statement error
SELECT * FROM ts_mae_by('probe10', 'ds', 'y', 'f');
----
Binder Error

# =============================================================================
# Core scalar/_by metrics on probe10 (closed form): MAE 1.0, MSE 1.0, RMSE 1.0,
# BIAS 1.0 (f - y = 1 for every row), R2 (variance-explained closed form).
# =============================================================================

query II
SELECT id, mae FROM ts_mae_by((SELECT id, ds, y, f FROM probe10), 'ds', 'y', 'f');
----
A	1.0

query II
SELECT id, mse FROM ts_mse_by((SELECT id, ds, y, f FROM probe10), 'ds', 'y', 'f');
----
A	1.0

query II
SELECT id, rmse FROM ts_rmse_by((SELECT id, ds, y, f FROM probe10), 'ds', 'y', 'f');
----
A	1.0

query II
SELECT id, bias FROM ts_bias_by((SELECT id, ds, y, f FROM probe10), 'ds', 'y', 'f');
----
A	1.0

# Scalar forms agree with their _by counterparts on the same data (parity pin).
query I
SELECT abs(ts_mae([1.0,2.0,3.0], [2.0,3.0,5.0])
         - (SELECT mae FROM ts_mae_by((SELECT 1 AS id, ds, y, f FROM
               (VALUES (1,1.0,2.0),(2,2.0,3.0),(3,3.0,5.0)) t(ds,y,f)), 'ds', 'y', 'f'))) < 1e-9;
----
true

# =============================================================================
# MAPE zero-actual NULL policy (D-07): a single zero actual makes the whole
# pairwise-complete result NULL, not a silent per-pair exclusion.
# =============================================================================

query I
SELECT ts_mape([0.0, 100.0, 200.0], [10.0, 110.0, 180.0]) IS NULL;
----
true

query I
SELECT abs(ts_mape([100.0, 200.0, 300.0], [110.0, 180.0, 330.0]) - 10.0) < 0.1;
----
true

# =============================================================================
# Pairwise-complete NULL handling: a NULL in either actual or forecast drops
# that row from the group's computation rather than propagating NaN/erroring.
# Rows (ds=1: y=10,f=11 -> err 1), (ds=2: y=NULL), (ds=3: f=NULL), (ds=4:
# y=30,f=33 -> err 3) -- complete pairs are (1,2) and err mean = (1+3)/2 = 2.0.
# =============================================================================

statement ok
CREATE TABLE pairwise_nulls AS
SELECT * FROM (VALUES
('A', 1, 10.0, 11.0),
('A', 2, NULL::DOUBLE, 12.0),
('A', 3, 20.0, NULL::DOUBLE),
('A', 4, 30.0, 33.0)
) t(id, ds, actual, forecast);

query II
SELECT id, mae FROM ts_mae_by((SELECT id, ds, actual, forecast FROM pairwise_nulls), 'ds', 'actual', 'forecast');
----
A	2.0

statement ok
DROP TABLE pairwise_nulls;

# =============================================================================
# MASE (Hyndman-Koehler): fixture-sourced value from r_mase/accuracy_mase.json
# "det_m4" (40 in-sample history rows with forecast NULL, 8 out-of-sample
# evaluation rows, seasonal_period 4). Tolerance mase_abs 1e-12 (fixture); the
# SQL path agrees to within 1e-9 (double-precision summation-order noise).
# =============================================================================

statement ok
CREATE TABLE det_m4 AS
SELECT * FROM (VALUES
(1, 1, 11.7767104331365, NULL),
(1, 2, 9.40903228808558, NULL),
(1, 3, 9.13471278483916, NULL),
