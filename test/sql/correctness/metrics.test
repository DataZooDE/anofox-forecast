query I
SELECT abs(mase - 0.815579185580866) < 1e-9
FROM ts_mase_by((SELECT id, ds, y, forecast FROM det_m4), 'ds', 'y', 'forecast', seasonal_period := 4);
----
true

# The old 5th-argument baseline-column form is a statement error naming
# ts_rmae_by as the replacement (D-08, Phase 10 removal).
statement error
SELECT * FROM ts_mase_by((SELECT id, ds, y, forecast, 9.0 AS baseline FROM det_m4), 'ds', 'y', 'forecast', 'baseline');
----
ts_mase_by no longer takes a baseline column

statement ok
DROP TABLE det_m4;

# =============================================================================
# RMAE (Relative MAE, two-model comparison) and SMAPE parity.
# =============================================================================

# RMAE = MAE(y,f) / MAE(y,pred2) = 1 / 2 = 0.5 (f = y+1 so MAE(y,f)=1; hi = y+2
# so MAE(y,hi)=2; closed form).
query II
SELECT id, rmae FROM ts_rmae_by(
    (SELECT id, ds, y, f, hi AS pred2 FROM probe10), 'ds', 'y', 'f', 'pred2'
);
----
A	0.5

query I
SELECT abs(ts_smape([10.0, 20.0, 30.0], [10.0, 20.0, 30.0]));
----
0.0

statement ok
DROP TABLE probe10;

# =============================================================================
# Remaining scalar-only forms (closed form, independently hand-derived):
# ts_bias/ts_mse/ts_rmse/ts_r2/ts_coverage/ts_quantile_loss/ts_rmae/ts_mase.
# =============================================================================

# bias = mean(forecast - actual): errors 1, 1, 2 -> mean 4/3.
query I
SELECT abs(ts_bias([1.0,2.0,3.0],[2.0,3.0,5.0]) - 4.0/3.0) < 1e-9;
----
true

# mse = mean(error^2): 1^2 + 1^2 + 2^2 = 6 -> mean 2.0.
query I
SELECT abs(ts_mse([1.0,2.0,3.0],[2.0,3.0,5.0]) - 2.0) < 1e-9;
----
true

# rmse = sqrt(mse) = sqrt(2).
query I
SELECT abs(ts_rmse([1.0,2.0,3.0],[2.0,3.0,5.0]) - sqrt(2.0)) < 1e-9;
----
true

# r2 = 1 - SS_res/SS_tot: actual mean 2, SS_tot = 1+0+1 = 2;
# residuals -0.1,-0.1,0.1 -> SS_res = 0.03; r2 = 1 - 0.03/2 = 0.985.
query I
SELECT abs(ts_r2([1.0,2.0,3.0],[1.1,2.1,2.9]) - 0.985) < 1e-9;
----
true

# coverage: actual in [lower, upper] for every row -> 1.0.
query I
SELECT abs(ts_coverage([1.0,2.0,3.0],[0.0,1.0,2.0],[2.0,3.0,4.0]) - 1.0) < 1e-9;
----
true

# quantile_loss (pinball, q=0.5) = half the MAE: |1-1.1|=0.1, |2-2.2|=0.2 ->
# mean 0.15; half -> 0.075.
query I
SELECT abs(ts_quantile_loss([1.0,2.0],[1.1,2.2],0.5) - 0.075) < 1e-9;
----
true

# rmae: MAE(actual,pred1) = mean(.1,.2,.3) = 0.2; MAE(actual,pred2) =
# mean(.2,.4,.6) = 0.4; rmae = 0.2/0.4 = 0.5.
query I
SELECT abs(ts_rmae([1.0,2.0,3.0],[1.1,2.2,3.3],[1.2,2.4,3.6]) - 0.5) < 1e-9;
----
true

# mase: MAE(actual,forecast) = mean(1,1) = 1; in-sample seasonal-naive
# (lag 1) MAE = mean(|diff([10,11,12,13])|) = mean(1,1,1) = 1; mase = 1/1 = 1.
query I
SELECT abs(ts_mase([15.0,20.0],[16.0,19.0],[10.0,11.0,12.0,13.0],1) - 1.0) < 1e-9;
----
true

# ts_mape_by (the _by form, pairwise-complete, no zero actuals): same probe
# data as the earlier scalar ts_mape pin -- 10%/10%/10% errors -> MAPE ~10%.
statement ok
CREATE TABLE mape_probe AS
SELECT * FROM (VALUES
('A', 1, 100.0, 110.0), ('A', 2, 200.0, 180.0), ('A', 3, 300.0, 330.0)
) t(id, ds, y, forecast);

query I
SELECT abs(mape - 10.0) < 0.1
FROM ts_mape_by((SELECT id, ds, y, forecast FROM mape_probe), 'ds', 'y', 'forecast');
----
true

statement ok
DROP TABLE mape_probe;

# ts_mqloss (multi-quantile loss, averaged pinball across levels): a single
# level 0.5 reduces to the ts_quantile_loss closed form above (0.075).
query I
SELECT abs(ts_mqloss([1.0,2.0], [[1.1,2.2]], [0.5]) - 0.075) < 1e-9;
----
true

# _ts_metrics_native (the table function backing ts_mae_by/ts_mse_by/.../
# ts_bias_by): parity with ts_mae_by on a single-row group.
statement ok
CREATE TABLE mm2 AS SELECT 'A' id, 1 ds, 10.0 y, 11.0 f;

query I
SELECT (SELECT mae FROM _ts_metrics_native((SELECT id, ds, y, f FROM mm2), 'ds', 'y', 'f', 'mae'))
     = (SELECT mae FROM ts_mae_by((SELECT id, ds, y, f FROM mm2), 'ds', 'y', 'f'));
----
true

statement ok
DROP TABLE mm2;

# =============================================================================
# ts_smape_by / ts_r2_by (closed form, Phase 18 18-04 close-out: both are named in
# the v2026.10.16 CHANGELOG metric _by subquery-source contract). Same 10-row probe:
# y = i, f = i + 1 for i in 1..10.
#   sMAPE = mean_i 2|f-y|/(|y|+|f|) * 100 = mean_i 2/(2i+1) * 100 = 23.617491555572...
#   R2    = 1 - SS_res/SS_tot = 1 - 10/82.5 = 0.878787878787...
# =============================================================================

statement ok
CREATE TABLE probe10b AS
SELECT 'A' AS id, i AS ds, i::DOUBLE AS y, (i + 1)::DOUBLE AS f FROM range(1, 11) t(i);

query I
SELECT abs(smape - 23.617491555572052) < 1e-9
FROM ts_smape_by((SELECT id, ds, y, f FROM probe10b), 'ds', 'y', 'f');
----
true

query I
SELECT abs(r2 - (1 - 10.0 / 82.5)) < 1e-12
FROM ts_r2_by((SELECT id, ds, y, f FROM probe10b), 'ds', 'y', 'f');
----
true

statement ok
DROP TABLE probe10b;

# =============================================================================
# #285 (BUG-03, Phase 20-02): every metric macro gives the same result for every
# input row order and plan shape. Root cause: a UNION ALL source gave the in-out
# native two pipelines sharing one global state, and the first pipeline's
# in_out_function_final emitted results on part of the rows (NULL MASE; a
# 1.0 MAE from only the first branch). The macros now read their source through
# (SELECT * FROM _ts_passthrough(source) ORDER BY ALL), a single-pipeline
# breaker, and the natives use the last-finalizer barrier in
# src/include/ts_collect_finalize.hpp. Its late-row guard (rows arriving after
# finalize -> InvalidInputException) is defence in depth that the macros never
# reach, so it is documented here, not pinned.
#
# MASE literals are R forecast::accuracy on the date-sorted series, from
# validation/reference/fixtures/r_mase/accuracy_mase.json (cases
# issue285_panel_A/B/C), regenerated with
#   Rscript validation/reference/r/gen_mase_reference.R
# and printed with
#   python3 -c "import json; d=json.load(open('validation/reference/fixtures/r_mase/accuracy_mase.json')); print([d['cases']['issue285_panel_'+k]['mase_accuracy'] for k in 'ABC'], d['tolerance'])"
# =============================================================================

statement ok
CREATE TABLE s AS SELECT id, (TIMESTAMP '2024-01-01' + INTERVAL (i) DAY) AS ds, base + 0.3 * i + 5 * sin(2 * pi() * i / 7) + CASE WHEN id = 'B' AND i >= 50 THEN 15 ELSE 0 END + 1.6 * cos(i * 0.9) + 0.7 * sin(i * 1.7 + base) AS y FROM (VALUES ('A', 20.0), ('B', 40.0), ('C', 60.0)) t(id, base), range(84) r(i);

statement ok
CREATE TABLE f AS SELECT id, ds, y, y + 1 AS yhat FROM s WHERE ds >= TIMESTAMP '2024-03-11';

# Helper columns for the other ten macros: a forecast fc whose error varies by
# row (so a result computed on part of the rows differs from the all-rows one),
# an interval [fc - 2, fc + 2] (coverage strictly between 0 and 1), and a
# second model pred2 for ts_rmae_by.
statement ok
CREATE TABLE m285 AS
SELECT id, ds, y, fc, fc - 2 AS lower, fc + 2 AS upper, y + 3 * sin(0.21 * k) AS pred2
FROM (SELECT id, ds, y, date_diff('day', TIMESTAMP '2024-01-01', ds) AS k,
             y + 1 + 2 * cos(0.37 * date_diff('day', TIMESTAMP '2024-01-01', ds)) AS fc
      FROM s);

# ts_mase_by, literal cut-off UNION ALL (the #285 issue shape 1): never NULL, the R values per id.
query II
SELECT id, round(mase, 10) FROM ts_mase_by((SELECT id, ds, y, NULL::DOUBLE AS yhat FROM s WHERE ds < TIMESTAMP '2024-03-11' UNION ALL SELECT * FROM f), 'ds', 'y', 'yhat', seasonal_period := 7) ORDER BY id;
----
A	0.4764952155
B	0.2655145005
C	0.4759518449

# ts_mase_by, scalar-subquery cut-off UNION ALL (the #285 issue shape 2): never NULL, the R values per id.
query II
SELECT id, round(mase, 10) FROM ts_mase_by((SELECT id, ds, y, NULL::DOUBLE AS yhat FROM s WHERE ds < (SELECT min(ds) FROM f) UNION ALL SELECT * FROM f), 'ds', 'y', 'yhat', seasonal_period := 7) ORDER BY id;
----
A	0.4764952155
B	0.2655145005
C	0.4759518449

# ts_mase_by, date-sorted: never NULL, the R values per id.
query II
SELECT id, round(mase, 10) FROM ts_mase_by((SELECT * FROM (SELECT id, ds, y, NULL::DOUBLE AS yhat FROM s WHERE ds < (SELECT min(ds) FROM f) UNION ALL SELECT * FROM f) ORDER BY id, ds), 'ds', 'y', 'yhat', seasonal_period := 7) ORDER BY id;
----
A	0.4764952155
B	0.2655145005
C	0.4759518449

# ts_mase_by, reversed: never NULL, the R values per id.
query II
SELECT id, round(mase, 10) FROM ts_mase_by((SELECT * FROM (SELECT id, ds, y, NULL::DOUBLE AS yhat FROM s WHERE ds < (SELECT min(ds) FROM f) UNION ALL SELECT * FROM f) ORDER BY id, ds DESC), 'ds', 'y', 'yhat', seasonal_period := 7) ORDER BY id;
----
A	0.4764952155
B	0.2655145005
C	0.4759518449

# ts_mase_by, shuffled: never NULL, the R values per id.
query II
SELECT id, round(mase, 10) FROM ts_mase_by((SELECT * FROM (SELECT id, ds, y, NULL::DOUBLE AS yhat FROM s WHERE ds < (SELECT min(ds) FROM f) UNION ALL SELECT * FROM f) ORDER BY hash(id, ds)), 'ds', 'y', 'yhat', seasonal_period := 7) ORDER BY id;
----
A	0.4764952155
B	0.2655145005
C	0.4759518449

# ts_mase_by equals R forecast::accuracy MASE (fixture tolerance mase_abs = 1e-12;
# 1e-10 here leaves room for DuckDB's DECIMAL 0.3 * i versus R's double).
query I
SELECT count(*) FROM ts_mase_by((SELECT id, ds, y, NULL::DOUBLE AS yhat FROM s WHERE ds < (SELECT min(ds) FROM f) UNION ALL SELECT * FROM f), 'ds', 'y', 'yhat', seasonal_period := 7)
WHERE abs(mase - CASE id WHEN 'A' THEN 0.476495215529845 WHEN 'B' THEN 0.265514500507306 ELSE 0.47595184490648 END) < 1e-10;
----
3

# Two-branch probe: a y+1 branch (31 rows per id) UNION ALL a y+3 branch behind a
# scalar-subquery cut-off (14 rows per id). Before the fix only the first branch
# reached the computation (MAE exactly 1.0); the all-rows MAE is (31*1 + 14*3)/45.
query II
SELECT id, round(mae, 10) FROM ts_mae_by((SELECT id, ds, y, y + 1 AS yhat FROM s WHERE ds < TIMESTAMP '2024-02-01' UNION ALL SELECT id, ds, y, y + 3 FROM s WHERE ds >= (SELECT min(ds) FROM f)), 'ds', 'y', 'yhat') ORDER BY id;
----
A	1.6222222222
B	1.6222222222
C	1.6222222222

# The other ten metric macros: the result over a reversed, a hash-shuffled and a
# UNION ALL + scalar-subquery source equals the date-ordered result (EXCEPT ALL
# empty in both directions; values rounded to 10 digits because ts_rmae_by and
# ts_quantile_loss_by sum in arrival order, which may move the last float bit).
# Each date-ordered result is first checked to have one non-NULL row per id.

query II
SELECT count(*), count(mae) FROM ts_mae_by((SELECT id, ds, y, fc FROM m285 ORDER BY id, ds), 'ds', 'y', 'fc');
----
3	3

# ts_mae_by: reversed source == date-ordered source.
query I
SELECT (SELECT count(*) FROM (SELECT id, round(mae, 10) AS v FROM ts_mae_by((SELECT id, ds, y, fc FROM m285 ORDER BY id, ds DESC), 'ds', 'y', 'fc') EXCEPT ALL SELECT id, round(mae, 10) AS v FROM ts_mae_by((SELECT id, ds, y, fc FROM m285 ORDER BY id, ds), 'ds', 'y', 'fc'))) + (SELECT count(*) FROM (SELECT id, round(mae, 10) AS v FROM ts_mae_by((SELECT id, ds, y, fc FROM m285 ORDER BY id, ds), 'ds', 'y', 'fc') EXCEPT ALL SELECT id, round(mae, 10) AS v FROM ts_mae_by((SELECT id, ds, y, fc FROM m285 ORDER BY id, ds DESC), 'ds', 'y', 'fc')));
----
0

# ts_mae_by: shuffled source == date-ordered source.
query I
SELECT (SELECT count(*) FROM (SELECT id, round(mae, 10) AS v FROM ts_mae_by((SELECT id, ds, y, fc FROM m285 ORDER BY hash(id, ds)), 'ds', 'y', 'fc') EXCEPT ALL SELECT id, round(mae, 10) AS v FROM ts_mae_by((SELECT id, ds, y, fc FROM m285 ORDER BY id, ds), 'ds', 'y', 'fc'))) + (SELECT count(*) FROM (SELECT id, round(mae, 10) AS v FROM ts_mae_by((SELECT id, ds, y, fc FROM m285 ORDER BY id, ds), 'ds', 'y', 'fc') EXCEPT ALL SELECT id, round(mae, 10) AS v FROM ts_mae_by((SELECT id, ds, y, fc FROM m285 ORDER BY hash(id, ds)), 'ds', 'y', 'fc')));
----
0

# ts_mae_by: UNION ALL + scalar-subquery cut-off source == date-ordered source.
query I
SELECT (SELECT count(*) FROM (SELECT id, round(mae, 10) AS v FROM ts_mae_by((SELECT id, ds, y, fc FROM m285 WHERE ds < (SELECT min(ds) FROM f) UNION ALL SELECT id, ds, y, fc FROM m285 WHERE ds >= (SELECT min(ds) FROM f)), 'ds', 'y', 'fc') EXCEPT ALL SELECT id, round(mae, 10) AS v FROM ts_mae_by((SELECT id, ds, y, fc FROM m285 ORDER BY id, ds), 'ds', 'y', 'fc'))) + (SELECT count(*) FROM (SELECT id, round(mae, 10) AS v FROM ts_mae_by((SELECT id, ds, y, fc FROM m285 ORDER BY id, ds), 'ds', 'y', 'fc') EXCEPT ALL SELECT id, round(mae, 10) AS v FROM ts_mae_by((SELECT id, ds, y, fc FROM m285 WHERE ds < (SELECT min(ds) FROM f) UNION ALL SELECT id, ds, y, fc FROM m285 WHERE ds >= (SELECT min(ds) FROM f)), 'ds', 'y', 'fc')));
----
0

query II
SELECT count(*), count(mse) FROM ts_mse_by((SELECT id, ds, y, fc FROM m285 ORDER BY id, ds), 'ds', 'y', 'fc');
----
3	3

