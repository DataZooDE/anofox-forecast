(1, 16, 12.1268326309626, NULL),
(1, 17, 14.3340062895737, NULL),
(1, 18, 10.8632321315473, NULL),
(1, 19, 9.87168826731369, NULL),
(1, 20, 12.9550736440473, NULL),
(1, 21, 13.5107810432727, NULL),
(1, 22, 11.625903038569, NULL),
(1, 23, 11.2604180727247, NULL),
(1, 24, 12.353110675953, NULL),
(1, 25, 13.5698995857987, NULL),
(1, 26, 13.2482728441404, NULL),
(1, 27, 11.2109407202182, NULL),
(1, 28, 11.821363547595, NULL),
(1, 29, 15.0218251894115, NULL),
(1, 30, 13.8998668269692, NULL),
(1, 31, 10.3963396971371, NULL),
(1, 32, 12.755105242094, NULL),
(1, 33, 16.2913199700294, NULL),
(1, 34, 13.2039279504381, NULL),
(1, 35, 10.6354561259244, NULL),
(1, 36, 14.3550680787307, NULL),
(1, 37, 16.076332609825, NULL),
(1, 38, 12.8016031084154, NULL),
(1, 39, 12.1692099874515, NULL),
