# =============================================================================
# Cross-validation inputs as UNION ALL / reversed / shuffled views. `cvt` is the
# materialized fold table built from `ut`; `cvu` re-reads it as a UNION ALL with the
# same scalar-subquery cut-off; `cvr` / `cvs` are reversed / shuffled. `sxt` adds a
# row-varying feature column for ts_cv_hydrate_by, with the same four shapes.
# =============================================================================

statement ok
CREATE TABLE cvt AS SELECT * FROM ts_cv_folds_by('ut', id, ds, y, 2, 5, MAP{});

statement ok
CREATE VIEW cvu AS SELECT * FROM cvt WHERE ds < TIMESTAMP '2024-02-01' UNION ALL SELECT * FROM cvt WHERE ds >= (SELECT min(ds) FROM f2);

statement ok
CREATE VIEW cvr AS SELECT * FROM cvt ORDER BY fold_id DESC, id DESC, ds DESC;

statement ok
CREATE VIEW cvs AS SELECT * FROM cvt ORDER BY hash(fold_id, id, ds);

statement ok
CREATE TABLE sxt AS SELECT id, ds, y, round(y * 2 + (epoch(ds) / 86400) % 7, 3)::DOUBLE AS temperature FROM ut;

statement ok
CREATE VIEW sxu AS SELECT * FROM sxt WHERE ds < TIMESTAMP '2024-02-01' UNION ALL SELECT * FROM sxt WHERE ds >= (SELECT min(ds) FROM f2);

statement ok
CREATE VIEW sxr AS SELECT * FROM sxt ORDER BY id, ds DESC;

statement ok
CREATE VIEW sxs AS SELECT * FROM sxt ORDER BY hash(id, ds);

query I
SELECT count(*) FROM cvu;
----
255

