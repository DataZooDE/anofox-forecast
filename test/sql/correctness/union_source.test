# =============================================================================
# ts_forecast_var_by (two variables, p = 1, horizon 3): a contiguous 84-day wide
# fixture `wt`; `wu` re-reads it as a UNION ALL split at 2024-02-15 (scalar-subquery
# cut-off on the second branch, both branches non-empty); `wr` / `ws` are reversed /
# shuffled. One VAR fit on all 84 rows on every shape.
# =============================================================================

statement ok
CREATE TABLE wt AS SELECT (TIMESTAMP '2024-01-01' + INTERVAL (i) DAY) AS ds, round(10 + sin(i) + 0.1 * i, 6) AS y1, round(5 + cos(i * 0.7) + 0.05 * i, 6) AS y2 FROM range(84) r(i);

statement ok
CREATE VIEW wu AS SELECT * FROM wt WHERE ds < TIMESTAMP '2024-02-15' UNION ALL SELECT * FROM wt WHERE ds >= (SELECT min(ds) FROM wt WHERE ds >= TIMESTAMP '2024-02-15');

statement ok
CREATE VIEW wr AS SELECT * FROM wt ORDER BY ds DESC;

statement ok
CREATE VIEW ws AS SELECT * FROM wt ORDER BY hash(ds);

# Observed before the fix on the UNION ALL view: y1 14.442128..14.449617 (the first
# branch alone) instead of 19.071735..19.168724.
query IIII
SELECT variable, count(*), round(min(forecast_value), 6), round(max(forecast_value), 6) FROM ts_forecast_var_by('wu', 'ds', ['y1', 'y2'], 3, '1d') GROUP BY ALL ORDER BY ALL;
----
y1	3	19.071735	19.168724
y2	3	9.325175	9.523599

query I
SELECT count(*) FROM (SELECT * FROM ts_forecast_var_by('wu', 'ds', ['y1', 'y2'], 3, '1d') EXCEPT ALL SELECT * FROM ts_forecast_var_by('wt', 'ds', ['y1', 'y2'], 3, '1d'));
----
0

query I
SELECT count(*) FROM (SELECT * FROM ts_forecast_var_by('wt', 'ds', ['y1', 'y2'], 3, '1d') EXCEPT ALL SELECT * FROM ts_forecast_var_by('wu', 'ds', ['y1', 'y2'], 3, '1d'));
----
0

query I
