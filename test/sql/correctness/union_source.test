# =============================================================================
# ts_forecast_panel_by series order (Rule 1 fix in 20-04): the shared GlobalETS fit
# used the series in ARRIVAL order, so on a 2000-series panel the result moved with
# the intake interleaving (observed on the pre-fix 20-04 build, 400k rows: sum(yhat)
# 127800.5516 or 127800.5522 between runs at default threads). The native now fits
# the series in group-key order: the result at default threads equals the result at
# threads = 1 and on a shuffled copy, both ways.
# =============================================================================

statement ok
CREATE TABLE pbig AS SELECT 's' || (i // 200) AS id, TIMESTAMP '2024-01-01' + INTERVAL (i % 200) DAY AS ds, (i % 200) * 0.1 + ((i * 7919) % 13) * 0.25 AS y FROM range(400000) r(i);

statement ok
CREATE TABLE pbig_shuffled AS SELECT * FROM pbig ORDER BY hash(id, ds);

statement ok
SET threads = 1;

statement ok
CREATE TABLE pan_t1 AS SELECT * FROM ts_forecast_panel_by('pbig', id, ds, y, 'GlobalETS', 3, '1d', MAP{});

statement ok
RESET threads;

query III
SELECT count(*), count(DISTINCT id), round(sum(yhat), 4) FROM pan_t1;
----
6000	2000	127800.5516

query I
SELECT count(*) FROM (SELECT * FROM ts_forecast_panel_by('pbig', id, ds, y, 'GlobalETS', 3, '1d', MAP{}) EXCEPT ALL SELECT * FROM pan_t1);
----
0

query I
SELECT count(*) FROM (SELECT * FROM pan_t1 EXCEPT ALL SELECT * FROM ts_forecast_panel_by('pbig', id, ds, y, 'GlobalETS', 3, '1d', MAP{}));
----
0

query I
SELECT count(*) FROM (SELECT * FROM ts_forecast_panel_by('pbig_shuffled', id, ds, y, 'GlobalETS', 3, '1d', MAP{}) EXCEPT ALL SELECT * FROM pan_t1);
----
0

query I
SELECT count(*) FROM (SELECT * FROM pan_t1 EXCEPT ALL SELECT * FROM ts_forecast_panel_by('pbig_shuffled', id, ds, y, 'GlobalETS', 3, '1d', MAP{}));
----
0

# =============================================================================
# 20-05: _ts_forecast_native (internal, #285 scope expansion, decisions_addendum_2)
# and ts_forecast_by (already correct; pinned here, body untouched). Fixture: 3
# series x 84 days with a weekly sine component (planner facts, 20-05-PLAN.md),
# so SeasonalNaive/Theta have something to fit. uv/rv/sv/ut reuse the s2/f2
# fixture above for the ts_forecast_by pins (seasonality is irrelevant to those
# -- they only check shape independence); fs2/fuv/fut/frv/fsv below are a
# separate seasonal fixture used only for the exact-value _ts_forecast_native pin.
# =============================================================================

statement ok
CREATE TABLE fs2 AS SELECT id, (TIMESTAMP '2024-01-01' + INTERVAL (i) DAY) AS ds, base + 0.3 * i + 5 * sin(2 * pi() * i / 7) AS y FROM (VALUES ('A', 20.0), ('B', 40.0), ('C', 60.0)) t(id, base), range(84) r(i);

statement ok
CREATE TABLE ff2 AS SELECT id, ds, y FROM fs2 WHERE ds >= TIMESTAMP '2024-03-11';

statement ok
CREATE VIEW fuv AS SELECT id, ds, y FROM fs2 WHERE ds < TIMESTAMP '2024-02-01' UNION ALL SELECT id, ds, y FROM fs2 WHERE ds >= (SELECT min(ds) FROM ff2);

statement ok
CREATE TABLE fut AS SELECT * FROM fuv;

statement ok
CREATE VIEW frv AS SELECT * FROM fut ORDER BY id, ds DESC;

statement ok
CREATE VIEW fsv AS SELECT * FROM fut ORDER BY hash(id, ds);

# _ts_forecast_native: 9 forecast rows (3 ids x 3 horizon), sum(yhat) 548.917583
# on every shape (was 484.871756 on `fuv` pre-fix: the UNION's first branch
# alone, extrapolated -- the second branch's rows never reached finalize).
query II
SELECT count(*), round(sum(yhat), 6) FROM _ts_forecast_native((SELECT id, ds, y FROM fuv), 3, '1d', 'Naive', MAP{});
----
9	548.917583

query II
