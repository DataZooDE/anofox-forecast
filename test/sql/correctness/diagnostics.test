# =============================================================================
# ts_adf / ts_adf_by (DIAG-03, UPST-01): augmented ADF with MacKinnon critical
# values for 'c' and 'ct' regressions.
# =============================================================================

query I
SELECT abs((ts_adf(LIST(v ORDER BY ds), -1, 'c')).statistic - (-0.986479461317597)) < 1e-8
FROM air17;
----
true

query I
SELECT abs((ts_adf(LIST(v ORDER BY ds), -1, 'c')).p_value - 0.7581636095609505) < 1e-8
   AND abs((ts_adf(LIST(v ORDER BY ds), -1, 'c')).cv_5pct - (-2.882567574015525)) < 1e-10
   AND (ts_adf(LIST(v ORDER BY ds), -1, 'c')).lags = 4
FROM air17;
----
true

query I
SELECT abs((ts_adf(LIST(v ORDER BY ds), -1, 'ct')).statistic - (-7.318571346919129)) < 1e-8
   AND abs((ts_adf(LIST(v ORDER BY ds), -1, 'ct')).cv_5pct - (-3.4427962380330523)) < 1e-10
   AND (ts_adf(LIST(v ORDER BY ds), -1, 'ct')).lags = 5
FROM air17;
----
true

query I
SELECT abs((adf).statistic - (SELECT (ts_adf(LIST(v ORDER BY ds), -1, 'ct')).statistic FROM air17)) < 1e-12
FROM ts_adf_by('air17', id, ds, v, regression := 'ct');
----
true

statement error
SELECT (ts_adf(LIST(v ORDER BY ds), -1, 'n')).statistic FROM air17;
----
expected one of: c, ct

# =============================================================================
# ts_kpss / ts_kpss_by (DIAG-03, UPST-01): bounded p-values, 'c'/'ct' regressions.
# =============================================================================

query I
SELECT abs((ts_kpss(LIST(v ORDER BY ds), -1, 'c')).statistic - 2.739473620962186) < 1e-10
   AND (ts_kpss(LIST(v ORDER BY ds), -1, 'c')).p_value = 0.01
   AND (ts_kpss(LIST(v ORDER BY ds), -1, 'c')).lags = 4
FROM air17;
----
true

query I
SELECT abs((ts_kpss(LIST(v ORDER BY ds), -1, 'ct')).statistic - 0.09614984853532407) < 1e-10
   AND (ts_kpss(LIST(v ORDER BY ds), -1, 'ct')).p_value = 0.1
FROM air17;
----
true

query I
SELECT abs((kpss).statistic - (SELECT (ts_kpss(LIST(v ORDER BY ds), -1, 'ct')).statistic FROM air17)) < 1e-12
FROM ts_kpss_by('air17', id, ds, v, regression := 'ct');
----
true

# =============================================================================
# ts_stationarity / ts_stationarity_by (DIAG-03): four-way verdict combining
# ADF + KPSS, plus 'constant' and NULL (too-short) special cases.
# =============================================================================

query I
SELECT (ts_stationarity(LIST(v ORDER BY ds))).verdict FROM air17;
----
non_stationary

query I
SELECT (ts_stationarity(LIST(v ORDER BY ds), 'ct')).verdict FROM air17;
----
stationary

query I
SELECT (ts_stationarity(LIST(v ORDER BY ds), 'ct')).verdict FROM ts17;
----
trend_stationary

query I
SELECT stationarity.verdict FROM ts_stationarity_by('ts17', id, ds, v, regression := 'ct') AS stationarity;
----
trend_stationary

statement ok
CREATE TABLE const30 AS
SELECT 'k' AS id, DATE '2024-01-01' + INTERVAL (i) DAY AS ds, 5.0 AS v
FROM range(30) t(i);

query I
SELECT (ts_stationarity(LIST(v ORDER BY ds))).verdict FROM const30;
----
constant

query I
SELECT stationarity.verdict FROM ts_stationarity_by('const30', id, ds, v) AS stationarity;
----
constant

query I
SELECT (ts_stationarity([1.0, 2.0, 3.0]::DOUBLE[])).verdict IS NULL;
----
true

statement ok
DROP TABLE const30;

