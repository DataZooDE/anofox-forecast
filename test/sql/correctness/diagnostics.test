# name: test/sql/correctness/diagnostics.test
# description: Correctness-suite value pins for statistical diagnostics functions
#   fixed this milestone (DIAG-01..05, UPST-01/06) -- Phase 18, 18-02, TEST-03. Not
#   json-gated (D-02): runs on every native build. Reused, with citation, from
#   test/sql/ts_diagnostics_reference.test (Phase 17 17-01/17-02) and
#   test/sql/ts_diagnostics.test, with two closed-form additions (Durbin-Watson,
#   Jarque-Bera) that need no fixture.
# group: [sql]
#
# air17/ts17/arma17 literals are copied from
# validation/reference/fixtures/statsmodels_stationarity and r_diagnostics via the
# python3 one-liners documented in ts_diagnostics_reference.test's own header.

require anofox_forecast

