# name: test/sql/correctness/conformal_bootstrap.test
# description: Correctness-suite value pins for conformal prediction and bootstrap
#   interval functions fixed this milestone (CONF-01..05, RUST-04) -- Phase 18, 18-02,
#   TEST-03. Not json-gated (D-02): runs on every native build. Reused, with citation,
#   from test/sql/ts_conformal_reference.test (Phase 16 16-01..16-03); this file must
#   also stay free of any json-extension directive (the conformal macros read `params`
#   json-free via `params::MAP(VARCHAR, VARCHAR)`).
# group: [sql]

require anofox_forecast

# =============================================================================
# ts_conformal_by (CONF-01, split/symmetric): 2 groups x 20 calibration rows x
# 3 future rows. Cited verbatim from ts_conformal_reference.test 16-01.
# =============================================================================

statement ok
CREATE TABLE cbt(g VARCHAR, ds DATE, actual DOUBLE, forecast DOUBLE, point DOUBLE);

