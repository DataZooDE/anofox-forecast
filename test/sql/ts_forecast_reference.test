# RandomWalkDrift: closed-form point within 1e-8 absolute; both 95% bounds
# within 5e-3 of R rwf(trend, drift=TRUE)'s half-width at every step.
query I
SELECT max(abs(c - r)) <= 1e-8
FROM trend150, (
    SELECT
        unnest((_ts_forecast(v, 12, 'RandomWalkDrift')).point) AS c,
        unnest([
            70.0284809647611, 70.4904953518514, 70.9525097389417, 71.414524126032,
            71.8765385131223, 72.3385529002125, 72.8005672873028, 73.2625816743931,
            73.7245960614834, 74.1866104485736, 74.6486248356639, 75.1106392227542
        ]::DOUBLE[]) AS r
    FROM trend150
);
----
1

query I
SELECT max(abs(lo - r_lo) / ((r_up - r_lo) / 2.0)) <= 5e-3
   AND max(abs(up - r_up) / ((r_up - r_lo) / 2.0)) <= 5e-3
FROM trend150, (
    SELECT
        unnest((_ts_forecast(v, 12, 'RandomWalkDrift')).lower) AS lo,
        unnest((_ts_forecast(v, 12, 'RandomWalkDrift')).upper) AS up,
        unnest([
            67.8930233437945, 67.4604523006884, 67.2292121517388, 67.1011111683089,
            67.0382619444619, 67.0213063048537, 67.0387876189299, 67.0832693398442,
            67.1496056205053, 67.2340641481157, 67.3338382214775, 67.4467558238393
        ]::DOUBLE[]) AS r_lo,
        unnest([
            72.1639385857278, 73.5205384030145, 74.6758073261446, 75.727937083755,
            76.7148150817826, 77.6557994955714, 78.5623469556757, 79.441894008942,
            80.2995865024614, 81.1391567490315, 81.9634114498504, 82.7745226216691
        ]::DOUBLE[]) AS r_up
    FROM trend150
);
----
1

# SESOptimized: matches R ses(trend) within 1e-6 relative.
query I
SELECT max(abs(c - r) / abs(r)) <= 1e-6
FROM trend150, (
    SELECT
        unnest((_ts_forecast(v, 12, 'SESOptimized')).point) AS c,
        unnest([
            69.5665185214605, 69.5665185214605, 69.5665185214605, 69.5665185214605,
            69.5665185214605, 69.5665185214605, 69.5665185214605, 69.5665185214605,
            69.5665185214605, 69.5665185214605, 69.5665185214605, 69.5665185214605
        ]::DOUBLE[]) AS r
    FROM trend150
);
----
1

# Theta: matches R thetaf(trend) within 1e-6 relative.
query I
SELECT max(abs(c - r) / abs(r)) <= 1e-6
FROM trend150, (
    SELECT
        unnest((_ts_forecast(v, 12, 'Theta')).point) AS c,
        unnest([
            69.789338521525, 70.0121362337364, 70.2349339459479, 70.4577316581594,
            70.6805293703709, 70.9033270825824, 71.1261247947939, 71.3489225070053,
            71.5717202192168, 71.7945179314283, 72.0173156436398, 72.2401133558513
        ]::DOUBLE[]) AS r
    FROM trend150
);
----
1

# AutoARIMA (D-15): selects R auto.arima's order (0,1,0) with drift on this
# non-seasonal trending series -- model_name shows no constant, but the
# point forecast's drift is evidence R's selection matches (a drift-free
# (0,1,0) forecast would be flat). point_tol below is
# simulated_series.json tolerance.parity_checks trend/auto_arima/AutoARIMA
# point_tol = 1e-6 (rel).
query I
SELECT (_ts_forecast(v, 12, 'AutoARIMA')).model = 'AutoARIMA(0,1,0)'
FROM trend150;
----
1

# Sanity: AutoARIMA's lower <= point <= upper holds at every step (the
# interval is a known gap only on AirPassengers per D-16, not here).
query I
SELECT bool_and(lo <= pt AND pt <= up)
FROM trend150, (
    SELECT
        unnest((_ts_forecast(v, 12, 'AutoARIMA')).point) AS pt,
        unnest((_ts_forecast(v, 12, 'AutoARIMA')).lower) AS lo,
        unnest((_ts_forecast(v, 12, 'AutoARIMA')).upper) AS up
    FROM trend150
);
----
1

query I
SELECT max(abs(c - r) / abs(r)) <= 1e-6
FROM trend150, (
    SELECT
        unnest((_ts_forecast(v, 12, 'AutoARIMA')).point) AS c,
        unnest([
            70.0284809647612, 70.4904953518516, 70.952509738942, 71.4145241260324,
            71.8765385131228, 72.3385529002131, 72.8005672873035, 73.2625816743939,
            73.7245960614842, 74.1866104485746, 74.648624835665, 75.1106392227554
        ]::DOUBLE[]) AS r
    FROM trend150
);
----
1
