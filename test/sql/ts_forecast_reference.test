# name: test/sql/ts_forecast_reference.test
# description: Phase 17 plan 17-03 (FCST-09) R `forecast` parity SQL assertions
# group: [sql]
#
# Non-json-gated so it runs on every native build (Phase 13 lesson, D-12) --
# every function used here (_ts_forecast / ts_forecast_by) is json-free. This
# file stays free of any json-extension require directive.
#
# Literals below are copied from fixture JSON via a one-line python3 snippet,
# e.g. for validation/reference/fixtures/r_forecast/simulated_series.json:
#   python3 -c "import json; d=json.load(open('validation/reference/fixtures/r_forecast/simulated_series.json')); print(d['series']['trend']['inputs']['values'])"

require anofox_forecast

#######################################
# 17-03 Task 2: trend series (R forecast parity, D-08/D-12/D-15)
#######################################

statement ok
