# name: test/sql/ts_fill_forward_operator.test
# description: Tests for ts_fill_forward_operator (DEPRECATED macro over ts_fill_forward_by, #289) and ts_fill_forward_by
# group: [anofox_forecast]

require anofox_forecast

# ts_fill_forward_by outputs the group/date/value columns under their ORIGINAL names
# (id/ds/value here), not generic group_col/date_col/value_col aliases, since commit
# ca7d4f6 "refactor: ts_fill_gaps_by and ts_fill_forward_by now use native streaming
# (#113)" (Phase 18, 18-01, class A). Every group_col/date_col/value_col reference
# below (output-side only; the function call's input args already correctly used
# id/ds/value) was updated accordingly.

#######################################
# ts_fill_forward_operator (DEPRECATED, #289) - Registration
#######################################

# Both the macro and its anofox_fcst_ alias register as table macros (not the old
# native table function, which hung natively and trapped DuckDB-Wasm -- see #289).
query I
SELECT function_name || ':' || function_type FROM duckdb_functions()
WHERE function_name IN ('ts_fill_forward_operator', 'anofox_fcst_ts_fill_forward_operator')
ORDER BY 1;
----
anofox_fcst_ts_fill_forward_operator:table_macro
ts_fill_forward_operator:table_macro

#######################################
# ts_fill_forward_operator - #289 reproducer (nested-query hang/trap, fixed)
#######################################

statement ok
CREATE TABLE raw_sales AS
SELECT (DATE '2024-01-01' + i::INT) AS sale_date, i::DOUBLE AS quantity, 'S' || (i % 2) AS store_id
FROM range(6) t(i);

# Before the fix this call hung natively (nested QueryMaterialized in InitGlobal)
# and trapped DuckDB-Wasm. It now completes immediately and returns 15 rows.
query I
SELECT count(*) FROM ts_fill_forward_operator('raw_sales', 'store_id', 'sale_date', 'quantity', TIMESTAMP '2024-01-10', '1d');
----
15

# Store S1: 3 observed rows (01-02, 01-04, 01-06) + 4 forward-filled NULL rows
# (01-07..01-10) at the requested '1d' frequency.
query TTR
SELECT store_id, sale_date, quantity
FROM ts_fill_forward_operator('raw_sales', 'store_id', 'sale_date', 'quantity', TIMESTAMP '2024-01-10', '1d')
WHERE store_id = 'S1'
ORDER BY sale_date;
----
S1	2024-01-02	1.0
S1	2024-01-04	3.0
S1	2024-01-06	5.0
S1	2024-01-07	NULL
S1	2024-01-08	NULL
S1	2024-01-09	NULL
S1	2024-01-10	NULL

#######################################
# ts_fill_forward_operator - quoted/reserved identifiers + non-default frequency
#######################################

# "order" is a reserved word and "my date" contains a space; the old C++ operator
# interpolated identifiers unquoted via StringUtil::Format. The macro resolves
# column names through COLUMNS([param]) (AST substitution), never re-parsed SQL
# text, so both identifiers work with no quoting from the caller.
statement ok
CREATE TABLE weird("order" VARCHAR, "my date" DATE, val DOUBLE);

statement ok
INSERT INTO weird VALUES ('a', DATE '2024-01-01', 1.0), ('a', DATE '2024-01-02', 2.0);

query TTR
SELECT * FROM ts_fill_forward_operator('weird', 'order', 'my date', 'val', TIMESTAMP '2024-01-08', '2d')
ORDER BY 2;
----
a	2024-01-01	1.0
a	2024-01-02	2.0
a	2024-01-04	NULL
a	2024-01-06	NULL
a	2024-01-08	NULL

#######################################
# ts_fill_forward_operator - frequency is honoured (the old operator ignored it
# and always filled at one day)
#######################################

query I
SELECT count(*) FROM ts_fill_forward_operator('raw_sales', 'store_id', 'sale_date', 'quantity', TIMESTAMP '2024-01-20', '2d');
----
20

query I
SELECT count(*) FROM ts_fill_forward_operator('raw_sales', 'store_id', 'sale_date', 'quantity', TIMESTAMP '2024-01-20', '1d');
----
35

#######################################
# ts_fill_forward_operator - equivalence with ts_fill_forward_by (both directions)
#######################################

query I
SELECT count(*) FROM (
    SELECT * FROM ts_fill_forward_operator('raw_sales', 'store_id', 'sale_date', 'quantity', TIMESTAMP '2024-01-10', '1d')
    EXCEPT ALL
    SELECT * FROM ts_fill_forward_by('raw_sales', store_id, sale_date, quantity, TIMESTAMP '2024-01-10', '1d')
);
----
0

query I
SELECT count(*) FROM (
    SELECT * FROM ts_fill_forward_by('raw_sales', store_id, sale_date, quantity, TIMESTAMP '2024-01-10', '1d')
    EXCEPT ALL
    SELECT * FROM ts_fill_forward_operator('raw_sales', 'store_id', 'sale_date', 'quantity', TIMESTAMP '2024-01-10', '1d')
);
----
0

#######################################
# ts_fill_forward_operator - error cases
#######################################

statement error
SELECT * FROM ts_fill_forward_operator('nonexistent_table', 'store_id', 'sale_date', 'quantity', TIMESTAMP '2024-01-10', '1d');
----
does not exist

statement error
SELECT * FROM ts_fill_forward_operator('raw_sales', 'no_such_col', 'sale_date', 'quantity', TIMESTAMP '2024-01-10', '1d');
----
was not found

statement ok
DROP TABLE raw_sales;

statement ok
DROP TABLE weird;

#######################################
# Setup - Create test data
#######################################

# Create a simple grouped time series
statement ok
CREATE TABLE test_series AS
SELECT 'A' AS id,
       ('2024-01-01'::DATE + (i || ' days')::INTERVAL)::TIMESTAMP AS ds,
       (10.0 + i)::DOUBLE AS value
FROM generate_series(0, 4) AS t(i)
UNION ALL
SELECT 'B' AS id,
       ('2024-01-01'::DATE + (i || ' days')::INTERVAL)::TIMESTAMP AS ds,
       (100.0 + i * 5)::DOUBLE AS value
FROM generate_series(0, 4) AS t(i);

#######################################
# ts_fill_forward - Basic Function Tests
#######################################

# Test function returns results
query I
SELECT COUNT(*) > 0 FROM ts_fill_forward_by('test_series', id, ds, value, '2024-01-10', '1d');
----
true

# Test original data is preserved
query I
SELECT COUNT(*) FROM ts_fill_forward_by('test_series', id, ds, value, '2024-01-10', '1d')
WHERE value IS NOT NULL;
----
10

# Test forward fill adds rows with NULL values
query I
SELECT COUNT(*) FROM ts_fill_forward_by('test_series', id, ds, value, '2024-01-10', '1d')
WHERE value IS NULL;
----
10

# Total rows should be original + filled
query I
SELECT COUNT(*) FROM ts_fill_forward_by('test_series', id, ds, value, '2024-01-10', '1d');
----
20

#######################################
# Group Handling Tests
#######################################

# Both groups should have filled rows
query I
SELECT COUNT(DISTINCT id) FROM ts_fill_forward_by('test_series', id, ds, value, '2024-01-10', '1d');
----
2

# Group A should have correct count (5 original + 5 filled)
query I
SELECT COUNT(*) FROM ts_fill_forward_by('test_series', id, ds, value, '2024-01-10', '1d')
WHERE id = 'A';
----
10

# Group B should have correct count (5 original + 5 filled)
query I
SELECT COUNT(*) FROM ts_fill_forward_by('test_series', id, ds, value, '2024-01-10', '1d')
WHERE id = 'B';
----
10

#######################################
# Date Range Tests
#######################################

# Filled dates should be after original last date (2024-01-05)
query I
SELECT COUNT(*) FROM ts_fill_forward_by('test_series', id, ds, value, '2024-01-10', '1d')
WHERE ds > '2024-01-05'::TIMESTAMP AND value IS NULL;
----
10

# All filled dates should be <= target date
query I
SELECT COUNT(*) FROM ts_fill_forward_by('test_series', id, ds, value, '2024-01-10', '1d')
WHERE ds > '2024-01-10'::TIMESTAMP;
----
0

#######################################
# Value Handling Tests
#######################################

# Original values should be preserved exactly
# A: 10+11+12+13+14 = 60, B: 100+105+110+115+120 = 550, Total = 610
query R
SELECT SUM(value) FROM ts_fill_forward_by('test_series', id, ds, value, '2024-01-10', '1d')
WHERE value IS NOT NULL;
----
610.0

# Filled values should be NULL
query I
SELECT COUNT(*) FROM ts_fill_forward_by('test_series', id, ds, value, '2024-01-10', '1d')
WHERE ds > '2024-01-05'::TIMESTAMP AND value IS NOT NULL;
----
0

#######################################
# Target Date At/Before Last Date
#######################################

# If target date equals last date, should return original data only
query I
SELECT COUNT(*) FROM ts_fill_forward_by('test_series', id, ds, value, '2024-01-05', '1d');
----
10

#######################################
# Frequency Parameter Tests
#######################################

# Polars-style '1d' frequency
query I
SELECT COUNT(*) FROM ts_fill_forward_by('test_series', id, ds, value, '2024-01-08', '1d');
----
16

# DuckDB INTERVAL style '1 day'
query I
SELECT COUNT(*) FROM ts_fill_forward_by('test_series', id, ds, value, '2024-01-08', '1 day');
----
16

# Hourly frequency (more granular) moved to test/sql/ts_fill_forward_native.test:
# TIMESTAMP + hourly frequency crashes DuckDB-Wasm ("Maximum call stack size
# exceeded", corrupts later results -- see 19-RESEARCH.md Pitfall 1 and
# .planning/phases/19-wasm-traps-distribution-pipeline/deferred-items.md). This
# file is in the CI-gated curated WASM subset, so it must avoid that frequency.

#######################################
# Ordering Tests
#######################################

# Results should be ordered by group, then date
query TT
SELECT id, ds FROM ts_fill_forward_by('test_series', id, ds, value, '2024-01-07', '1d')
ORDER BY id, ds
LIMIT 3;
----
A	2024-01-01 00:00:00
A	2024-01-02 00:00:00
A	2024-01-03 00:00:00

#######################################
# Single Group Test
#######################################

statement ok
CREATE TABLE single_group AS
SELECT 'X' AS id,
       ('2024-01-01'::DATE + (i || ' days')::INTERVAL)::TIMESTAMP AS ds,
       (i * 10.0)::DOUBLE AS value
FROM generate_series(0, 2) AS t(i);

# Single group should work correctly
query I
SELECT COUNT(*) FROM ts_fill_forward_by('single_group', id, ds, value, '2024-01-05', '1d');
----
5

# Verify values for single group
query IR
SELECT ds, value FROM ts_fill_forward_by('single_group', id, ds, value, '2024-01-05', '1d')
ORDER BY ds;
----
2024-01-01 00:00:00	0.0
2024-01-02 00:00:00	10.0
2024-01-03 00:00:00	20.0
2024-01-04 00:00:00	NULL
2024-01-05 00:00:00	NULL

#######################################
# Cleanup
#######################################

statement ok
DROP TABLE test_series;

statement ok
DROP TABLE single_group;
