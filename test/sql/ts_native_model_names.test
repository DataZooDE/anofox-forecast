#######################################
# _ts_forecast_native: Auto Models (name starts with prefix)
#######################################

query I
SELECT DISTINCT model_name LIKE 'AutoETS%' FROM _ts_forecast_native(
    (SELECT id, ds, y FROM model_name_data), 3, '1d', 'AutoETS', MAP{});
----
true

query I
SELECT DISTINCT model_name LIKE 'AutoARIMA%' FROM _ts_forecast_native(
    (SELECT id, ds, y FROM model_name_data), 3, '1d', 'AutoARIMA', MAP{});
----
true

query I
SELECT DISTINCT model_name LIKE 'AutoTheta%' FROM _ts_forecast_native(
    (SELECT id, ds, y FROM model_name_data), 3, '1d', 'AutoTheta', MAP{});
----
true

# D-06: AutoMFLES/AutoMSTL are accepted as deprecated aliases but model_name
# reports the non-Auto family name (MFLES/MSTL), never the Auto-prefixed
# alias. AutoMSTL additionally requires a usable period (D-07), same
# period-14 fix as the other seasonal models above.
query I
SELECT DISTINCT model_name FROM _ts_forecast_native(
    (SELECT id, ds, y FROM model_name_data), 3, '1d', 'AutoMFLES', MAP{});
----
MFLES

query I
SELECT DISTINCT model_name FROM _ts_forecast_native(
    (SELECT id, ds, y FROM model_name_data), 3, '1d', 'AutoMSTL', MAP{'seasonal_period': '14'});
----
MSTL

# AutoTBATS keeps its Auto-prefixed naming (reports the selected spec); it
# still requires a usable period (D-07).
query I
SELECT DISTINCT model_name LIKE 'AutoTBATS%' FROM _ts_forecast_native(
    (SELECT id, ds, y FROM model_name_data), 3, '1d', 'AutoTBATS', MAP{'seasonal_period': '14'});
----
true

#######################################
# _ts_cv_forecast_native: representative models
# Covers each helper-sharing group plus Auto
#######################################

query I
SELECT DISTINCT model_name FROM _ts_cv_forecast_native(
    (SELECT fold_id, split, id, ds, y FROM model_name_cv), 'Naive', MAP{})
WHERE split = 'test';
----
Naive

query I
SELECT DISTINCT model_name FROM _ts_cv_forecast_native(
    (SELECT fold_id, split, id, ds, y FROM model_name_cv), 'SESOptimized', MAP{})
WHERE split = 'test';
----
SESOptimized

query I
SELECT DISTINCT model_name FROM _ts_cv_forecast_native(
    (SELECT fold_id, split, id, ds, y FROM model_name_cv), 'RandomWalkDrift', MAP{})
WHERE split = 'test';
----
RandomWalkDrift

# D-07: same explicit-period fix as the non-CV HoltWinters/SeasonalESOptimized
# assertions above.
query I
SELECT DISTINCT model_name FROM _ts_cv_forecast_native(
    (SELECT fold_id, split, id, ds, y FROM model_name_cv), 'HoltWinters', MAP{'seasonal_period': '14'})
WHERE split = 'test';
----
HoltWinters

query I
SELECT DISTINCT model_name FROM _ts_cv_forecast_native(
    (SELECT fold_id, split, id, ds, y FROM model_name_cv), 'SeasonalESOptimized', MAP{'seasonal_period': '14'})
WHERE split = 'test';
----
SeasonalESOptimized

query I
SELECT DISTINCT model_name FROM _ts_cv_forecast_native(
    (SELECT fold_id, split, id, ds, y FROM model_name_cv), 'OptimizedTheta', MAP{})
WHERE split = 'test';
----
OptimizedTheta

query I
SELECT DISTINCT model_name FROM _ts_cv_forecast_native(
    (SELECT fold_id, split, id, ds, y FROM model_name_cv), 'DynamicOptimizedTheta', MAP{})
WHERE split = 'test';
----
DynamicOptimizedTheta

# D-05: 'ETS' without ets_model runs the crate's AutoETS selection and
# reports the chosen spec (e.g. ETS(A,A,N)), never the literal 'ETS'.
query I
SELECT DISTINCT regexp_matches(model_name, '^ETS\([AM],(N|A|Ad),(N|A|M)\)$') FROM _ts_cv_forecast_native(
    (SELECT fold_id, split, id, ds, y FROM model_name_cv), 'ETS', MAP{})
WHERE split = 'test';
----
true

# D-09: 'ARIMA' now requires an explicit arima_order; with one, model_name
# reports the order (and " with drift" when the crate adds a drift term —
# filtered to a single series here for a deterministic single-row result,
# since G1/G2 can select drift differently at the same order).
query I
SELECT DISTINCT model_name FROM _ts_cv_forecast_native(
    (SELECT fold_id, split, id, ds, y FROM model_name_cv), 'ARIMA', MAP{'arima_order': '[1,1,1]'})
WHERE split = 'test' AND id = 'G1';
----
ARIMA(1,1,1)

query I
SELECT DISTINCT model_name FROM _ts_cv_forecast_native(
    (SELECT fold_id, split, id, ds, y FROM model_name_cv), 'MFLES', MAP{})
WHERE split = 'test';
----
MFLES

# D-07: MSTL/TBATS require a usable period via CV too.
query I
SELECT DISTINCT model_name FROM _ts_cv_forecast_native(
    (SELECT fold_id, split, id, ds, y FROM model_name_cv), 'MSTL', MAP{'seasonal_period': '14'})
WHERE split = 'test';
----
MSTL

query I
SELECT DISTINCT model_name FROM _ts_cv_forecast_native(
    (SELECT fold_id, split, id, ds, y FROM model_name_cv), 'TBATS', MAP{'seasonal_period': '14'})
WHERE split = 'test';
----
TBATS

