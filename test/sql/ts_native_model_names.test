    (SELECT id, ds, y FROM model_name_data), 3, '1d', 'AIDA', MAP{});
----
Unknown model: 'AIDA'

statement error
SELECT * FROM _ts_cv_forecast_native(
    (SELECT fold_id, split, id, ds, y FROM model_name_cv), 'AIDA', MAP{});
----
Unknown model: 'AIDA'

statement error
