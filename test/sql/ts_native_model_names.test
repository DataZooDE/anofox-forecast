#######################################
# _ts_forecast_native: State Space / ARIMA
#######################################

# D-05: 'ETS' without ets_model runs the crate's AutoETS selection and
# reports the chosen spec; G1/G2 can select different specs, so this is a
# per-row regex-match count rather than a single-row DISTINCT value.
query I
SELECT count(*) FROM _ts_forecast_native(
    (SELECT id, ds, y FROM model_name_data), 3, '1d', 'ETS', MAP{})
WHERE NOT regexp_matches(model_name, '^ETS\([AM],(N|A|Ad),(N|A|M)\)$');
----
0

# D-09: 'ARIMA' now requires an explicit arima_order; with one, model_name
# reports the order (and " with drift" when the crate adds a drift term —
# G1/G2 can select drift differently at the same order, so this is a
# per-row regex-match count rather than a single-row DISTINCT value).
query I
SELECT count(*) FROM _ts_forecast_native(
    (SELECT id, ds, y FROM model_name_data), 3, '1d', 'ARIMA', MAP{'arima_order': '[1,1,1]'})
WHERE NOT regexp_matches(model_name, '^ARIMA\(1,1,1\)( with drift)?$');
----
0

