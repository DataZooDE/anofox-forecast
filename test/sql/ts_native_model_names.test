# D-07: SeasonalWindowAverage requires a usable period too.
query I
SELECT DISTINCT model_name FROM _ts_forecast_native(
    (SELECT id, ds, y FROM model_name_data), 3, '1d', 'SeasonalWindowAverage', MAP{'seasonal_period': '14'});
----
